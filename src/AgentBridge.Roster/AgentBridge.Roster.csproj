<Project Sdk="Microsoft.NET.Sdk">

  <!-- The signed device roster (#55, docs/design/device-approval.md, docs/protocol/devices.md):
       entries, their encoding and checks, and the acceptance rule. A library only: nothing here
       is wired into a host, the relay or a client (slices R2 to R5), and it depends on nothing
       but the base class library, so every verifier computes from the same code. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentBridge.Roster</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentBridge.Roster.Tests" />
  </ItemGroup>

</Project>
