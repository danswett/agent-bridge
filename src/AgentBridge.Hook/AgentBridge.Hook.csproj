<Project Sdk="Microsoft.NET.Sdk">

  <!-- agent-bridge-host-hook: the hook each agent runs on a migrated machine (docs/host-hooks.md).
       The agents wait for every hook, so it is NativeAOT and starts in milliseconds, and a
       console Exe, since the agent reads its reply from stdout. The host places it beside
       itself; migration copies it to a folder of its own. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentBridge.Hook</RootNamespace>
    <AssemblyName>agent-bridge-host-hook</AssemblyName>
    <!-- What Task Manager and the file's properties call it (docs/design/brand.md §3.1, #537). The
         file's name is an identifier that installers, tasks and the updater find it by, and stays (#539). -->
    <Product>Slipgates</Product>
    <AssemblyTitle>Slipgates agent hook</AssemblyTitle>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentBridge.Hooks\AgentBridge.Hooks.csproj" />
  </ItemGroup>

</Project>
