<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentBridge.HomeAssistant</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentBridge.HomeAssistant.Tests" />
    <EmbeddedResource Include="Publication\session-templates.json;Publication\agent-bridge-reply-card.js" />
    <EmbeddedResource Include="HaPublicationRenderer.cs;HaPublicationWriter.cs;HaPublicationSelector.cs;HaPublicationFleet.cs;HaConnector.Publication.cs;HaPublicationPolicy.cs;HaContract.cs">
      <LogicalName>AgentBridge.HomeAssistant.Publication.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- DPAPI for the Home Assistant token on Windows, as for the device key. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentBridge.Host.Core\AgentBridge.Host.Core.csproj" />
    <!-- Reuse the audited owner-only atomic staging boundary for publication receipts. -->
    <ProjectReference Include="..\AgentBridge.Host.Delivery\AgentBridge.Host.Delivery.csproj" />
  </ItemGroup>

</Project>
