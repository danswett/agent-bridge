<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentBridge.Host</RootNamespace>
    <AssemblyName>agent-bridge-host</AssemblyName>
    <!-- Reported to clients as hello's machine.hostVersion. -->
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentBridge.Host.Tests" />
  </ItemGroup>

  <!-- A released host says so; any other build reports itself as dev (hello's machine.dev). -->
  <ItemGroup Condition="'$(AgentBridgeRelease)' == 'true'">
    <AssemblyMetadata Include="AgentBridgeRelease" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentBridge.Host.Core\AgentBridge.Host.Core.csproj" />
    <ProjectReference Include="..\AgentBridge.Transport\AgentBridge.Transport.csproj" />
    <ProjectReference Include="..\AgentBridge.Host.Delivery\AgentBridge.Host.Delivery.csproj" />
  </ItemGroup>

</Project>
