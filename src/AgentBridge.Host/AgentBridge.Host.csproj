<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentBridge.Host</RootNamespace>
    <AssemblyName>agent-bridge-host</AssemblyName>
    <!-- What Task Manager and the file's properties call it (docs/design/brand.md §3.1, #537). The
         file's name is an identifier that installers, tasks and the updater find it by, and stays (#539). -->
    <Product>Slipgates</Product>
    <AssemblyTitle>Slipgates host</AssemblyTitle>
    <!-- Reported to clients as hello's machine.hostVersion. -->
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentBridge.Host.Tests" />
  </ItemGroup>

  <!-- A released host says so; any other build reports itself as dev (hello's machine.dev). -->
  <ItemGroup Condition="'$(AgentBridgeRelease)' == 'true'">
    <AssemblyMetadata Include="AgentBridgeRelease" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentBridge.Host.Core\AgentBridge.Host.Core.csproj" />
    <ProjectReference Include="..\AgentBridge.Transport\AgentBridge.Transport.csproj" />
    <ProjectReference Include="..\AgentBridge.AgentEnvelope\AgentBridge.AgentEnvelope.csproj" />
    <ProjectReference Include="..\AgentBridge.Host.Delivery\AgentBridge.Host.Delivery.csproj" />
    <ProjectReference Include="..\AgentBridge.Local\AgentBridge.Local.csproj" />
    <ProjectReference Include="..\AgentBridge.AgentEnvelope\AgentBridge.AgentEnvelope.csproj" />
    <ProjectReference Include="..\AgentBridge.HomeAssistant\AgentBridge.HomeAssistant.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
