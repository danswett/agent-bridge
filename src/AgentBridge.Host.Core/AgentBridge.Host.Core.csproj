<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentBridge.Host.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentBridge.Host.Core.Tests" />
    <!-- Feed regressions enqueue exact session changes independently of transcript parsing. -->
    <InternalsVisibleTo Include="AgentBridge.Host.Tests" />
    <InternalsVisibleTo Include="AgentBridge.Host.Delivery.Tests" />
    <!-- The HA connector's contract tests build questions the way the host parses them. -->
    <InternalsVisibleTo Include="AgentBridge.HomeAssistant.Tests" />
    <!-- The stuck-session notice recognises the host-wedge error by AgentErrors.HostWedgeMessage (#687). -->
    <InternalsVisibleTo Include="AgentBridge.HomeAssistant" />
    <!-- The migration finds agent-ha-bridge's processes by command line, as the scanner does. -->
    <InternalsVisibleTo Include="agent-bridge-host" />
    <!-- bench-micro times transcript tailing and upsert building, which are internal
         (quality/perf.md). Benchmarks only: nothing shipped references it. -->
    <InternalsVisibleTo Include="AgentBridge.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentBridge.Protocol\AgentBridge.Protocol.csproj" />
    <ProjectReference Include="..\AgentBridge.Hooks\AgentBridge.Hooks.csproj" />
  </ItemGroup>

</Project>
