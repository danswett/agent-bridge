<Project Sdk="Microsoft.NET.Sdk">

  <!-- agent-bridge-injector: the one process that attaches to an agent's console and types
       into it, started by the host for each answer. A WinExe, so it starts with no console
       of its own, and NativeAOT when published, so it starts in milliseconds. The host
       places it beside itself (publish it into the host's folder). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentBridge.Injector</RootNamespace>
    <AssemblyName>agent-bridge-injector</AssemblyName>
    <!-- What Task Manager and the file's properties call it (docs/design/brand.md §3.1, #537). The
         file's name is an identifier that installers, tasks and the updater find it by, and stays (#539). -->
    <Product>Slipgates</Product>
    <AssemblyTitle>Slipgates typing helper</AssemblyTitle>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
