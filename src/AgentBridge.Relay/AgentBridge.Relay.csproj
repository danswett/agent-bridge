<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentBridge.Relay</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentBridge.Transport\AgentBridge.Transport.csproj" />
    <Using Include="AgentBridge.Transport" />
  </ItemGroup>

  <ItemGroup>
    <!-- The blob store (Blobs.cs): user delegation SAS signed with the app's managed identity,
         so no storage account key exists anywhere in the relay's configuration. -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
  </ItemGroup>

</Project>
