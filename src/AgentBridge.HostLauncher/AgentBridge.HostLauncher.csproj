<Project Sdk="Microsoft.NET.Sdk">

  <!-- agent-bridge-hostw: the logon task's way to start the host without a console window.
       Published into the app's folder beside agent-bridge-host. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentBridge.HostLauncher</RootNamespace>
    <AssemblyName>agent-bridge-hostw</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DefineConstants>$(DefineConstants);AGENT_BRIDGE_HOSTW</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- The exit code and variable it shares with the host, as source, so the launcher stays one
         small assembly. -->
    <Compile Include="..\AgentBridge.Local\HostLauncherContract.cs" Link="HostLauncherContract.cs" />
    <!-- And the host's rule for where a profile's folder is, so both look in the same one. -->
    <Compile Include="..\AgentBridge.Transport\ProfileFolders.cs" Link="ProfileFolders.cs" />
    <!-- And the product's name, for what its log tells the person to do. -->
    <Compile Include="..\AgentBridge.Protocol\Product.cs" Link="Product.cs" />
    <!-- And the generated brand constants (design/tokens.json) that Product reads from once #537 adopts them. -->
    <Compile Include="..\AgentBridge.Protocol\DesignBrand.cs" Link="DesignBrand.cs" />
  </ItemGroup>

</Project>
