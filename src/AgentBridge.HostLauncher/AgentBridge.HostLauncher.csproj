<Project Sdk="Microsoft.NET.Sdk">

  <!-- agent-bridge-hostw: the logon task's way to start the host without a console window.
       Published into the app's folder beside agent-bridge-host. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentBridge.HostLauncher</RootNamespace>
    <AssemblyName>agent-bridge-hostw</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
