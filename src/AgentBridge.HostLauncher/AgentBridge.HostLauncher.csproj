<Project Sdk="Microsoft.NET.Sdk">

  <!-- agent-bridge-hostw: the logon task's way to start the host without a console window.
       Published into the app's folder beside agent-bridge-host. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentBridge.HostLauncher</RootNamespace>
    <AssemblyName>agent-bridge-hostw</AssemblyName>
    <!-- What Task Manager and the file's properties call it (docs/design/brand.md §3.1, #537). The
         file's name is an identifier that installers, tasks and the updater find it by, and stays (#539). -->
    <Product>Slipgates</Product>
    <AssemblyTitle>Slipgates host launcher [coordinator-v1]</AssemblyTitle>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DefineConstants>$(DefineConstants);AGENT_BRIDGE_HOSTW</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\build\updater-images.json" LogicalName="updater-images.json" />
    <InternalsVisibleTo Include="AgentBridge.App.Tests" />
    <!-- Published as one self-contained bundle; share the coordinator and contracts, not copies. -->
    <ProjectReference Include="..\AgentBridge.App.Core\AgentBridge.App.Core.csproj" />
  </ItemGroup>

</Project>
