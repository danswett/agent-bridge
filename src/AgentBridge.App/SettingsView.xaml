<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AgentBridge.App.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentBridge.App">
    <ScrollViewer AutomationProperties.AutomationId="SettingsPane">
        <!-- In a Grid: a ScrollViewer centres a narrower child by its desired width, which pushed
             the column off the right edge (see LaunchView). -->
        <Grid>
            <StackPanel MaxWidth="920" Padding="16,12,16,24" Spacing="8">
                <InfoBar Severity="Error" Title="That didn't work" IsClosable="False" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind local:Ui.Show(ViewModel.Busy), Mode=OneWay}" />
    
                <!-- The host: the background program that watches this machine's agent sessions. -->
                <TextBlock Style="{StaticResource AbSectionTitle}" Text="Bridge Host on this machine" />
                <InfoBar
                    Severity="Warning"
                    Title="agent-ha-bridge is running here"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasAgentHaBridge, Mode=OneWay}"
                    Message="{x:Bind local:SettingsView.HaNote(ViewModel.AgentHaBridge), Mode=OneWay}" />
                <InfoBar
                    Severity="Warning"
                    Title="The host is elevated"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.ElevatedWarning, Mode=OneWay}"
                    Message="It runs as administrator, so it cannot type into ordinary agent windows. Start it from this app instead." />
                <InfoBar
                    Severity="Informational"
                    Title="Restart the host"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.RestartRequired, Mode=OneWay}"
                    Message="A setting changed that the host reads when it starts.">
                    <InfoBar.ActionButton>
                        <Button Content="Restart now" Click="OnRestart" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="HostState" Text="{x:Bind ViewModel.HostState, Mode=OneWay}" />
                <TextBlock Style="{StaticResource AbSecondaryText}" Text="{x:Bind local:SettingsView.HostLine(ViewModel.HostVersion, ViewModel.Profile), Mode=OneWay}" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource AbWarningText}"
                    Text="The host is a different version from the app. Restart it to run the one installed with the app."
                    Visibility="{x:Bind local:Ui.Show(ViewModel.VersionSkew), Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Start" AutomationProperties.AutomationId="StartHost" Click="OnStart" IsEnabled="{x:Bind local:Ui.Not(ViewModel.Busy), Mode=OneWay}" />
                    <Button Content="Stop" AutomationProperties.AutomationId="StopHost" Click="OnStop" IsEnabled="{x:Bind local:Ui.Not(ViewModel.Busy), Mode=OneWay}" />
                    <Button Content="Restart" AutomationProperties.AutomationId="RestartHost" Click="OnRestart" IsEnabled="{x:Bind local:Ui.Not(ViewModel.Busy), Mode=OneWay}" />
                </StackPanel>
                <ToggleSwitch
                    Header="Start the host when I sign in to Windows"
                    AutomationProperties.AutomationId="HostAtSignIn"
                    IsOn="{x:Bind ViewModel.StartAtSignIn, Mode=TwoWay}" />
    
                <!-- The relay: how this machine reaches the person's other devices. -->
                <TextBlock Style="{StaticResource AbSectionTitle}" Text="Your devices" />
                <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="Account" Text="{x:Bind ViewModel.AccountText, Mode=OneWay}" />
                <TextBlock Style="{StaticResource AbSecondaryText}" Text="{x:Bind ViewModel.RelayText, Mode=OneWay}" />
                <TextBox Header="Relay" AutomationProperties.AutomationId="RelayUrl" Text="{x:Bind ViewModel.RelayUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Content="Sign in with GitHub"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.AutomationId="SignIn"
                        IsEnabled="{x:Bind ViewModel.CanSignIn, Mode=OneWay}"
                        Click="OnSignIn" />
                </StackPanel>
                <Border
                    Background="{ThemeResource AbCodeBg}"
                    CornerRadius="10"
                    Padding="16"
                    Visibility="{x:Bind local:Ui.Show(ViewModel.SignInPending), Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock TextWrapping="Wrap" Text="Open the page below, sign in to GitHub and enter this code:" />
                        <TextBlock
                            FontSize="28"
                            FontFamily="Cascadia Mono, Consolas"
                            IsTextSelectionEnabled="True"
                            AutomationProperties.AutomationId="SignInCode"
                            Text="{x:Bind ViewModel.SignInCode, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Copy code and open the page" Style="{StaticResource AccentButtonStyle}" Click="OnOpenSignIn" />
                            <Button Content="Cancel" Click="OnCancelSignIn" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource AbSecondaryText}" Text="{x:Bind ViewModel.SignInUri, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource AbDanger}"
                    Text="{x:Bind ViewModel.SignInError, Mode=OneWay}"
                    Visibility="{x:Bind local:Ui.Some(ViewModel.SignInError), Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox
                        Width="360"
                        Header="This machine's name on your devices"
                        AutomationProperties.AutomationId="MachineName"
                        Text="{x:Bind ViewModel.MachineName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button VerticalAlignment="Bottom" Content="Save name" Click="OnSaveName" IsEnabled="{x:Bind ViewModel.HostRunning, Mode=OneWay}" />
                </StackPanel>
                <ToggleSwitch
                    Header="Let this app and my devices approve Copilot permission prompts"
                    AutomationProperties.AutomationId="RemoteApproval"
                    IsEnabled="{x:Bind ViewModel.HostRunning, Mode=OneWay}"
                    IsOn="{x:Bind ViewModel.RemoteApproval, Mode=TwoWay}" />
                <TextBlock
                    Style="{StaticResource AbSecondaryText}"
                    Text="Off: Copilot's Approve once and Deny are answered only in the agent's own window. Questions are still answered anywhere. A change applies when the host restarts." />
    
                <!-- The app itself. -->
                <TextBlock Style="{StaticResource AbSectionTitle}" Text="This app" />
                <ToggleSwitch Header="Show reasoning and tool history on cards" AutomationProperties.AutomationId="ShowDetail" IsOn="{x:Bind ViewModel.ShowDetail, Mode=TwoWay}" />
                <ToggleSwitch Header="Notify me when a session asks something" AutomationProperties.AutomationId="Toasts" IsOn="{x:Bind ViewModel.Toasts, Mode=TwoWay}" />
                <ToggleSwitch Header="Notify me when a session finishes a turn" AutomationProperties.AutomationId="FinishedToasts" IsEnabled="{x:Bind ViewModel.Toasts, Mode=OneWay}" IsOn="{x:Bind ViewModel.FinishedToasts, Mode=TwoWay}" />
                <ToggleSwitch Header="Start the app in the notification area when I sign in" AutomationProperties.AutomationId="AppAtSignIn" IsOn="{x:Bind ViewModel.AppStartsAtSignIn, Mode=TwoWay}" />
                <TextBlock Text="{x:Bind local:SettingsView.AppLine(ViewModel.AppVersion, ViewModel.InstalledText), Mode=OneWay}" Style="{StaticResource AbSecondaryText}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Check for updates" AutomationProperties.AutomationId="CheckUpdates" Click="OnCheckUpdates" IsEnabled="{x:Bind local:Ui.Not(ViewModel.Busy), Mode=OneWay}" />
                    <Button
                        Content="Update and restart"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.AutomationId="InstallUpdate"
                        Visibility="{x:Bind local:Ui.Show(ViewModel.UpdateAvailable), Mode=OneWay}"
                        Click="OnInstallUpdate" />
                    <TextBlock VerticalAlignment="Center" AutomationProperties.AutomationId="UpdateStatus" Text="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}" />
                </StackPanel>
    
                <!-- The host's log, read from its file, so it is there when the host is not. -->
                <Grid Margin="0,12,0,4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Host log" />
                    <Button HorizontalAlignment="Right" Content="Refresh" Click="OnRefreshLog" />
                </Grid>
                <TextBox
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    MaxHeight="360"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="12"
                    AutomationProperties.AutomationId="HostLog"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{x:Bind ViewModel.Log, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
