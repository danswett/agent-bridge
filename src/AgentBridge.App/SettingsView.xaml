<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AgentBridge.App.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentBridge.App"
    xmlns:core="using:AgentBridge.App.Core">
    <ScrollViewer AutomationProperties.AutomationId="SettingsPane">
        <!-- In a Grid: a ScrollViewer centres a narrower child by its desired width, which pushed
             the column off the right edge (see LaunchView). -->
        <Grid>
            <StackPanel MaxWidth="920" Padding="24,20,24,24" Spacing="8">
                <TextBlock Style="{StaticResource AbTypeTitle}" AutomationProperties.HeadingLevel="Level1" Text="Settings" />
                <InfoBar Severity="Error" Title="That didn't work" IsClosable="False" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind local:Ui.Show(ViewModel.Busy), Mode=OneWay}" />
    
                <!-- The host: the background program that watches this machine's agent sessions. -->
                <TextBlock Style="{StaticResource AbSectionTitle}" Text="{x:Bind local:SettingsView.HostSection}" />
                <InfoBar
                    Severity="Warning"
                    Title="agent-ha-bridge is running here"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasAgentHaBridge, Mode=OneWay}"
                    Message="{x:Bind local:SettingsView.HaNote(ViewModel.AgentHaBridge), Mode=OneWay}" />
                <InfoBar
                    Severity="Error"
                    Title="Home Assistant refuses this machine"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasHomeAssistantRefused, Mode=OneWay}"
                    Message="{x:Bind ViewModel.HomeAssistantRefused, Mode=OneWay}" />
                <InfoBar
                    Severity="Warning"
                    Title="The host is elevated"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.ElevatedWarning, Mode=OneWay}"
                    Message="It runs as administrator, so it cannot type into ordinary agent windows. Start it from this app instead." />
                <InfoBar
                    Severity="Informational"
                    Title="Restart the host"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.RestartRequired, Mode=OneWay}"
                    Message="Settings or agent hooks changed. Restart when you are ready; new agent sessions load the current hooks.">
                    <InfoBar.ActionButton>
                        <Button Content="Restart now" Click="OnRestart" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="HostState" Text="{x:Bind ViewModel.HostState, Mode=OneWay}" />
                <TextBlock Style="{StaticResource AbSecondaryText}" Text="{x:Bind local:SettingsView.HostLine(ViewModel.HostVersion, ViewModel.Profile), Mode=OneWay}" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource AbNeedsText}"
                    Text="The host is a different version from the app. Restart it to run the one installed with the app."
                    Visibility="{x:Bind local:Ui.Show(ViewModel.VersionSkew), Mode=OneWay}" />
                <local:WrapRow Spacing="8">
                    <Button Content="Start" AutomationProperties.AutomationId="StartHost" Click="OnStart" IsEnabled="{x:Bind local:Ui.Not(ViewModel.Busy), Mode=OneWay}" />
                    <Button Content="Stop" AutomationProperties.AutomationId="StopHost" Click="OnStop" IsEnabled="{x:Bind local:Ui.Not(ViewModel.Busy), Mode=OneWay}" />
                    <Button Content="Restart" AutomationProperties.AutomationId="RestartHost" Click="OnRestart" IsEnabled="{x:Bind local:Ui.Not(ViewModel.Busy), Mode=OneWay}" />
                </local:WrapRow>
                <ToggleSwitch
                    Header="Start the host when I sign in to Windows"
                    AutomationProperties.AutomationId="HostAtSignIn"
                    IsOn="{x:Bind ViewModel.StartAtSignIn, Mode=TwoWay}" />

                <TextBlock Style="{StaticResource AbSectionTitle}" Text="Agents on this machine" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Style="{StaticResource AbSecondaryText}" AutomationProperties.AutomationId="AgentsState" Text="{x:Bind ViewModel.AgentsState, Mode=OneWay}" />
                <Button Content="Check agents again" AutomationProperties.AutomationId="CheckAgents" Click="OnCheckAgents" IsEnabled="{x:Bind ViewModel.CanCheckAgents, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.AgentInstallStatus, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="AgentInstallStatus" />
                <Button Content="Cancel CLI installation" Click="OnCancelAgentInstall" Visibility="{x:Bind local:Ui.Show(ViewModel.AgentInstallInProgress), Mode=OneWay}" IsEnabled="{x:Bind ViewModel.HostRunning, Mode=OneWay}" AutomationProperties.AutomationId="CancelAgentInstall" />
                <ItemsControl x:Name="AgentList" ItemsSource="{x:Bind ViewModel.Agents, Mode=OneWay}" AutomationProperties.AutomationId="AgentReadiness">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:AgentReadinessRow">
                            <Border Background="{ThemeResource AbSubtle}" CornerRadius="{StaticResource AbRadiusCard}" Padding="16" Margin="0,0,0,8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level3" />
                                    <TextBlock Text="{x:Bind Installation}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource AbSecondaryText}" Text="{x:Bind Executable}" IsTextSelectionEnabled="True" />
                                    <TextBlock Style="{StaticResource AbSecondaryText}" Text="{x:Bind Home}" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind Checks}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource AbSecondaryText}" Text="{x:Bind HookActivity}" />
                                    <!-- One verb for the hooks' state, named for the agent (#678): the accent action
                                         when there is one, and Remove after it as the destructive one, in Danger text
                                         on a standard button, as End session is. -->
                                    <local:WrapRow Spacing="8">
                                        <Button
                                            Content="Install CLI"
                                            Tag="{x:Bind Id}"
                                            IsEnabled="{x:Bind CanInstall}"
                                            Click="OnInstallAgent"
                                            AutomationProperties.Name="{x:Bind InstallName}"
                                            AutomationProperties.AutomationId="{x:Bind InstallId}" />
                                        <Button
                                            Style="{StaticResource AccentButtonStyle}"
                                            Content="{x:Bind SetUpVerb}"
                                            Tag="{x:Bind Id}"
                                            Visibility="{x:Bind local:Ui.Show(ShowSetUp)}"
                                            IsEnabled="{x:Bind CanSetUp}"
                                            Click="OnSetUpAgent"
                                            AutomationProperties.Name="{x:Bind SetUpName}"
                                            AutomationProperties.AutomationId="{x:Bind SetUpId}" />
                                        <Button
                                            Content="Remove connection"
                                            Foreground="{ThemeResource AbDangerText}"
                                            Tag="{x:Bind Id}"
                                            IsEnabled="{x:Bind CanRemove}"
                                            Click="OnRemoveAgent"
                                            AutomationProperties.Name="{x:Bind RemoveName}"
                                            AutomationProperties.AutomationId="{x:Bind RemoveId}" />
                                    </local:WrapRow>
                                    <!-- This row's setup, as it runs and once it ends, read out for this agent. -->
                                    <TextBlock
                                        Text="{x:Bind Status}"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True"
                                        Loaded="OnAgentStatusLoaded"
                                        Visibility="{x:Bind local:Ui.Some(Status)}"
                                        AutomationProperties.LiveSetting="Polite"
                                        AutomationProperties.AutomationId="{x:Bind StatusId}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
    
                <!-- The relay: how this machine reaches the person's other devices. -->
                <TextBlock Style="{StaticResource AbSectionTitle}" Text="Your devices" />
                <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="Account" Text="{x:Bind ViewModel.AccountText, Mode=OneWay}" />
                <TextBlock Style="{StaticResource AbSecondaryText}" Text="{x:Bind ViewModel.RelayText, Mode=OneWay}" />
                <TextBox Header="Relay" AutomationProperties.AutomationId="RelayUrl" Text="{x:Bind ViewModel.RelayUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <local:WrapRow Spacing="8">
                    <Button
                        Content="Sign in with GitHub"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.AutomationId="SignIn"
                        IsEnabled="{x:Bind ViewModel.CanSignIn, Mode=OneWay}"
                        Click="OnSignIn" />
                </local:WrapRow>
                <Border
                    Background="{ThemeResource AbSubtle}"
                    CornerRadius="{StaticResource AbRadiusCard}"
                    Padding="16"
                    Visibility="{x:Bind local:Ui.Show(ViewModel.SignInPending), Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock TextWrapping="Wrap" Text="Open the page below, sign in to GitHub and enter this code:" />
                        <TextBlock
                            FontSize="28"
                            FontFamily="{StaticResource MonoFontFamily}"
                            IsTextSelectionEnabled="True"
                            AutomationProperties.AutomationId="SignInCode"
                            Text="{x:Bind ViewModel.SignInCode, Mode=OneWay}" />
                        <local:WrapRow Spacing="8">
                            <Button Content="Copy code and open the page" Style="{StaticResource AccentButtonStyle}" Click="OnOpenSignIn" />
                            <Button Content="Cancel" Click="OnCancelSignIn" />
                        </local:WrapRow>
                        <TextBlock Style="{StaticResource AbSecondaryText}" Text="{x:Bind ViewModel.SignInUri, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource AbDangerText}"
                    Text="{x:Bind ViewModel.SignInError, Mode=OneWay}"
                    Visibility="{x:Bind local:Ui.Some(ViewModel.SignInError), Mode=OneWay}" />
                <!-- The field takes the column's width and the button stays beside it, so neither is cut
                     off at the 360 px window. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Header="This machine's name on your devices"
                        AutomationProperties.AutomationId="MachineName"
                        Text="{x:Bind ViewModel.MachineName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Save name" Click="OnSaveName" IsEnabled="{x:Bind ViewModel.HostRunning, Mode=OneWay}" />
                </Grid>
                <ToggleSwitch
                    Header="Let this app and my devices approve Copilot permission prompts"
                    AutomationProperties.AutomationId="RemoteApproval"
                    IsEnabled="{x:Bind ViewModel.HostRunning, Mode=OneWay}"
                    IsOn="{x:Bind ViewModel.RemoteApproval, Mode=TwoWay}" />
                <TextBlock
                    Style="{StaticResource AbSecondaryText}"
                    Text="Off: Copilot's Approve once and Deny are answered only in the agent's own window. Questions are still answered anywhere. A change applies when the host restarts." />
                <ToggleSwitch
                    Header="Answer folder-trust questions from my devices"
                    AutomationProperties.AutomationId="RemoteFolderTrust"
                    IsEnabled="{x:Bind ViewModel.HostRunning, Mode=OneWay}"
                    IsOn="{x:Bind ViewModel.RemoteFolderTrust, Mode=TwoWay}" />
                <TextBlock
                    Style="{StaticResource AbSecondaryText}"
                    Text="When an agent launched from a device asks whether to trust its folder, Trust or Quit can be answered from the devices approved below. Trusting a folder lets the agent run what is in it. Off: it is answered only at this machine. Applies at once." />
                <ItemsControl
                    AutomationProperties.AutomationId="TrustDevices"
                    ItemsSource="{x:Bind ViewModel.TrustDevices, Mode=OneWay}"
                    Visibility="{x:Bind local:Ui.Show(ViewModel.ShowTrustDevices), Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:TrustDevice">
                            <CheckBox
                                AutomationProperties.AutomationId="TrustDevice"
                                Content="{x:Bind Label}"
                                IsChecked="{x:Bind Approved, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- A Dev Box only: its pending stop-on-disconnect kept away while the host runs. -->
                <StackPanel Spacing="8" Visibility="{x:Bind local:Ui.Show(ViewModel.ShowDevBox), Mode=OneWay}">
                    <ToggleSwitch
                        Header="Keep this Dev Box awake while the host runs"
                        AutomationProperties.AutomationId="DevBoxKeepAwake"
                        IsEnabled="{x:Bind ViewModel.HostRunning, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.DevBoxKeepAwake, Mode=TwoWay}" />
                    <TextBlock
                        Style="{StaticResource AbSecondaryText}"
                        Text="The host asks Dev Center, as you (through your Azure CLI sign-in, az login), to skip or delay this Dev Box's pending stop-on-disconnect, and nothing else. A Dev Box kept awake keeps costing money. Applies at once." />
                    <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="DevBoxState" Text="{x:Bind ViewModel.DevBoxText, Mode=OneWay}" />
                    <TextBlock
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource AbDangerText}"
                        AutomationProperties.AutomationId="DevBoxAlarm"
                        Text="{x:Bind ViewModel.DevBoxAlarm, Mode=OneWay}"
                        Visibility="{x:Bind local:Ui.Some(ViewModel.DevBoxAlarm), Mode=OneWay}" />
                </StackPanel>    
                <!-- The app itself. -->
                <TextBlock Style="{StaticResource AbSectionTitle}" Text="This app" />
                <ToggleSwitch Header="Show reasoning and tool history on cards" AutomationProperties.AutomationId="ShowDetail" IsOn="{x:Bind ViewModel.ShowDetail, Mode=TwoWay}" />
                <ToggleSwitch Header="Notify me when a session asks something" AutomationProperties.AutomationId="Toasts" IsOn="{x:Bind ViewModel.Toasts, Mode=TwoWay}" />
                <ToggleSwitch Header="Notify me when a session finishes a turn" AutomationProperties.AutomationId="FinishedToasts" IsEnabled="{x:Bind ViewModel.Toasts, Mode=OneWay}" IsOn="{x:Bind ViewModel.FinishedToasts, Mode=TwoWay}" />
                <ToggleSwitch Header="Start the app in the notification area when I sign in" AutomationProperties.AutomationId="AppAtSignIn" IsOn="{x:Bind ViewModel.AppStartsAtSignIn, Mode=TwoWay}" />
                <ToggleSwitch Header="Include pre-releases in updates" AutomationProperties.AutomationId="Prereleases" IsOn="{x:Bind ViewModel.Prereleases, Mode=TwoWay}" />
                <ToggleSwitch Header="Install updates automatically" AutomationProperties.AutomationId="AutoUpdate" IsOn="{x:Bind ViewModel.AutoUpdate, Mode=TwoWay}" />
                <TextBlock
                    Style="{StaticResource AbSecondaryText}"
                    Text="Checked every half hour. An update waits until no session here has had a turn running or a question waiting for two minutes, for at most six hours, then restarts the app and the host. Read-only hosts and hosts beside agent-ha-bridge update too; never while another profile runs from this installation." />
                <TextBlock Text="{x:Bind local:SettingsView.AppLine(ViewModel.AppVersion, ViewModel.InstalledText), Mode=OneWay}" Style="{StaticResource AbSecondaryText}" />
                <local:WrapRow Spacing="8">
                    <Button Content="Check for updates" AutomationProperties.AutomationId="CheckUpdates" Click="OnCheckUpdates" IsEnabled="{x:Bind local:Ui.Not(ViewModel.Busy), Mode=OneWay}" />
                    <Button
                        Content="Update and restart"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.AutomationId="InstallUpdate"
                        Visibility="{x:Bind local:Ui.Show(ViewModel.UpdateAvailable), Mode=OneWay}"
                        Click="OnInstallUpdate" />
                </local:WrapRow>
                <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="UpdateStatus" Text="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}" />
    
                <!-- The host's log, read from its file, so it is there when the host is not. -->
                <Grid Margin="0,12,0,4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Host log" />
                    <Button HorizontalAlignment="Right" Content="Refresh" Click="OnRefreshLog" />
                </Grid>
                <TextBox
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    MaxHeight="360"
                    FontFamily="{StaticResource MonoFontFamily}"
                    FontSize="12"
                    AutomationProperties.AutomationId="HostLog"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{x:Bind ViewModel.Log, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
