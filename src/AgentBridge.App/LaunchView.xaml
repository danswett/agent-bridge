<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AgentBridge.App.LaunchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentBridge.App"
    xmlns:core="using:AgentBridge.App.Core">
    <!-- Start a session (pwa/js/ui/launch-view.js): on any machine of the account that can, with
         the choices that machine offers (launch.options), and the whole prompt. -->
    <UserControl.Resources>
        <DataTemplate x:Key="ChoiceTemplate" x:DataType="core:Choice">
            <TextBlock Text="{x:Bind Label}" />
        </DataTemplate>
        <!-- A launched agent asking whether to trust its folder: the whole path, wrapped and
             selectable, never cut short; its repository root and its own words; Trust and Quit
             where this app may answer, else why not. -->
        <DataTemplate x:Key="TrustTemplate" x:DataType="core:TrustCard">
            <Border
                AutomationProperties.AutomationId="TrustCard"
                AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" Text="{x:Bind Title, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource AbSecondaryText}" Text="Folder" />
                    <TextBlock
                        AutomationProperties.AutomationId="TrustFolder"
                        FontFamily="{StaticResource MonoFontFamily}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                        Text="{x:Bind Folder, Mode=OneWay}" />
                    <StackPanel Spacing="4" Visibility="{x:Bind local:Ui.Show(ShowRoot), Mode=OneWay}">
                        <TextBlock Style="{StaticResource AbSecondaryText}" TextWrapping="Wrap" Text="{x:Bind RootNote, Mode=OneWay}" />
                        <TextBlock
                            AutomationProperties.AutomationId="TrustRoot"
                            FontFamily="{StaticResource MonoFontFamily}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                            Text="{x:Bind Root, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        AutomationProperties.AutomationId="TrustWarning"
                        TextWrapping="Wrap" IsTextSelectionEnabled="True"
                        Text="{x:Bind Warning, Mode=OneWay}"
                        Visibility="{x:Bind local:Ui.Show(ShowWarning), Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind local:Ui.Show(CanAnswer), Mode=OneWay}">
                        <Button Style="{StaticResource AccentButtonStyle}" Content="Trust" AutomationProperties.AutomationId="TrustYes" Click="OnTrust" />
                        <Button Content="Quit" AutomationProperties.AutomationId="TrustNo" Click="OnQuit" />
                    </StackPanel>
                    <Button
                        Content="Try again" AutomationProperties.AutomationId="TrustResend"
                        Visibility="{x:Bind local:Ui.Show(ShowResend), Mode=OneWay}" Click="OnTrustResend" />
                    <TextBlock
                        AutomationProperties.AutomationId="TrustAtMachine"
                        TextWrapping="Wrap" IsTextSelectionEnabled="True"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Text="{x:Bind AtMachine, Mode=OneWay}"
                        Visibility="{x:Bind local:Ui.Show(ShowAtMachine), Mode=OneWay}" />
                    <Button
                        Content="Allow answering from this app" AutomationProperties.AutomationId="TrustAllow"
                        Visibility="{x:Bind local:Ui.Show(ShowAllowHere), Mode=OneWay}" Click="OnTrustAllow" />
                    <TextBlock
                        AutomationProperties.AutomationId="TrustStatus"
                        AutomationProperties.LiveSetting="Polite"
                        TextWrapping="Wrap" IsTextSelectionEnabled="True"
                        Text="{x:Bind StatusText, Mode=OneWay}"
                        Foreground="{x:Bind local:Ui.ToneBrush(StatusTone), Mode=OneWay}"
                        Visibility="{x:Bind local:Ui.Show(ShowStatus), Mode=OneWay}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer AutomationProperties.AutomationId="LaunchPane">
        <!-- In a Grid: a ScrollViewer centres a narrower child by its desired width, so a
             column narrower than its MaxWidth was pushed off the right edge. -->
        <Grid>
            <StackPanel MaxWidth="720" Padding="24,20,24,24" Spacing="12">
                <TextBlock Style="{StaticResource AbTypeTitle}" AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="LaunchTitle" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                <ComboBox
                    x:Name="MachineBox" Tag="machine" Header="Machine" MinWidth="320"
                    AutomationProperties.AutomationId="LaunchMachine"
                    ItemTemplate="{StaticResource ChoiceTemplate}"
                    ItemsSource="{x:Bind ViewModel.Machines, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedMachine, Mode=OneWay}"
                    SelectionChanged="OnPicked"
                    Visibility="{x:Bind local:Ui.Show(ViewModel.ShowMachines), Mode=OneWay}" />
                <TextBlock
                    AutomationProperties.AutomationId="LaunchNote"
                    TextWrapping="Wrap" IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.Note, Mode=OneWay}"
                    Foreground="{x:Bind local:LaunchView.NoteBrush(ViewModel.NoteWarns), Mode=OneWay}"
                    Visibility="{x:Bind local:Ui.Some(ViewModel.Note), Mode=OneWay}" />
                <InfoBar
                    AutomationProperties.AutomationId="LaunchBusy"
                    IsClosable="False" Severity="Warning"
                    IsOpen="{x:Bind local:LaunchView.Has(ViewModel.Busy), Mode=OneWay}"
                    Message="{x:Bind ViewModel.Busy, Mode=OneWay}" />
                <ItemsControl
                    x:Name="TrustList"
                    AutomationProperties.AutomationId="TrustQuestions"
                    ItemsSource="{x:Bind ViewModel.TrustQuestions, Mode=OneWay}"
                    ItemTemplate="{StaticResource TrustTemplate}"
                    Visibility="{x:Bind local:Ui.Show(ViewModel.ShowTrust), Mode=OneWay}" />
                <TextBlock
                    AutomationProperties.AutomationId="TrustNote"
                    TextWrapping="Wrap"
                    Foreground="{x:Bind local:LaunchView.ProblemBrush()}"
                    Text="{x:Bind ViewModel.TrustNote, Mode=OneWay}"
                    Visibility="{x:Bind local:Ui.Some(ViewModel.TrustNote), Mode=OneWay}" />
                <StackPanel Spacing="12" Visibility="{x:Bind local:Ui.Show(ViewModel.ShowForm), Mode=OneWay}">
                    <ComboBox
                        Tag="resume" Header="Resume" MinWidth="320" AutomationProperties.AutomationId="LaunchResume"
                        ItemTemplate="{StaticResource ChoiceTemplate}"
                        ItemsSource="{x:Bind ViewModel.Resumes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Resume, Mode=OneWay}"
                        SelectionChanged="OnPicked" Visibility="{x:Bind local:Ui.Show(ViewModel.ShowResume), Mode=OneWay}" />
                    <ComboBox
                        Tag="agent" Header="Agent" MinWidth="320" AutomationProperties.AutomationId="LaunchAgent"
                        ItemTemplate="{StaticResource ChoiceTemplate}"
                        ItemsSource="{x:Bind ViewModel.Agents, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Agent, Mode=OneWay}"
                        SelectionChanged="OnPicked" />
                    <ComboBox
                        Tag="workspace" Header="Workspace" MinWidth="320" AutomationProperties.AutomationId="LaunchWorkspace"
                        ItemTemplate="{StaticResource ChoiceTemplate}"
                        ItemsSource="{x:Bind ViewModel.Workspaces, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Workspace, Mode=OneWay}"
                        SelectionChanged="OnPicked" Visibility="{x:Bind local:Ui.Show(ViewModel.ShowWorkspace), Mode=OneWay}" />
                    <ComboBox
                        Tag="profile" Header="Profile" MinWidth="320" AutomationProperties.AutomationId="LaunchProfile"
                        ItemTemplate="{StaticResource ChoiceTemplate}"
                        ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Profile, Mode=OneWay}"
                        SelectionChanged="OnPicked" Visibility="{x:Bind local:Ui.Show(ViewModel.ShowProfile), Mode=OneWay}" />
                    <ComboBox
                        Tag="model" Header="Model" MinWidth="320" AutomationProperties.AutomationId="LaunchModel"
                        ItemTemplate="{StaticResource ChoiceTemplate}"
                        ItemsSource="{x:Bind ViewModel.Models, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Model, Mode=OneWay}"
                        SelectionChanged="OnPicked" Visibility="{x:Bind local:Ui.Show(ViewModel.ShowModel), Mode=OneWay}" />
                    <ComboBox
                        Tag="effort" Header="Effort" MinWidth="320" AutomationProperties.AutomationId="LaunchEffort"
                        ItemTemplate="{StaticResource ChoiceTemplate}"
                        ItemsSource="{x:Bind ViewModel.Efforts, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Effort, Mode=OneWay}"
                        SelectionChanged="OnPicked" Visibility="{x:Bind local:Ui.Show(ViewModel.ShowEffort), Mode=OneWay}" />
                    <ComboBox
                        Tag="context" Header="Context" MinWidth="320" AutomationProperties.AutomationId="LaunchContext"
                        ItemTemplate="{StaticResource ChoiceTemplate}"
                        ItemsSource="{x:Bind ViewModel.Contexts, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Context, Mode=OneWay}"
                        SelectionChanged="OnPicked" Visibility="{x:Bind local:Ui.Show(ViewModel.ShowContext), Mode=OneWay}" />
                    <ComboBox
                        Tag="permissions" Header="Permissions" MinWidth="320" AutomationProperties.AutomationId="LaunchPermissions"
                        ItemTemplate="{StaticResource ChoiceTemplate}"
                        ItemsSource="{x:Bind ViewModel.PermissionChoices}" SelectedItem="{x:Bind ViewModel.Permissions, Mode=OneWay}"
                        SelectionChanged="OnPicked" />
                    <TextBox
                        Header="First message"
                        AutomationProperties.AutomationId="LaunchPrompt"
                        AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxHeight="320"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        PlaceholderText="{x:Bind ViewModel.PromptPlaceholder, Mode=OneWay}"
                        Text="{x:Bind ViewModel.Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Style="{StaticResource AbSecondaryText}"
                        Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                        Foreground="{x:Bind local:LaunchView.NoteBrush(ViewModel.CountTooLong), Mode=OneWay}"
                        Visibility="{x:Bind local:Ui.Some(ViewModel.CountText), Mode=OneWay}" />
                    <Button
                        Style="{StaticResource AccentButtonStyle}" Content="Launch"
                        AutomationProperties.AutomationId="LaunchButton"
                        IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}" Click="OnLaunch" />
                    <!-- Why the form cannot go as it is: apart from the last launch's outcome below. -->
                    <TextBlock
                        x:Name="ProblemLine"
                        AutomationProperties.AutomationId="LaunchProblem"
                        AutomationProperties.LiveSetting="Assertive"
                        TextWrapping="Wrap"
                        Text="{x:Bind ViewModel.Problem, Mode=OneWay}"
                        Foreground="{x:Bind local:LaunchView.ProblemBrush()}"
                        Visibility="{x:Bind local:Ui.Some(ViewModel.Problem), Mode=OneWay}" />
                </StackPanel>
                <!-- The last launch's outcome and what can be done about it: outside the form, which a
                     failed reload of the choices hides. Announced as it changes. -->
                <TextBlock
                    x:Name="StatusLine"
                    AutomationProperties.AutomationId="LaunchStatus"
                    AutomationProperties.LiveSetting="Polite"
                    TextWrapping="Wrap" IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    Foreground="{x:Bind local:Ui.ToneBrush(ViewModel.StatusTone), Mode=OneWay}"
                    Visibility="{x:Bind local:Ui.Some(ViewModel.StatusText), Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Content="Try again" AutomationProperties.AutomationId="LaunchResend"
                        Visibility="{x:Bind local:Ui.Show(ViewModel.ShowResend), Mode=OneWay}" Click="OnResend" />
                    <Button
                        Content="Open session" AutomationProperties.AutomationId="LaunchOpen"
                        Visibility="{x:Bind local:Ui.Show(ViewModel.ShowOpen), Mode=OneWay}" Click="OnOpen" />
                </StackPanel>
                <Button
                    Content="{x:Bind ViewModel.ReloadText, Mode=OneWay}" AutomationProperties.AutomationId="LaunchReload"
                    IsEnabled="{x:Bind ViewModel.CanReload, Mode=OneWay}"
                    Visibility="{x:Bind local:Ui.Show(ViewModel.ShowReload), Mode=OneWay}" Click="OnReload" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
