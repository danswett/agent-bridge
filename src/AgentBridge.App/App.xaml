<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AgentBridge.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The PWA's palette (pwa/app.css), so a card reads the same on the desktop. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AbPrimary" Color="#0969da" />
                    <SolidColorBrush x:Key="AbWarning" Color="#bf8700" />
                    <SolidColorBrush x:Key="AbWarningText" Color="#8a5a00" />
                    <SolidColorBrush x:Key="AbDanger" Color="#cf222e" />
                    <SolidColorBrush x:Key="AbOk" Color="#1a7f37" />
                    <SolidColorBrush x:Key="AbMuted" Color="#59636e" />
                    <SolidColorBrush x:Key="AbBorder" Color="#d1d9e0" />
                    <SolidColorBrush x:Key="AbSurface" Color="#ffffff" />
                    <SolidColorBrush x:Key="AbCodeBg" Color="#eff2f5" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AbPrimary" Color="#4493f8" />
                    <SolidColorBrush x:Key="AbWarning" Color="#d29922" />
                    <SolidColorBrush x:Key="AbWarningText" Color="#e3b341" />
                    <SolidColorBrush x:Key="AbDanger" Color="#f85149" />
                    <SolidColorBrush x:Key="AbOk" Color="#3fb950" />
                    <SolidColorBrush x:Key="AbMuted" Color="#9ea7b3" />
                    <SolidColorBrush x:Key="AbBorder" Color="#3d444d" />
                    <SolidColorBrush x:Key="AbSurface" Color="#151b23" />
                    <SolidColorBrush x:Key="AbCodeBg" Color="#0d1117" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AbPrimary" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AbWarning" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AbWarningText" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AbDanger" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AbOk" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AbMuted" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="AbBorder" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AbSurface" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AbCodeBg" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="AbSecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AbMuted}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>
            <Style x:Key="AbSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,12,0,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
