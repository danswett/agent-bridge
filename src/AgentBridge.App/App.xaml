<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AgentBridge.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- The design language's colour roles and surfaces (Light, Dark, HighContrast),
                     mono stack, glyphs and icons, generated from design/ by tools/design-gen
                     (design/README.md). The PWA gets the same, so a card reads the same on
                     the desktop. No colour is written here. -->
                <ResourceDictionary Source="ms-appx:///Design/DesignResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="AbSecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AbText2}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>
            <Style x:Key="AbSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,12,0,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
