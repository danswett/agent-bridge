<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AgentBridge.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- The design language's colour roles and surfaces (Light, Dark, HighContrast),
                     type ramp in Slipgates Sans and Slipgates Mono, glyphs and icons, generated
                     from design/ by tools/design-gen (design/README.md). The PWA gets the same,
                     so a card reads the same on the desktop. No colour is written here. -->
                <ResourceDictionary Source="ms-appx:///Design/DesignResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- #1202: in high contrast an accent button is the system pair, HighlightText on Highlight
                 (swapped as the pointer is over or presses it), and nothing inside it sets its own
                 background, so no plate shows under the label of Try again, Restart to update or
                 Sign in. System colours only. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- A keyed style replaces the implicit TextBlock style, so each one here names the text face. -->
            <Style x:Key="AbSecondaryText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SansFontFamily}" />
                <Setter Property="Foreground" Value="{ThemeResource AbText2}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>
            <!-- Inline mono (ui.md §4.2, #215): a path, id, branch or tool call on a line of a ramp
                 role, in Slipgates Mono at that role's generated inline size (its x-height the text
                 face's) and the role's own line height and weight. The Code role (AbTypeCode) is for
                 code standing on its own lines. -->
            <Style x:Key="InlineMonoRow" TargetType="TextBlock" BasedOn="{StaticResource AbTypeRow}">
                <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource AbInlineMonoRow}" />
            </Style>
            <Style x:Key="InlineMonoMeta" TargetType="TextBlock" BasedOn="{StaticResource AbTypeMeta}">
                <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource AbInlineMonoMeta}" />
            </Style>
            <Style x:Key="AbSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="FontFamily" Value="{StaticResource SansFontFamily}" />
                <Setter Property="Margin" Value="0,12,0,4" />
            </Style>
            <!-- A subtle icon button for a header's actions (ui.md §7): 32×32, the desktop's smallest
                 target (§9), no fill until the pointer is over it. Its icon is a design icon at 16. -->
            <Style x:Key="AbIconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="CornerRadius" Value="{StaticResource AbRadiusControl}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
