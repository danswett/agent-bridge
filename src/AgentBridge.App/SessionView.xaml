<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AgentBridge.App.SessionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentBridge.App"
    xmlns:core="using:AgentBridge.App.Core">
    <!-- The session pane (docs/design/ui.md §6.2, §6.3, §6.4, §6.5): the header with one meta line and
         its actions; its delegates' strip at three panes, or Conversation, Delegates and Tools tabs
         where there is no inspector; the conversation at the reading measure, the main agent's own
         words only; and the reply box. Status is the glyph and its words,
         never an edge or a glow (#178). -->

    <UserControl.Resources>
        <!-- A delegate in the Delegates tab: its glyph on line 1, its name and how long it has run,
             who started it where the indent can't say, and its latest line, its own words. -->
        <DataTemplate x:Key="DelegateRowTemplate" x:DataType="core:DelegateItem">
            <Grid Padding="0,8" ColumnSpacing="8" Margin="{x:Bind local:SessionView.IndentOf(Indent), Mode=OneWay}" AutomationProperties.Name="{x:Bind Label, Mode=OneWay}" AutomationProperties.AutomationId="{x:Bind local:SessionView.RowId(Id)}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <local:StatusGlyphView Margin="0,3,0,0" VerticalAlignment="Top" Size="14" Glyph="{x:Bind Glyph, Mode=OneWay}" />
                <TextBlock Grid.Column="1" Style="{StaticResource AbTypeRow}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{x:Bind Name, Mode=OneWay}" />
                <TextBlock Grid.Column="2" Style="{StaticResource AbTypeMeta}" LineHeight="20" Foreground="{ThemeResource AbText2}" Text="{x:Bind Time, Mode=OneWay}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource AbTypeMeta}" Foreground="{ThemeResource AbText2}" Text="{x:Bind UnderText, Mode=OneWay}" Visibility="{x:Bind local:Ui.Some(UnderText), Mode=OneWay}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource AbTypeMeta}" Foreground="{ThemeResource AbText2}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Text="{x:Bind Line, Mode=OneWay}" Visibility="{x:Bind local:Ui.Show(HasLine), Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <!-- A message's time (#1619, §6.4): the relative or clock text, with the exact time with seconds as
             the tooltip (hover, keyboard focus), the tap/click popover and the fixed accessible name. -->
        <DataTemplate x:Key="MessageTimeTemplate" x:DataType="core:MessageStamp">
            <Button
                Style="{StaticResource AbTimeButton}"
                AutomationProperties.Name="{x:Bind Exact}"
                AutomationProperties.AutomationId="MessageTime"
                ToolTipService.ToolTip="{x:Bind Exact}">
                <TextBlock Style="{StaticResource AbTypeMeta}" Foreground="{ThemeResource AbText2}" Text="{x:Bind Text}" />
                <Button.Flyout>
                    <Flyout>
                        <TextBlock Style="{StaticResource AbTypeMeta}" IsTextSelectionEnabled="True" Text="{x:Bind Exact}" />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="ViewRoot">
        <VisualStateManager.VisualStateGroups>
            <!-- The status words' colour (ui.md §2.2, §3), as on the row. -->
            <VisualStateGroup x:Name="Words">
                <VisualState x:Name="WordsUnset" />
                <VisualState x:Name="WordsPlain">
                    <VisualState.Setters>
                        <Setter Target="StatusWords.Foreground" Value="{ThemeResource AbText2}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WordsNeeds">
                    <VisualState.Setters>
                        <Setter Target="StatusWords.Foreground" Value="{ThemeResource AbNeedsText}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WordsAgent">
                    <VisualState.Setters>
                        <Setter Target="StatusWords.Foreground" Value="{ThemeResource AbAgentText}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WordsMuted">
                    <VisualState.Setters>
                        <Setter Target="StatusWords.Foreground" Value="{ThemeResource AbText2}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The header. -->
        <Grid Padding="24,20,16,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Style="{StaticResource AbIconButton}"
                Margin="-8,0,0,0"
                VerticalAlignment="Top"
                AutomationProperties.AutomationId="Back"
                AutomationProperties.Name="Back to sessions"
                ToolTipService.ToolTip="Back to sessions"
                Visibility="{x:Bind local:Ui.Show(Layout.ShowBack), Mode=OneWay}"
                Click="OnBack">
                <ContentControl Style="{StaticResource AbIconBack}" Width="16" Height="16" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock
                    Style="{StaticResource AbTypeTitle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    AutomationProperties.HeadingLevel="Level1"
                    AutomationProperties.AutomationId="SessionTitle"
                    Text="{x:Bind Card.Title, Mode=OneWay}" />
                <local:MoveStripView Move="{x:Bind Card.Move, Mode=OneWay}" />
                <!-- One meta line (§6.2): glyph · status · machine · repository, on one line so no
                     separator starts a line (#214); the names in the text face (#215). -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <local:StatusGlyphView
                        x:Name="HeaderGlyph"
                        VerticalAlignment="Center"
                        Fades="True"
                        AutomationProperties.AutomationId="StatusGlyph"
                        Size="16"
                        Glyph="{x:Bind Card.Glyph, Mode=OneWay}"
                        Driven="{x:Bind Card.Driven, Mode=OneWay}"
                        Label="{x:Bind Card.GlyphLabel, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource AbTypeMeta}"
                        Foreground="{ThemeResource AbText2}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTipService.ToolTip="{x:Bind Card.DriverPrincipal, Mode=OneWay}"
                        AutomationProperties.AutomationId="HeaderMeta">
                        <Run x:Name="StatusWords" Text="{x:Bind Card.StatusText, Mode=OneWay}" /><Run Text="{x:Bind local:SessionRow.Separator(Card.HeaderPlace), Mode=OneWay}" /><Run Text="{x:Bind Card.HeaderPlace, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
            </StackPanel>
            <!-- Subtle icon buttons with tooltips (§6.2): Pin, Details, and the inspector. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                <Button
                    Style="{StaticResource AbIconButton}"
                    AutomationProperties.AutomationId="HeaderPin"
                    AutomationProperties.Name="{x:Bind local:SessionView.PinName(Card.Pinned), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind local:SessionView.PinName(Card.Pinned), Mode=OneWay}"
                    Click="OnPin">
                    <!-- Bridge while pinned. Two icons, each in a ThemeResource, so either follows a theme
                         change; a brush handed over by a function would keep the theme it was made in. -->
                    <Grid>
                        <ContentControl Style="{StaticResource AbIconPin}" Width="16" Height="16" Foreground="{ThemeResource AbText2}" Visibility="{x:Bind local:SessionView.Unpinned(Card.Pinned), Mode=OneWay, FallbackValue=Visible}" />
                        <ContentControl Style="{StaticResource AbIconPin}" Width="16" Height="16" Foreground="{ThemeResource AbBridge}" Visibility="{x:Bind local:Ui.Show(Card.Pinned), Mode=OneWay, FallbackValue=Collapsed}" />
                    </Grid>
                </Button>
                <Button
                    Style="{StaticResource AbIconButton}"
                    AutomationProperties.AutomationId="Details"
                    AutomationProperties.Name="Details"
                    ToolTipService.ToolTip="Details">
                    <ContentControl Style="{StaticResource AbIconMore}" Width="16" Height="16" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <local:SessionDetails x:Name="DetailsFlyout" Width="320" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    Style="{StaticResource AbIconButton}"
                    AutomationProperties.AutomationId="ToggleInspector"
                    AutomationProperties.Name="{x:Bind Layout.InspectorToggleName, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Layout.InspectorToggleName, Mode=OneWay}"
                    Visibility="{x:Bind local:Ui.Show(Layout.CanToggleInspector), Mode=OneWay}"
                    Click="OnToggleInspector">
                    <ContentControl Style="{StaticResource AbIconInspector}" Width="16" Height="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Conversation / Delegates / Tools, where there is no inspector (§5.2). Delegates while the
             host lists some or reports counts. -->
        <SelectorBar
            x:Name="Tabs"
            Grid.Row="1"
            Margin="16,0,16,4"
            AutomationProperties.AutomationId="SessionTabs"
            Visibility="{x:Bind local:Ui.Show(Layout.ShowTabs), Mode=OneWay}"
            SelectionChanged="OnTab">
            <SelectorBarItem x:Name="ConversationTab" Text="Conversation" Tag="Conversation" IsSelected="True" />
            <SelectorBarItem x:Name="DelegatesTab" Text="Delegates" Tag="Delegates" Visibility="{x:Bind local:Ui.Show(Layout.ShowDelegatesTab), Mode=OneWay, FallbackValue=Collapsed}" />
            <SelectorBarItem x:Name="ToolsTab" Text="Tools" Tag="Tools" Visibility="{x:Bind local:Ui.Show(Layout.ShowToolsTab), Mode=OneWay, FallbackValue=Collapsed}" />
        </SelectorBar>

        <!-- The delegate strip (§6.3), at three panes, where the tabs are not: one item per delegate
             the main agent started, its glyph, name, and how long it has run and how many it
             started; the selected one in Bridge; the finished folded into "N finished". -->
        <ListView
            x:Name="DelegateStrip"
            Grid.Row="1"
            Margin="12,0,12,8"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnStripItem"
            AutomationProperties.AutomationId="DelegateStrip"
            AutomationProperties.Name="Delegates"
            ScrollViewer.HorizontalScrollMode="Enabled"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollMode="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            ItemsSource="{x:Bind Card.Delegates.Strip, Mode=OneWay}"
            Visibility="{x:Bind local:Ui.Show(Layout.ShowStrip), Mode=OneWay, FallbackValue=Collapsed}">
            <!-- No transitions of its own (ui.md §5.3, Arriving and leaving): a delegate's neighbours never slide. -->
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,8,0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:DelegateItem">
                    <Grid MinWidth="160" MaxWidth="240" AutomationProperties.Name="{x:Bind Label, Mode=OneWay}" AutomationProperties.AutomationId="{x:Bind local:SessionView.StripId(Id)}">
                        <!-- Two edges, each a ThemeResource, so either follows a theme change. -->
                        <Border BorderThickness="1" BorderBrush="{ThemeResource AbStroke}" CornerRadius="{StaticResource AbRadiusCard}" Visibility="{x:Bind local:Ui.Show(NotSelected), Mode=OneWay}" />
                        <Border BorderThickness="1" BorderBrush="{ThemeResource AbBridge}" Background="{ThemeResource AbSelected}" CornerRadius="{StaticResource AbRadiusCard}" Visibility="{x:Bind local:Ui.Show(Selected), Mode=OneWay}" />
                        <Grid Padding="12,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <local:StatusGlyphView Margin="0,3,0,0" VerticalAlignment="Top" Size="14" Glyph="{x:Bind Glyph, Mode=OneWay}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource AbTypeRow}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" Text="{x:Bind Name, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource AbTypeMeta}" Foreground="{ThemeResource AbText2}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{x:Bind Facts, Mode=OneWay}" Visibility="{x:Bind local:Ui.Some(Facts), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <TextBlock
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource AbTypeMeta}"
                    Foreground="{ThemeResource AbText2}"
                    Text="{x:Bind Card.Delegates.MoreText, Mode=OneWay}"
                    Visibility="{x:Bind local:Ui.Show(Card.Delegates.HasMore), Mode=OneWay, FallbackValue=Collapsed}" />
            </ListView.Footer>
        </ListView>

        <Grid x:Name="TabContent" Grid.Row="2">
            <!-- The conversation (§6.4): the main agent only, at the reading measure, centred in the
                 pane as the PWA's is; the scroll bar stays at the pane's edge. A list, so only the
                 response's blocks near the viewport are realised and a live resize re-wraps those
                 alone (#765): each block an item a screen reader counts and reaches off screen (#707),
                 with no item chrome, selection or focus visual of its own. What comes before the
                 response is the list's header, what comes after it its footer, each the same column. -->
            <ListView
                x:Name="ConversationList"
                AutomationProperties.AutomationId="Conversation"
                AutomationProperties.Name="Conversation"
                Padding="0"
                SelectionMode="None"
                IsItemClickEnabled="False"
                IsTabStop="False"
                ShowsScrollingPlaceholders="False"
                TabNavigation="Local"
                ContainerContentChanging="OnBlockShown"
                Visibility="{x:Bind local:Ui.Show(Layout.ShowConversation), Mode=OneWay}">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.HeaderTransitions>
                    <TransitionCollection />
                </ListView.HeaderTransitions>
                <ListView.FooterTransitions>
                    <TransitionCollection />
                </ListView.FooterTransitions>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" CacheLength="2" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <!-- No chrome: the block as drawn before, focus on the controls inside it. -->
                    <Style TargetType="ListViewItem">
                        <Setter Property="IsTabStop" Value="False" />
                        <Setter Property="UseSystemFocusVisuals" Value="False" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <!-- A block, 8 below the one before (the response's own spacing), in the column. -->
                    <DataTemplate x:DataType="core:ConversationBlock">
                        <local:ReadingColumn MaxWidth="{StaticResource AbLayoutReadingMax}" HorizontalAlignment="Center" Padding="24,8,24,0">
                            <local:MarkdownView Reading="True" AutomationProperties.AutomationId="ResponseBlock" Block="{x:Bind Block}" />
                        </local:ReadingColumn>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Header>
                <!-- The pane's width, whatever the header's host gives it, so the column centres in the pane. -->
                <local:ReadingColumn x:Name="ConversationHeader">
                <!-- The stored turns, oldest first, above the latest exchange (#292, §6.4 History). -->
                <local:ReadingColumn
                    x:Name="HistoryColumn"
                    MaxWidth="{StaticResource AbLayoutReadingMax}"
                    HorizontalAlignment="Center"
                    Padding="24,8,24,0"
                    Spacing="16">
                    <TextBlock
                        x:Name="HistoryLine"
                        Style="{StaticResource AbTypeMeta}"
                        Foreground="{ThemeResource AbText2}"
                        TextWrapping="Wrap"
                        AutomationProperties.AutomationId="HistoryLine"
                        Visibility="Collapsed" />
                    <Button x:Name="HistoryRetry" Content="Try again" Click="OnHistoryRetry" Visibility="Collapsed" />
                    <ItemsRepeater x:Name="HistoryRows" AutomationProperties.AutomationId="History">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="16" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="core:HistoryRow">
                                <StackPanel Spacing="8" AutomationProperties.AutomationId="HistoryTurn">
                                    <!-- A prompt the person didn't type, collapsed as the live card draws it (#1611). -->
                                    <StackPanel Spacing="4" AutomationProperties.AutomationId="HistoryPrompt" Visibility="{x:Bind local:Ui.Some(Disclosure)}">
                                        <local:FlowPanel Spacing="8" LineSpacing="0">
                                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                                <ContentControl
                                                    Style="{StaticResource AbIconClock}"
                                                    Width="16"
                                                    Height="16"
                                                    Foreground="{ThemeResource AbAgent}"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    Visibility="{x:Bind local:Ui.Show(Disclosure.Origin.Schedule)}" />
                                                <ContentControl
                                                    Style="{StaticResource AbGlyphDrivenBadge}"
                                                    Width="16"
                                                    Height="16"
                                                    Foreground="{ThemeResource AbAgent}"
                                                    Background="Transparent"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    Visibility="{x:Bind local:Ui.Show(Disclosure.IsDriven)}">
                                                    <ContentControl.RenderTransform>
                                                        <CompositeTransform CenterX="13.3" CenterY="13.3" ScaleX="1.7" ScaleY="1.7" TranslateX="-5.3" TranslateY="-5.3" />
                                                    </ContentControl.RenderTransform>
                                                </ContentControl>
                                            </Grid>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{StaticResource AbTypeMeta}"
                                                Foreground="{ThemeResource AbAgentText}"
                                                TextWrapping="Wrap"
                                                Text="{x:Bind Disclosure.Origin.Label}" />
                                            <ContentControl IsTabStop="False" VerticalAlignment="Center" Content="{x:Bind PromptBeside}" ContentTemplate="{StaticResource MessageTimeTemplate}" />
                                        </local:FlowPanel>
                                        <TextBlock
                                            Style="{StaticResource AbTypeRow}"
                                            Foreground="{ThemeResource AbText2}"
                                            TextWrapping="Wrap"
                                            MaxLines="2"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{x:Bind Disclosure.Origin.Preview}" />
                                        <local:DisclosureButton
                                            HorizontalAlignment="Left"
                                            MinHeight="32"
                                            Margin="-4,0,0,0"
                                            Padding="4,4"
                                            BorderThickness="0"
                                            Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                            Foreground="{ThemeResource AbText}"
                                            CornerRadius="{StaticResource AbRadiusControl}"
                                            AutomationProperties.Name="{x:Bind Disclosure.ToggleName, Mode=OneWay}"
                                            IsExpanded="{x:Bind Disclosure.Open, Mode=TwoWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <ContentControl
                                                    Style="{StaticResource AbIconChevron}"
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource AbText2}"
                                                    AutomationProperties.AccessibilityView="Raw" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource AbTypeMeta}"
                                                    Text="{x:Bind Disclosure.ToggleText, Mode=OneWay}" />
                                            </StackPanel>
                                        </local:DisclosureButton>
                                        <Border
                                            Margin="0,4,0,0"
                                            Padding="12,0,0,0"
                                            BorderBrush="{ThemeResource AbAgent}"
                                            BorderThickness="2,0,0,0"
                                            Visibility="{x:Bind local:Ui.Show(Disclosure.Open), Mode=OneWay}">
                                            <TextBlock
                                                Style="{StaticResource AbTypeReading}"
                                                TextWrapping="Wrap"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind Disclosure.Origin.Text}" />
                                        </Border>
                                    </StackPanel>
                                    <!-- The person's own prompt: a bubble at the right, at most 85% of the column, as the live one is (ui.md §6.4, #1735). -->
                                    <Grid Visibility="{x:Bind local:Ui.Some(Prompt)}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="15*" />
                                            <ColumnDefinition Width="85*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            x:Name="HistoryYourMessage"
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            Padding="16,10"
                                            Background="{ThemeResource AbCard}"
                                            BorderBrush="{ThemeResource AbStroke}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource AbRadiusCard}">
                                            <TextBlock Style="{StaticResource AbTypeRow}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Text="{x:Bind Prompt}" />
                                        </Border>
                                    </Grid>
                                    <ContentControl IsTabStop="False" HorizontalAlignment="Right" MinHeight="20" Content="{x:Bind PromptUnder}" ContentTemplate="{StaticResource MessageTimeTemplate}" Visibility="{x:Bind local:Ui.Some(Prompt)}" />
                                    <ContentControl IsTabStop="False" HorizontalAlignment="Left" Content="{x:Bind Reply}" ContentTemplate="{StaticResource MessageTimeTemplate}" />
                                    <ItemsRepeater ItemsSource="{x:Bind Blocks}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Vertical" Spacing="8" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="core:ConversationBlock">
                                                <local:MarkdownView Reading="True" Block="{x:Bind Block}" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <TextBlock Style="{StaticResource AbTypeMeta}" Foreground="{ThemeResource AbText2}" Text="{x:Bind Note}" Visibility="{x:Bind local:Ui.Some(Note)}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </local:ReadingColumn>
                <local:ReadingColumn
                    x:Name="Conversation"
                    MaxWidth="{StaticResource AbLayoutReadingMax}"
                    HorizontalAlignment="Center"
                    Padding="24,8,24,0"
                    Spacing="24">

                    <InfoBar
                        Title="Not sent"
                        Severity="Warning"
                        IsOpen="{x:Bind Card.HasOrphan, Mode=OneWay}"
                        Message="{x:Bind Card.OrphanNote, Mode=OneWay}"
                        Closed="OnOrphanClosed">
                        <StackPanel Spacing="8" Margin="0,0,0,8">
                            <TextBox IsReadOnly="True" TextWrapping="Wrap" Text="{x:Bind Card.OrphanText, Mode=OneWay}" />
                            <Button Content="Copy" Click="OnCopyOrphan" />
                        </StackPanel>
                    </InfoBar>

                    <!-- Words only (ui.md §6.5, "quiet unless something's wrong"): no ring or badge beside them. -->
                    <Grid Visibility="{x:Bind local:Ui.Show(Card.HasReceipt), Mode=OneWay}">
                        <!-- The room the longest outcome needs, drawn clear and unheard (QuestionViewModel.Room). -->
                        <TextBlock
                            Style="{StaticResource AbTypeRow}"
                            TextWrapping="Wrap"
                            Opacity="0"
                            IsHitTestVisible="False"
                            AutomationProperties.AccessibilityView="Raw"
                            Text="{x:Bind Card.ReceiptRoom, Mode=OneWay}" />
                        <TextBlock
                            x:Name="Receipt"
                            Style="{StaticResource AbTypeRow}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True"
                            AutomationProperties.AutomationId="Receipt"
                            AutomationProperties.LiveSetting="Polite"
                            local:ReceiptMarkView.Urgent="{x:Bind Card.ReceiptAnnouncementUrgent, Mode=OneWay}"
                            local:ReceiptMarkView.Announcement="{x:Bind Card.ReceiptAnnouncement, Mode=OneWay}"
                            Text="{x:Bind Card.ReceiptText, Mode=OneWay}"
                            local:ReceiptMarkView.Tone="{x:Bind Card.ReceiptTone, Mode=OneWay}"
                            Visibility="{x:Bind local:Ui.Show(Card.HasReceipt), Mode=OneWay}" />
                    </Grid>

                    <!-- A prompt you didn't type (#489, §6.4): never a bubble, and never at the right, which is
                         yours. At the column's start: a label line in agent colour (a clock for a schedule,
                         the driven diamond for an agent), read before the prompt; two lines of it, and Show
                         prompt, a compact disclosure (its Disclosure motion), opening on all of it inside a thin
                         agent rule on the leading edge, not a filled card. -->
                    <StackPanel
                        x:Name="PromptLine"
                        Spacing="4"
                        AutomationProperties.AutomationId="Prompt"
                        Visibility="{x:Bind local:Ui.Show(Card.HasPrompt), Mode=OneWay}">
                        <local:FlowPanel Spacing="8" LineSpacing="0" AutomationProperties.AutomationId="PromptLabel">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <ContentControl
                                    Style="{StaticResource AbIconClock}"
                                    Width="16"
                                    Height="16"
                                    Foreground="{ThemeResource AbAgent}"
                                    AutomationProperties.AutomationId="PromptClock"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Visibility="{x:Bind local:Ui.Show(Card.PromptIsSchedule), Mode=OneWay}" />
                                <!-- The driven-badge glyph's diamond on its own: its 16 grid scaled about the
                                     diamond and moved to the middle, as the PWA crops it. -->
                                <ContentControl
                                    Style="{StaticResource AbGlyphDrivenBadge}"
                                    Width="16"
                                    Height="16"
                                    Foreground="{ThemeResource AbAgent}"
                                    Background="Transparent"
                                    AutomationProperties.AutomationId="PromptDiamond"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Visibility="{x:Bind local:Ui.Show(Card.PromptIsDriven), Mode=OneWay}">
                                    <ContentControl.RenderTransform>
                                        <CompositeTransform CenterX="13.3" CenterY="13.3" ScaleX="1.7" ScaleY="1.7" TranslateX="-5.3" TranslateY="-5.3" />
                                    </ContentControl.RenderTransform>
                                </ContentControl>
                            </Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource AbTypeMeta}"
                                Foreground="{ThemeResource AbAgentText}"
                                TextWrapping="Wrap"
                                AutomationProperties.AutomationId="PromptLabelText"
                                Text="{x:Bind Card.PromptLabel, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource AbTypeMeta}"
                                Foreground="{ThemeResource AbText2}"
                                TextWrapping="Wrap"
                                AutomationProperties.AutomationId="PromptBy"
                                Text="{x:Bind Card.PromptBy, Mode=OneWay}"
                                Visibility="{x:Bind local:Ui.Show(Card.HasPromptBy), Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource AbTypeMeta}"
                                Foreground="{ThemeResource AbText2}"
                                AutomationProperties.AutomationId="PromptAge"
                                Text="{x:Bind Card.PromptAgeText, Mode=OneWay}"
                                Visibility="{x:Bind local:Ui.Show(Card.HasPromptAge), Mode=OneWay}" />
                        </local:FlowPanel>
                        <TextBlock
                            Style="{StaticResource AbTypeRow}"
                            Foreground="{ThemeResource AbText2}"
                            TextWrapping="Wrap"
                            MaxLines="2"
                            TextTrimming="CharacterEllipsis"
                            AutomationProperties.AutomationId="PromptPreview"
                            Text="{x:Bind Card.PromptPreview, Mode=OneWay}"
                            Visibility="{x:Bind local:Ui.Show(Card.HasPromptPreview), Mode=OneWay}" />
                        <!-- Show prompt: a compact disclosure, as the PWA's and as wide as its words; its chevron
                             leads them, pointing right shut and down open (Motion.Turn), and the words are at the
                             label's size. Open, all of it settles in (Disclosure) inside the agent rule. -->
                        <local:DisclosureButton
                            x:Name="PromptToggle"
                            HorizontalAlignment="Left"
                            MinHeight="32"
                            Margin="-4,0,0,0"
                            Padding="4,4"
                            BorderThickness="0"
                            Background="{ThemeResource SubtleFillColorTransparentBrush}"
                            Foreground="{ThemeResource AbText}"
                            CornerRadius="{StaticResource AbRadiusControl}"
                            AutomationProperties.AutomationId="ShowPrompt"
                            AutomationProperties.Name="{x:Bind Card.PromptToggleName, Mode=OneWay}"
                            IsExpanded="{x:Bind Card.PromptOpen, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ContentControl
                                    x:Name="PromptChevron"
                                    Style="{StaticResource AbIconChevron}"
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource AbText2}"
                                    AutomationProperties.AutomationId="PromptChevron"
                                    AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource AbTypeMeta}"
                                    AutomationProperties.AutomationId="PromptToggleText"
                                    Text="{x:Bind Card.PromptToggleText, Mode=OneWay}" />
                            </StackPanel>
                        </local:DisclosureButton>
                        <Border
                            x:Name="PromptRule"
                            Margin="0,4,0,0"
                            Padding="12,0,0,0"
                            BorderBrush="{ThemeResource AbAgent}"
                            BorderThickness="2,0,0,0"
                            AutomationProperties.AutomationId="PromptRule"
                            Visibility="{x:Bind local:Ui.Show(Card.PromptOpen), Mode=OneWay}">
                            <TextBlock
                                Style="{StaticResource AbTypeReading}"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True"
                                AutomationProperties.AutomationId="PromptText"
                                Text="{x:Bind Card.PromptText, Mode=OneWay}" />
                        </Border>
                    </StackPanel>

                    <!-- Your message: a bubble at the column's right, at most 85% of it, as in the PWA. -->
                    <Grid Visibility="{x:Bind local:Ui.Show(Card.UserMessageAbove), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="15*" />
                            <ColumnDefinition Width="85*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="YourMessage"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Padding="16,10"
                            Background="{ThemeResource AbCard}"
                            BorderBrush="{ThemeResource AbStroke}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AbRadiusCard}"
                            AutomationProperties.AutomationId="YourMessage">
                            <TextBlock Style="{StaticResource AbTypeReading}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Text="{x:Bind Card.UserMessage, Mode=OneWay}" />
                        </Border>
                    </Grid>

                    <!-- The main agent: a label line ("Main agent" only where the host says whose the words are, else the agent's name), then its words, the list's items; its reasoning behind a disclosure. -->
                    <StackPanel Spacing="8" AutomationProperties.AutomationId="Response" Visibility="{x:Bind local:Ui.Show(Card.HasVoice), Mode=OneWay}">
                        <TextBlock Style="{StaticResource AbTypeMeta}" Foreground="{ThemeResource AbText2}">
                            <Run Text="{x:Bind Card.Speaker, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource AbText}" /><Run Text="  " /><Run Text="{x:Bind Card.ResponseAgeText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock
                            Style="{StaticResource AbTypeMeta}"
                            Foreground="{ThemeResource AbText2}"
                            TextWrapping="Wrap"
                            Text="Earlier text not shown: the response was longer than the machine sends."
                            Visibility="{x:Bind local:Ui.Show(Card.ResponseTruncated), Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource AbTypeMeta}"
                            Foreground="{ThemeResource AbText2}"
                            TextWrapping="Wrap"
                            AutomationProperties.AutomationId="ResponseDropped"
                            Text="The main agent's latest response was left out: too long to send with its delegates."
                            Visibility="{x:Bind local:Ui.Show(Card.ResponseDropped), Mode=OneWay}" />
                    </StackPanel>
                </local:ReadingColumn>
                </local:ReadingColumn>
                </ListView.Header>
                <ListView.Footer>
                <local:ReadingColumn x:Name="ConversationFooter">
                <local:ReadingColumn
                    MaxWidth="{StaticResource AbLayoutReadingMax}"
                    HorizontalAlignment="Center"
                    Padding="24,0,24,24"
                    Spacing="24">
                    <!-- Holds the column's spacing above what follows the response, as a child of one
                         column did; 8 more where the response has no blocks, as its empty view had. -->
                    <Border x:Name="FooterLead" Height="0" />
                    <Expander
                        Header="Show reasoning"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="Reasoning"
                        Visibility="{x:Bind local:Ui.Show(Card.HasReasoning), Mode=OneWay}">
                        <TextBlock Style="{StaticResource AbTypeRow}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Text="{x:Bind Card.Reasoning, Mode=OneWay}" />
                    </Expander>

                    <!-- A question, in the stream, in Needs you colours (§6.4), where it was asked: after
                         the reply it follows, with what came after it (delegates, the tool) below it
                         (#1657). It sat in the header, above the user's message and the reply. -->
                    <Border
                        x:Name="QuestionCard"
                        Background="{ThemeResource AbNeedsFill}"
                        CornerRadius="{StaticResource AbRadiusCard}"
                        Visibility="Collapsed">
                        <ContentControl x:Name="QuestionHost" HorizontalContentAlignment="Stretch" IsTabStop="False" />
                    </Border>

                    <!-- Delegates starting and reporting back (§6.4): one meta line each, with an icon,
                         the name linking to the delegate. The main agent's own delegates only. -->
                    <StackPanel Spacing="4" Visibility="{x:Bind local:Ui.Show(Card.Delegates.HasEvents), Mode=OneWay, FallbackValue=Collapsed}">
                    <!-- Two or more lines fold into one row (§6.4, Runs fold; #1063), as the PWA's: its
                         button, the chevron ending it inside its target and focus ring and turning as
                         it opens, then the "still working" link after a 12 gap as a target of its own,
                         wrapping under the words on a narrow pane. Closed until opened, and as it was
                         left for as long as the session's card lives. -->
                    <local:FlowPanel
                        x:Name="EventsFold"
                        Spacing="12"
                        LineSpacing="0"
                        AutomationProperties.AutomationId="DelegateFoldRow"
                        Visibility="{x:Bind local:Ui.Show(Card.Delegates.HasFold), Mode=OneWay, FallbackValue=Collapsed}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentControl VerticalAlignment="Center" Style="{StaticResource AbIconDelegate}" Width="16" Height="16" Foreground="{ThemeResource AbText2}" IsTabStop="False" AutomationProperties.AccessibilityView="Raw" />
                            <local:DisclosureButton
                                x:Name="EventsToggle"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                MinHeight="32"
                                Padding="0,4"
                                BorderThickness="0"
                                Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                Foreground="{ThemeResource AbText2}"
                                CornerRadius="{StaticResource AbRadiusControl}"
                                AutomationProperties.AutomationId="DelegateFold"
                                AutomationProperties.Name="{x:Bind Card.Delegates.FoldName, Mode=OneWay}"
                                IsExpanded="{x:Bind Card.Delegates.EventsOpen, Mode=TwoWay}">
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                        Style="{StaticResource AbTypeMeta}"
                                        AutomationProperties.AutomationId="DelegateFoldText"
                                        Text="{x:Bind Card.Delegates.FoldText, Mode=OneWay}" />
                                    <ContentControl
                                        x:Name="EventsChevron"
                                        AutomationProperties.AutomationId="EventsChevron"
                                        Grid.Column="1"
                                        Style="{StaticResource AbIconChevron}"
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource AbText2}"
                                        AutomationProperties.AccessibilityView="Raw" />
                                </Grid>
                            </local:DisclosureButton>
                        </Grid>
                        <HyperlinkButton
                            x:Name="EventsWorking"
                            VerticalAlignment="Center"
                            Padding="0"
                            MinHeight="32"
                            FontSize="12"
                            Tag="{x:Bind Card.Delegates.FoldWorkingId, Mode=OneWay}"
                            AutomationProperties.AutomationId="DelegateFoldWorking"
                            AutomationProperties.Name="{x:Bind Card.Delegates.FoldLinkName, Mode=OneWay}"
                            ToolTipService.ToolTip="Show this delegate"
                            Visibility="{x:Bind local:Ui.Show(Card.Delegates.HasFoldLink), Mode=OneWay, FallbackValue=Collapsed}"
                            Click="OnDelegateEvent">
                            <TextBlock Text="{x:Bind Card.Delegates.FoldLink, Mode=OneWay}" TextWrapping="Wrap" />
                        </HyperlinkButton>
                    </local:FlowPanel>
                    <Border
                        x:Name="EventsRule"
                        AutomationProperties.AutomationId="EventsRule"
                        Margin="{x:Bind local:SessionView.RuleMargin(Card.Delegates.HasFold), Mode=OneWay}"
                        Padding="{x:Bind local:SessionView.RulePadding(Card.Delegates.HasFold), Mode=OneWay}"
                        BorderBrush="{ThemeResource AbStroke2}"
                        BorderThickness="{x:Bind local:SessionView.RuleThickness(Card.Delegates.HasFold), Mode=OneWay}"
                        Visibility="{x:Bind local:Ui.Show(Card.Delegates.ShowLines), Mode=OneWay, FallbackValue=Collapsed}">
                    <ItemsControl
                        IsTabStop="False"
                        AutomationProperties.AutomationId="DelegateEvents"
                        ItemsSource="{x:Bind Card.Delegates.Events, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:DelegateEvent">
                                <!-- A flowing line, not a horizontal StackPanel: that measured a long name at full
                                     width and the one-column pane clipped the outcome and age after it. The name
                                     trims to the line; "reported back · 22m" moves to the next line. -->
                                <local:FlowPanel Spacing="4" LineSpacing="0">
                                    <ContentControl Margin="0,0,4,0" VerticalAlignment="Center" Style="{StaticResource AbIconDelegate}" Width="12" Height="12" Foreground="{ThemeResource AbText2}" IsTabStop="False" Visibility="{x:Bind local:Ui.Show(Started), Mode=OneWay}" />
                                    <local:StatusGlyphView Margin="0,0,4,0" VerticalAlignment="Center" Size="12" Glyph="{x:Bind GlyphShown, Mode=OneWay}" Visibility="{x:Bind local:Ui.Show(HasGlyph), Mode=OneWay}" />
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource AbTypeMeta}" Foreground="{ThemeResource AbText2}" Text="{x:Bind Before, Mode=OneWay}" Visibility="{x:Bind local:Ui.Some(Before), Mode=OneWay}" />
                                    <HyperlinkButton
                                        VerticalAlignment="Center"
                                        Padding="0"
                                        MinHeight="0"
                                        FontSize="12"
                                        Tag="{x:Bind AgentId, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind Text, Mode=OneWay}"
                                        ToolTipService.ToolTip="Show this delegate"
                                        Visibility="{x:Bind local:Ui.Show(HasName), Mode=OneWay}"
                                        Click="OnDelegateEvent">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </HyperlinkButton>
                                    <TextBlock VerticalAlignment="Center" Margin="{x:Bind local:SessionView.AgeMargin(After), Mode=OneWay}" Style="{StaticResource AbTypeMeta}" Foreground="{ThemeResource AbText2}" Text="{x:Bind After, Mode=OneWay}" Visibility="{x:Bind local:Ui.Some(After), Mode=OneWay}" />
                                </local:FlowPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Border>
                    </StackPanel>

                    <!-- What it is doing now: the tool glyph, then the call in inline mono on a meta line, one weight (ui.md §4.2, #215). -->
                    <Grid ColumnSpacing="8" Visibility="{x:Bind local:Ui.Show(Card.HasTool), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:StatusGlyphView Margin="0,2,0,0" VerticalAlignment="Top" Size="12" Glyph="{x:Bind Card.ToolGlyph, Mode=OneWay}" Label="{x:Bind Card.ToolState, Mode=OneWay}" AutomationProperties.AutomationId="ToolGlyph" />
                        <TextBlock Grid.Column="1" Style="{StaticResource InlineMonoMeta}" Foreground="{ThemeResource AbText2}" TextWrapping="Wrap" AutomationProperties.AutomationId="CurrentTool">
                            <Run Text="{x:Bind Card.ToolName, Mode=OneWay}" Foreground="{ThemeResource AbText}" /><Run Text=" " /><Run Text="{x:Bind Card.ToolSummary, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>

                    <!-- Your message sent mid-turn: below the words still being written, until the agent answers it (#1613). -->
                    <Grid Visibility="{x:Bind local:Ui.Show(Card.UserMessageBelow), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="15*" />
                            <ColumnDefinition Width="85*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="YourMessageBelow"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Padding="16,10"
                            Background="{ThemeResource AbCard}"
                            BorderBrush="{ThemeResource AbStroke}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AbRadiusCard}"
                            AutomationProperties.AutomationId="YourMessageBelow">
                            <TextBlock Style="{StaticResource AbTypeReading}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Text="{x:Bind Card.UserMessage, Mode=OneWay}" />
                        </Border>
                    </Grid>
                </local:ReadingColumn>
                </local:ReadingColumn>
                </ListView.Footer>
            </ListView>

            <!-- The Delegates tab (§6.3, §5.2): every delegate, nested under its parent, and one opened
                 from it pushed in its place; a host that can't list them (rule 8), its counts. -->
            <Grid AutomationProperties.AutomationId="DelegatesPanel" Visibility="{x:Bind local:Ui.Show(Layout.ShowDelegates), Mode=OneWay}">
                <StackPanel Padding="24,8,24,24" Spacing="8" Visibility="{x:Bind local:Ui.Show(Layout.ShowDelegateCounts), Mode=OneWay, FallbackValue=Collapsed}">
                    <TextBlock Style="{StaticResource AbTypeRow}" TextWrapping="Wrap" AutomationProperties.AutomationId="DelegatesText" Text="{x:Bind Card.DelegatesText, Mode=OneWay}" />
                </StackPanel>
                <ScrollViewer AutomationProperties.AutomationId="DelegateList" Visibility="{x:Bind local:Ui.Show(Layout.ShowDelegateList), Mode=OneWay, FallbackValue=Collapsed}">
                    <local:ReadingColumn Padding="12,8,12,24" Spacing="8" MaxWidth="{StaticResource AbLayoutReadingMax}" HorizontalAlignment="Left">
                        <ListView
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="OnDelegateRow"
                            AutomationProperties.Name="Delegates"
                            ItemTemplate="{StaticResource DelegateRowTemplate}"
                            ItemsSource="{x:Bind Card.Delegates.Active, Mode=OneWay}"
                            Visibility="{x:Bind local:Ui.Show(Card.Delegates.HasActive), Mode=OneWay, FallbackValue=Collapsed}" />
                        <Expander
                            Margin="12,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="DelegatesFinished"
                            Header="{x:Bind Card.Delegates.FinishedText, Mode=OneWay}"
                            IsExpanded="{x:Bind Card.Delegates.FinishedOpen, Mode=TwoWay}"
                            Visibility="{x:Bind local:Ui.Show(Card.Delegates.HasFinished), Mode=OneWay, FallbackValue=Collapsed}">
                            <ListView
                                Margin="-12,0"
                                SelectionMode="None"
                                IsItemClickEnabled="True"
                                ItemClick="OnDelegateRow"
                                AutomationProperties.Name="Finished delegates"
                                ItemTemplate="{StaticResource DelegateRowTemplate}"
                                ItemsSource="{x:Bind Card.Delegates.Finished, Mode=OneWay}" />
                        </Expander>
                        <TextBlock
                            Margin="12,0"
                            Style="{StaticResource AbTypeMeta}"
                            Foreground="{ThemeResource AbText2}"
                            Text="{x:Bind Card.Delegates.MoreText, Mode=OneWay}"
                            Visibility="{x:Bind local:Ui.Show(Card.Delegates.HasMore), Mode=OneWay, FallbackValue=Collapsed}" />
                    </local:ReadingColumn>
                </ScrollViewer>
                <ScrollViewer AutomationProperties.AutomationId="DelegateDetail" Visibility="{x:Bind local:Ui.Show(Layout.ShowDelegateDetail), Mode=OneWay, FallbackValue=Collapsed}">
                    <local:ReadingColumn Margin="24,8,24,24" MaxWidth="{StaticResource AbLayoutReadingMax}" HorizontalAlignment="Left">
                        <local:DelegateInspector x:Name="TabDelegate" Card="{x:Bind Card, Mode=OneWay}" />
                    </local:ReadingColumn>
                </ScrollViewer>
            </Grid>

            <ScrollViewer AutomationProperties.AutomationId="ToolsPanel" Visibility="{x:Bind local:Ui.Show(Layout.ShowTools), Mode=OneWay}">
                <local:ToolList x:Name="ToolsTabList" Padding="24,8,24,24" />
            </ScrollViewer>
        </Grid>

        <!-- The reply box (§6.5): a card with a 2 px Bridge bottom edge, Attach, and Send. Replies only
             ever go to the main agent. -->
        <!-- Never more than half the pane (FitComposer): at 360×600 a long draft, attachments and
             the notes under them otherwise took every line from the conversation and its question. -->
        <!-- Over the reply box while an open question is out of view (QuestionBar): one click or
             Enter on it brings the card into view. Never over the conversation. -->
        <Button
            x:Name="QuestionWaiting"
            Grid.Row="3"
            HorizontalAlignment="Center"
            Margin="24,0,24,8"
            Content="Question waiting"
            Background="{ThemeResource AbNeedsFill}"
            Foreground="{ThemeResource AbNeedsText}"
            AutomationProperties.AutomationId="QuestionBar"
            AutomationProperties.Name="Question waiting. Go to the question"
            Visibility="Collapsed"
            Click="OnQuestionBar" />

        <ScrollViewer
            x:Name="Composer"
            Grid.Row="4"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind local:Ui.Some(Card.Reply), Mode=OneWay}">
            <local:ReadingColumn
                Padding="24,0,24,20"
                Spacing="6"
                MaxWidth="{StaticResource AbLayoutReadingMax}"
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="ReplyBox">
                <TextBlock
                    Style="{StaticResource AbTypeMeta}"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource AbNeedsText}"
                    Text="{x:Bind Card.Reply.HeldText, Mode=OneWay}"
                    Visibility="{x:Bind local:Ui.Some(Card.Reply.HeldText), Mode=OneWay, FallbackValue=Collapsed}" />
                <Border
                    Background="{ThemeResource AbCard}"
                    BorderBrush="{ThemeResource AbBridge}"
                    BorderThickness="0,0,0,2"
                    CornerRadius="{StaticResource AbRadiusCard}"
                    Padding="4,4,8,8">
                    <Border.Resources>
                        <!-- The card is the field: the box inside has no fill or edge of its own. -->
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    </Border.Resources>
                    <StackPanel Spacing="4">
                        <TextBox
                            x:Name="ReplyBox"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="40"
                            MaxHeight="240"
                            PlaceholderText="Message the main agent"
                            AutomationProperties.AutomationId="ReplyText"
                            AutomationProperties.Name="Message the main agent"
                            IsEnabled="{x:Bind local:Ui.Not(Card.Reply.Held), Mode=OneWay, FallbackValue=False}"
                            Text="{x:Bind Card.Reply.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            GotFocus="OnEditing"
                            LostFocus="OnNotEditing"
                            Paste="OnPaste"
                            PreviewKeyDown="OnReplyKey" />
                        <!-- Many files scroll here, so the box and Send stay in a short window. -->
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind Card.Reply.Attachments, Mode=OneWay}" IsTabStop="False" Margin="8,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:ReplyAttachment">
                                        <!-- The name gives way, cut short with the whole of it in its tooltip, so Remove
                                             stays in the box at the narrowest window. -->
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource InlineMonoMeta}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{x:Bind Name}" Text="{x:Bind Name}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource AbTypeMeta}" Foreground="{ThemeResource AbText2}" Text="{x:Bind SizeText}" />
                                            <Button Grid.Column="2" Content="Remove" MinHeight="32" Padding="8,2" Click="OnRemoveAttachment" Tag="{x:Bind}" AutomationProperties.Name="{x:Bind local:SessionView.RemoveName(Name)}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource AbTypeMeta}" Foreground="{ThemeResource AbText2}" Text="{x:Bind Card.Reply.BytesText, Mode=OneWay}" />
                            <Button
                                Grid.Column="1"
                                Content="Send again"
                                MinHeight="32"
                                Visibility="{x:Bind local:Ui.Show(Card.Reply.ShowResend), Mode=OneWay, FallbackValue=Collapsed}"
                                Click="OnResendReply" />
                            <Button
                                Grid.Column="2"
                                Style="{StaticResource AbIconButton}"
                                AutomationProperties.AutomationId="Attach"
                                AutomationProperties.Name="Attach files"
                                ToolTipService.ToolTip="Attach files"
                                Visibility="{x:Bind local:Ui.Show(Card.Reply.ShowAttach), Mode=OneWay, FallbackValue=Collapsed}"
                                IsEnabled="{x:Bind Card.Reply.CanAttach, Mode=OneWay, FallbackValue=False}"
                                Click="OnAttach">
                                <ContentControl Style="{StaticResource AbIconAttach}" Width="16" Height="16" />
                            </Button>
                            <Button
                                Grid.Column="3"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.AutomationId="SendReply"
                                AutomationProperties.Name="Send"
                                ToolTipService.ToolTip="Send (Ctrl+Enter)"
                                IsEnabled="{x:Bind Card.Reply.SendEnabled, Mode=OneWay, FallbackValue=False}"
                                Click="OnSendReply">
                                <!-- Send says how its reply goes (ui.md §5.3, §6.5): the platform's ring in place of
                                     the arrow while it is on its way (standing still while it waits for the machine),
                                     then the check for about a second once delivered, then the arrow again. Only the
                                     glyph cross-fades; the button keeps its size and colour. -->
                                <Grid>
                                    <ContentControl Style="{StaticResource AbIconSend}" Width="16" Height="16" Opacity="{x:Bind local:Ui.Fade(Card.Reply.SendRest), Mode=OneWay, FallbackValue=1}">
                                        <ContentControl.OpacityTransition><ScalarTransition Duration="0:0:0.15" /></ContentControl.OpacityTransition>
                                    </ContentControl>
                                    <local:InFlightRing AutomationProperties.AutomationId="SendRing" Active="{x:Bind Card.Reply.Pending, Mode=OneWay, FallbackValue=False}" Still="{x:Bind Card.Reply.SendStill, Mode=OneWay, FallbackValue=False}" />
                                    <local:CheckGlyph AutomationProperties.AutomationId="SendCheck" Opacity="{x:Bind local:Ui.Fade(Card.Reply.SendCheck), Mode=OneWay, FallbackValue=0}">
                                        <local:CheckGlyph.OpacityTransition><ScalarTransition Duration="0:0:0.15" /></local:CheckGlyph.OpacityTransition>
                                    </local:CheckGlyph>
                                </Grid>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock
                    Style="{StaticResource AbTypeMeta}"
                    Foreground="{ThemeResource AbText2}"
                    TextWrapping="Wrap"
                    Text="Line breaks go to the session as spaces: it takes a reply as one line."
                    Visibility="{x:Bind local:Ui.Show(Card.Reply.LineBreakHint), Mode=OneWay, FallbackValue=Collapsed}" />
                <TextBlock
                    Style="{StaticResource AbTypeMeta}"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource AbDangerText}"
                    Text="{x:Bind Card.Reply.Error, Mode=OneWay}"
                    Visibility="{x:Bind local:Ui.Show(Card.Reply.HasError), Mode=OneWay, FallbackValue=Collapsed}" />
                <!-- The receipt (ui.md §6.5, #600, #617): words only, and only for an exception (a stall,
                     a wait, an outcome other than Delivered), in room kept from Send until the box is
                     next typed in; a polite live region, which hears every stage. -->
                <Grid Visibility="{x:Bind local:Ui.Show(Card.Reply.ShowStatus), Mode=OneWay, FallbackValue=Collapsed}">
                    <!-- The room the longest outcome needs, drawn clear and unheard (ReceiptWords.Room). -->
                    <TextBlock
                        Style="{StaticResource AbTypeMeta}"
                        TextWrapping="Wrap"
                        Opacity="0"
                        IsHitTestVisible="False"
                        AutomationProperties.AccessibilityView="Raw"
                        Text="{x:Bind Card.Reply.StatusRoom, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource AbTypeMeta}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        AutomationProperties.AutomationId="ReplyStatus"
                        AutomationProperties.LiveSetting="Polite"
                        local:ReceiptMarkView.Urgent="{x:Bind Card.Reply.AnnouncementUrgent, Mode=OneWay}"
                        local:ReceiptMarkView.Announcement="{x:Bind Card.Reply.Announcement, Mode=OneWay}"
                        Text="{x:Bind Card.Reply.StatusText, Mode=OneWay}"
                        local:ReceiptMarkView.Tone="{x:Bind Card.Reply.StatusTone, Mode=OneWay}" />
                </Grid>
            </local:ReadingColumn>
        </ScrollViewer>
    </Grid>
</UserControl>