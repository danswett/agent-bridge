<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AgentBridge.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentBridge.App"
    xmlns:core="using:AgentBridge.App.Core"
    Title="Agent Bridge">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView
            x:Name="Nav"
            PaneDisplayMode="Top"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="OnNavigate">
            <NavigationView.MenuItems>
                <!-- The design's icons (design/icons) beside the words: they are stroked shapes, which an
                     IconElement can't draw, so they are the item's content rather than its Icon. -->
                <NavigationViewItem x:Name="SessionsItem" Tag="sessions" AutomationProperties.AutomationId="NavSessions" AutomationProperties.Name="Sessions">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ContentControl Style="{StaticResource AbIconSessions}" AutomationProperties.AutomationId="NavIcon" VerticalAlignment="Center" />
                        <TextBlock Text="Sessions" VerticalAlignment="Center" />
                    </StackPanel>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            Value="{x:Bind ViewModel.Waiting, Mode=OneWay}"
                            Visibility="{x:Bind local:Ui.Count(ViewModel.Waiting), Mode=OneWay}"
                            Background="{ThemeResource AbNeeds}"
                            Foreground="{ThemeResource AbNeedsInk}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="LaunchItem" Tag="launch" AutomationProperties.AutomationId="NavLaunch" AutomationProperties.Name="Launch"
                    Visibility="{x:Bind local:Ui.Show(Launch.Available), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ContentControl Style="{StaticResource AbIconLaunch}" AutomationProperties.AutomationId="NavIcon" VerticalAlignment="Center" />
                        <TextBlock Text="Launch" VerticalAlignment="Center" />
                    </StackPanel>
                </NavigationViewItem>
                <NavigationViewItem Tag="usage" AutomationProperties.AutomationId="NavUsage" AutomationProperties.Name="Usage">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ContentControl Style="{StaticResource AbIconUsage}" AutomationProperties.AutomationId="NavIcon" VerticalAlignment="Center" />
                        <TextBlock Text="Usage" VerticalAlignment="Center" />
                    </StackPanel>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="settings" AutomationProperties.AutomationId="NavSettings" AutomationProperties.Name="Settings">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ContentControl Style="{StaticResource AbIconSettings}" AutomationProperties.AutomationId="NavIcon" VerticalAlignment="Center" />
                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <InfoBar
                        Margin="16,8,16,0"
                        AutomationProperties.AutomationId="Banner"
                        IsClosable="False"
                        Severity="Warning"
                        IsOpen="{x:Bind ViewModel.HasBanner, Mode=OneWay}"
                        Message="{x:Bind ViewModel.Banner, Mode=OneWay}" />
                    <InfoBar
                        Margin="16,8,16,0"
                        AutomationProperties.AutomationId="DiscoveryHeld"
                        IsClosable="False"
                        Severity="Informational"
                        IsOpen="{x:Bind ViewModel.IsHeld, Mode=OneWay}"
                        Message="{x:Bind ViewModel.HeldWhy, Mode=OneWay}" />
                </StackPanel>

                <ScrollViewer x:Name="SessionsPane" Grid.Row="1" AutomationProperties.AutomationId="SessionsPane">
                    <!-- In a Grid: a ScrollViewer centres a narrower child by its desired width, which pushed
                         the column off the right edge (see LaunchView). -->
                    <Grid>
                        <StackPanel MaxWidth="920" Padding="16,12,16,24" Spacing="12">
                            <ComboBox
                                x:Name="MachinePicker"
                                AutomationProperties.AutomationId="MachinePicker"
                                AutomationProperties.Name="Show sessions from"
                                Header="Machines"
                                MinWidth="260"
                                ItemsSource="{x:Bind ViewModel.Machines}"
                                SelectedItem="{x:Bind ViewModel.SelectedMachine, Mode=OneWay}"
                                SelectionChanged="OnMachineChosen"
                                Visibility="{x:Bind local:Ui.Show(ViewModel.ShowMachines), Mode=OneWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:MachineChoice">
                                        <TextBlock Text="{x:Bind Label, Mode=OneWay}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <!-- Your order, Most recent or Machine (#164). -->
                            <ComboBox
                                x:Name="SortPicker"
                                AutomationProperties.AutomationId="SortPicker"
                                AutomationProperties.Name="Sort sessions"
                                Header="Sort"
                                MinWidth="160"
                                ItemsSource="{x:Bind core:MainViewModel.SortChoices}"
                                SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" />
                            <InfoBar
                                AutomationProperties.AutomationId="FleetNote"
                                IsClosable="False"
                                Severity="Informational"
                                IsOpen="{x:Bind ViewModel.HasFleetNote, Mode=OneWay}"
                                Message="{x:Bind ViewModel.FleetNote, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource AbSecondaryText}"
                                AutomationProperties.AutomationId="EmptyText"
                                TextWrapping="Wrap"
                                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                                Visibility="{x:Bind local:Ui.Show(ViewModel.Empty), Mode=OneWay}" />
                            <!-- Needs you · N (#165): every pending question on every machine, oldest first. It
                                 refers to the cards below and never moves them. -->
                            <Border
                                AutomationProperties.AutomationId="NeedsYou"
                                AutomationProperties.Name="{x:Bind ViewModel.NeedsYouHeader, Mode=OneWay}"
                                Visibility="{x:Bind local:Ui.Show(ViewModel.HasNeedsYou), Mode=OneWay}"
                                Background="{ThemeResource AbNeedsFill}"
                                BorderBrush="{ThemeResource AbNeeds}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AbNeedsHead}"
                                        Text="{x:Bind ViewModel.NeedsYouHeader, Mode=OneWay}" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.NeedsYou}" IsTabStop="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="10" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="core:NeedsYouEntry">
                                                <Grid ColumnSpacing="8" AutomationProperties.AutomationId="NeedsYouEntry">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- A plain mark until the status glyphs (#178). -->
                                                    <Ellipse Width="10" Height="10" Margin="0,11,0,0" VerticalAlignment="Top" Fill="{ThemeResource AbNeeds}" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <HyperlinkButton
                                                            Padding="0"
                                                            MinHeight="32"
                                                            AutomationProperties.AutomationId="NeedsYouOpen"
                                                            AutomationProperties.Name="{x:Bind OpenName, Mode=OneWay}"
                                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                            Click="{x:Bind Open}">
                                                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{x:Bind Title, Mode=OneWay}" />
                                                        </HyperlinkButton>
                                                        <TextBlock
                                                            TextWrapping="Wrap"
                                                            Text="{x:Bind Line}"
                                                            Visibility="{x:Bind local:Ui.Show(ShowLine)}" />
                                                        <!-- An approval answered here shows its prompt whole: everything Approve once allows. -->
                                                        <local:MarkdownView
                                                            AutomationProperties.AutomationId="NeedsYouPrompt"
                                                            WrapCode="True"
                                                            Markdown="{x:Bind Prompt}"
                                                            Visibility="{x:Bind local:Ui.Show(HasPrompt)}" />
                                                        <TextBlock Style="{StaticResource AbSecondaryText}" FontSize="12" Text="{x:Bind Meta, Mode=OneWay}" />
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource AbNeedsText}"
                                                            Text="Answer at the machine"
                                                            Visibility="{x:Bind local:Ui.Show(AtMachine)}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0" Visibility="{x:Bind local:Ui.Show(Approvable)}">
                                                            <Button
                                                                MinHeight="32"
                                                                Style="{StaticResource AccentButtonStyle}"
                                                                AutomationProperties.AutomationId="NeedsYouApprove"
                                                                AutomationProperties.Name="{x:Bind ApproveName, Mode=OneWay}"
                                                                Content="{x:Bind ApproveLabel, Mode=OneWay}"
                                                                IsEnabled="{x:Bind CanAnswer, Mode=OneWay}"
                                                                Click="{x:Bind Approve}" />
                                                            <Button
                                                                MinHeight="32"
                                                                AutomationProperties.AutomationId="NeedsYouDeny"
                                                                AutomationProperties.Name="{x:Bind DenyName, Mode=OneWay}"
                                                                Content="{x:Bind DenyLabel, Mode=OneWay}"
                                                                IsEnabled="{x:Bind CanAnswer, Mode=OneWay}"
                                                                Click="{x:Bind Deny}" />
                                                            <!-- The machine failed the op: the same request again, as the card's Send again. -->
                                                            <Button
                                                                MinHeight="32"
                                                                AutomationProperties.AutomationId="NeedsYouResend"
                                                                Content="Send again"
                                                                Visibility="{x:Bind local:Ui.Show(ShowResend), Mode=OneWay}"
                                                                Click="{x:Bind Resend}" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            TextWrapping="Wrap"
                                                            IsTextSelectionEnabled="True"
                                                            Text="{x:Bind StatusText, Mode=OneWay}"
                                                            Foreground="{x:Bind local:Ui.ToneBrush(StatusTone), Mode=OneWay}"
                                                            Visibility="{x:Bind local:Ui.Show(HasStatus), Mode=OneWay}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="Cards" ItemsSource="{x:Bind ViewModel.Sessions}" IsTabStop="False" AutomationProperties.AutomationId="Cards">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="14" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:SessionCardViewModel">
                                        <local:SessionCard Card="{x:Bind}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Ended · N, folded: sessions a host removed while the app was running (#164). -->
                            <Expander
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.AutomationId="Ended"
                                Header="{x:Bind ViewModel.EndedHeader, Mode=OneWay}"
                                Visibility="{x:Bind local:Ui.Show(ViewModel.HasEnded), Mode=OneWay}">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Ended}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="core:EndedRow">
                                            <StackPanel Padding="0,4">
                                                <TextBlock TextWrapping="Wrap" Text="{x:Bind Title}" />
                                                <TextBlock Style="{StaticResource AbSecondaryText}" FontSize="12" Text="{x:Bind Meta}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <!-- The account's other machines' updates, each with Check and Install, and Check
                                 all, which checks this machine too (#51). -->
                            <StackPanel
                                Spacing="6"
                                AutomationProperties.AutomationId="MachineUpdates"
                                Visibility="{x:Bind local:Ui.Show(ViewModel.ShowMachineUpdates), Mode=OneWay}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource AbSecondaryText}" VerticalAlignment="Center" Text="Updates on your other machines" />
                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="CheckAllUpdates"
                                        AutomationProperties.Name="Check every machine for updates, this one included"
                                        Content="Check all"
                                        IsEnabled="{x:Bind ViewModel.CanCheckAll, Mode=OneWay}"
                                        Click="{x:Bind ViewModel.CheckAll}" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.MachineUpdates}" IsTabStop="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="core:MachineUpdateViewModel">
                                            <Grid ColumnSpacing="8" AutomationProperties.AutomationId="MachineUpdate">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource AbSecondaryText}" TextWrapping="Wrap" Text="{x:Bind StatusText, Mode=OneWay}" />
                                                    <TextBlock
                                                        Style="{StaticResource AbSecondaryText}"
                                                        TextWrapping="Wrap"
                                                        Text="{x:Bind LastText, Mode=OneWay}"
                                                        Visibility="{x:Bind local:Ui.Show(HasLast), Mode=OneWay}" />
                                                    <TextBlock
                                                        Style="{StaticResource AbSecondaryText}"
                                                        TextWrapping="Wrap"
                                                        Text="{x:Bind Note, Mode=OneWay}"
                                                        Visibility="{x:Bind local:Ui.Show(HasNote), Mode=OneWay}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="CheckMachineUpdate"
                                                    AutomationProperties.Name="{x:Bind CheckName, Mode=OneWay}"
                                                    Content="Check"
                                                    IsEnabled="{x:Bind CanCheck, Mode=OneWay}"
                                                    Click="{x:Bind Check}" />
                                                <Button
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="InstallMachineUpdate"
                                                    AutomationProperties.Name="{x:Bind InstallName, Mode=OneWay}"
                                                    Content="Install"
                                                    IsEnabled="{x:Bind CanInstall, Mode=OneWay}"
                                                    Click="{x:Bind Install}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <!-- The account's machines that are offline, from the relay's roster, each with a
                                 two-press Forget (#50). -->
                            <StackPanel
                                Spacing="6"
                                AutomationProperties.AutomationId="OfflineMachines"
                                Visibility="{x:Bind local:Ui.Show(ViewModel.ShowOfflineMachines), Mode=OneWay}">
                                <TextBlock Style="{StaticResource AbSecondaryText}" Text="Offline machines" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.OfflineMachines}" IsTabStop="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="core:OfflineMachineViewModel">
                                            <Grid ColumnSpacing="12" AutomationProperties.AutomationId="OfflineMachine">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource AbSecondaryText}" Text="{x:Bind LastSeenText, Mode=OneWay}" />
                                                    <TextBlock
                                                        Style="{StaticResource AbSecondaryText}"
                                                        TextWrapping="Wrap"
                                                        Text="{x:Bind Error, Mode=OneWay}"
                                                        Visibility="{x:Bind local:Ui.Show(HasError), Mode=OneWay}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="ForgetMachine"
                                                    AutomationProperties.Name="{x:Bind ForgetName, Mode=OneWay}"
                                                    Content="{x:Bind ForgetText, Mode=OneWay}"
                                                    IsEnabled="{x:Bind CanForget, Mode=OneWay}"
                                                    Click="{x:Bind Press}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <local:LaunchView x:Name="LaunchPane" Grid.Row="1" Visibility="Collapsed" />
                <local:UsageView x:Name="UsagePane" Grid.Row="1" Visibility="Collapsed" />
                <local:SettingsView x:Name="SettingsPane" Grid.Row="1" Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
