<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AgentBridge.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentBridge.App"
    xmlns:core="using:AgentBridge.App.Core"
    Title="Agent Bridge">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView
            x:Name="Nav"
            PaneDisplayMode="Top"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="OnNavigate">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="SessionsItem" Content="Sessions" Tag="sessions" AutomationProperties.AutomationId="NavSessions">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            Value="{x:Bind ViewModel.Waiting, Mode=OneWay}"
                            Visibility="{x:Bind local:Ui.Count(ViewModel.Waiting), Mode=OneWay}"
                            Background="{ThemeResource AbWarning}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="LaunchItem" Content="Launch" Tag="launch" AutomationProperties.AutomationId="NavLaunch"
                    Visibility="{x:Bind local:Ui.Show(Launch.Available), Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Usage" Tag="usage" AutomationProperties.AutomationId="NavUsage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings" AutomationProperties.AutomationId="NavSettings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <InfoBar
                        Margin="16,8,16,0"
                        AutomationProperties.AutomationId="Banner"
                        IsClosable="False"
                        Severity="Warning"
                        IsOpen="{x:Bind ViewModel.HasBanner, Mode=OneWay}"
                        Message="{x:Bind ViewModel.Banner, Mode=OneWay}" />
                    <InfoBar
                        Margin="16,8,16,0"
                        AutomationProperties.AutomationId="DiscoveryHeld"
                        IsClosable="False"
                        Severity="Informational"
                        IsOpen="{x:Bind ViewModel.IsHeld, Mode=OneWay}"
                        Message="{x:Bind ViewModel.HeldWhy, Mode=OneWay}" />
                </StackPanel>

                <ScrollViewer x:Name="SessionsPane" Grid.Row="1" AutomationProperties.AutomationId="SessionsPane">
                    <!-- In a Grid: a ScrollViewer centres a narrower child by its desired width, which pushed
                         the column off the right edge (see LaunchView). -->
                    <Grid>
                        <StackPanel MaxWidth="920" Padding="16,12,16,24" Spacing="12">
                            <ComboBox
                                x:Name="MachinePicker"
                                AutomationProperties.AutomationId="MachinePicker"
                                AutomationProperties.Name="Show sessions from"
                                Header="Machines"
                                MinWidth="260"
                                ItemsSource="{x:Bind ViewModel.Machines}"
                                SelectedItem="{x:Bind ViewModel.SelectedMachine, Mode=OneWay}"
                                SelectionChanged="OnMachineChosen"
                                Visibility="{x:Bind local:Ui.Show(ViewModel.ShowMachines), Mode=OneWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:MachineChoice">
                                        <TextBlock Text="{x:Bind Label, Mode=OneWay}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <!-- Your order, Most recent or Machine (#164). -->
                            <ComboBox
                                x:Name="SortPicker"
                                AutomationProperties.AutomationId="SortPicker"
                                AutomationProperties.Name="Sort sessions"
                                Header="Sort"
                                MinWidth="160"
                                ItemsSource="{x:Bind core:MainViewModel.SortChoices}"
                                SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" />
                            <InfoBar
                                AutomationProperties.AutomationId="FleetNote"
                                IsClosable="False"
                                Severity="Informational"
                                IsOpen="{x:Bind ViewModel.HasFleetNote, Mode=OneWay}"
                                Message="{x:Bind ViewModel.FleetNote, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource AbSecondaryText}"
                                AutomationProperties.AutomationId="EmptyText"
                                TextWrapping="Wrap"
                                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                                Visibility="{x:Bind local:Ui.Show(ViewModel.Empty), Mode=OneWay}" />
                            <ItemsControl x:Name="Cards" ItemsSource="{x:Bind ViewModel.Sessions}" IsTabStop="False" AutomationProperties.AutomationId="Cards">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="14" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:SessionCardViewModel">
                                        <local:SessionCard Card="{x:Bind}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Ended · N, folded: sessions a host removed while the app was running (#164). -->
                            <Expander
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.AutomationId="Ended"
                                Header="{x:Bind ViewModel.EndedHeader, Mode=OneWay}"
                                Visibility="{x:Bind local:Ui.Show(ViewModel.HasEnded), Mode=OneWay}">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Ended}" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="core:EndedRow">
                                            <StackPanel Padding="0,4">
                                                <TextBlock TextWrapping="Wrap" Text="{x:Bind Title}" />
                                                <TextBlock Style="{StaticResource AbSecondaryText}" FontSize="12" Text="{x:Bind Meta}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <!-- The account's other machines' updates, each with Check and Install, and Check
                                 all, which checks this machine too (#51). -->
                            <StackPanel
                                Spacing="6"
                                AutomationProperties.AutomationId="MachineUpdates"
                                Visibility="{x:Bind local:Ui.Show(ViewModel.ShowMachineUpdates), Mode=OneWay}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource AbSecondaryText}" VerticalAlignment="Center" Text="Updates on your other machines" />
                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="CheckAllUpdates"
                                        AutomationProperties.Name="Check every machine for updates, this one included"
                                        Content="Check all"
                                        IsEnabled="{x:Bind ViewModel.CanCheckAll, Mode=OneWay}"
                                        Click="{x:Bind ViewModel.CheckAll}" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.MachineUpdates}" IsTabStop="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="core:MachineUpdateViewModel">
                                            <Grid ColumnSpacing="8" AutomationProperties.AutomationId="MachineUpdate">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource AbSecondaryText}" TextWrapping="Wrap" Text="{x:Bind StatusText, Mode=OneWay}" />
                                                    <TextBlock
                                                        Style="{StaticResource AbSecondaryText}"
                                                        TextWrapping="Wrap"
                                                        Text="{x:Bind LastText, Mode=OneWay}"
                                                        Visibility="{x:Bind local:Ui.Show(HasLast), Mode=OneWay}" />
                                                    <TextBlock
                                                        Style="{StaticResource AbSecondaryText}"
                                                        TextWrapping="Wrap"
                                                        Text="{x:Bind Note, Mode=OneWay}"
                                                        Visibility="{x:Bind local:Ui.Show(HasNote), Mode=OneWay}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="CheckMachineUpdate"
                                                    AutomationProperties.Name="{x:Bind CheckName, Mode=OneWay}"
                                                    Content="Check"
                                                    IsEnabled="{x:Bind CanCheck, Mode=OneWay}"
                                                    Click="{x:Bind Check}" />
                                                <Button
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="InstallMachineUpdate"
                                                    AutomationProperties.Name="{x:Bind InstallName, Mode=OneWay}"
                                                    Content="Install"
                                                    IsEnabled="{x:Bind CanInstall, Mode=OneWay}"
                                                    Click="{x:Bind Install}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <!-- The account's machines that are offline, from the relay's roster, each with a
                                 two-press Forget (#50). -->
                            <StackPanel
                                Spacing="6"
                                AutomationProperties.AutomationId="OfflineMachines"
                                Visibility="{x:Bind local:Ui.Show(ViewModel.ShowOfflineMachines), Mode=OneWay}">
                                <TextBlock Style="{StaticResource AbSecondaryText}" Text="Offline machines" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.OfflineMachines}" IsTabStop="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="core:OfflineMachineViewModel">
                                            <Grid ColumnSpacing="12" AutomationProperties.AutomationId="OfflineMachine">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource AbSecondaryText}" Text="{x:Bind LastSeenText, Mode=OneWay}" />
                                                    <TextBlock
                                                        Style="{StaticResource AbSecondaryText}"
                                                        TextWrapping="Wrap"
                                                        Text="{x:Bind Error, Mode=OneWay}"
                                                        Visibility="{x:Bind local:Ui.Show(HasError), Mode=OneWay}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="ForgetMachine"
                                                    AutomationProperties.Name="{x:Bind ForgetName, Mode=OneWay}"
                                                    Content="{x:Bind ForgetText, Mode=OneWay}"
                                                    IsEnabled="{x:Bind CanForget, Mode=OneWay}"
                                                    Click="{x:Bind Press}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <local:LaunchView x:Name="LaunchPane" Grid.Row="1" Visibility="Collapsed" />
                <local:UsageView x:Name="UsagePane" Grid.Row="1" Visibility="Collapsed" />
                <local:SettingsView x:Name="SettingsPane" Grid.Row="1" Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
