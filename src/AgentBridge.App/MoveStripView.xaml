<?xml version="1.0" encoding="utf-8"?>
<!-- The move strip (ui.md §6.6.2 rule 13, #1716): five steps, each with its state in words; named for a screen reader, never takes focus. -->
<UserControl
    x:Class="AgentBridge.App.MoveStripView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:AgentBridge.App.Core"
    xmlns:local="using:AgentBridge.App"
    IsTabStop="False">
    <StackPanel
        x:Name="Region" Spacing="4" AutomationProperties.AutomationId="MoveStrip" AutomationProperties.LandmarkType="Custom" AutomationProperties.LocalizedLandmarkType="move">
        <TextBlock x:Name="HeadText" Style="{StaticResource AbTypeMeta}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="MoveHead" />
        <ItemsControl x:Name="StepList" IsTabStop="False" AutomationProperties.AutomationId="MoveSteps">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:MoveStepItem">
                    <StackPanel AutomationProperties.AutomationId="MoveStep" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                        <TextBlock Style="{StaticResource AbTypeMeta}" Foreground="{ThemeResource AbText2}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw">
                            <Run Text="{x:Bind Number}" /><Run Text=" " /><Run Text="{x:Bind Words}" /><Run Text=" · " /><Run Text="{x:Bind TimeText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="16,0,0,0" Style="{StaticResource AbTypeMeta}" TextWrapping="Wrap" Foreground="{ThemeResource AbDangerText}" Text="{x:Bind Reason, Mode=OneWay}" Visibility="{x:Bind local:Ui.Show(HasReason), Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel x:Name="Actions" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button x:Name="GoTo" Content="Go to it" AutomationProperties.AutomationId="MoveGoTo" Click="OnGoTo" />
            <Button x:Name="Retry" Content="Try again" AutomationProperties.AutomationId="MoveTryAgain" Click="OnRetry" />
            <Button x:Name="Dismiss" Content="Close" AutomationProperties.AutomationId="MoveClose" Click="OnClose" />
        </StackPanel>
    </StackPanel>
</UserControl>
