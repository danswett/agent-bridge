<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows app (docs/app-windows.md): WinUI 3, unpackaged and self-contained, installed
       and updated by Velopack with the host published beside it. Settings follow spike S3
       (spikes/s3-winui-velopack/RESULTS.md). Not in AgentBridge.slnx: it builds only on
       Windows, and CI builds it in a job of its own (build/pack-app.ps1). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Without it an unpackaged publish leaves out the app's .pri, which carries the compiled
         XAML, and the installed app fails at startup with nothing but 0xC000027B (S3). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <!-- x64 unless published for another (build/pack-app.ps1 -Runtime win-arm64). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64;ARM64</Platforms>
    <!-- Program.Main runs Velopack's hooks and registers the toast activator before XAML. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AgentBridge</AssemblyName>
    <RootNamespace>AgentBridge.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The product's name and brand art for the build (#537): the exe's ProductName and
         FileDescription (Task Manager, the file's properties; without them both said the assembly
         name, "AgentBridge"), its icon, and through build/app-channels.ps1 the installer's title
         and icon. The app's code reads the same from Product.Name and AppAssets; AppBrandTests
         holds them together. AssemblyName and the files' names are identifiers and stay (#541). -->
    <Product>Slipgates</Product>
    <AssemblyTitle>$(Product)</AssemblyTitle>
    <AppIconFile>Assets\AgentBridge.ico</AppIconFile>
    <AppLogoFile>Assets\AgentBridge.png</AppLogoFile>
    <ApplicationIcon>$(AppIconFile)</ApplicationIcon>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(AppIconFile)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(AppLogoFile)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Slipgates Sans and Slipgates Mono (docs/design/ui.md §4.1), from design/fonts rather than
       a second copy: each family's collection of hinted static faces, which the generated
       SansFontFamily and MonoFontFamily name by ms-appx, and the SIL Open Font License each ships
       under, beside it. One collection per family holds every weight and style the ramps use, so
       DirectWrite fakes none of them (ui.md §4.2). Design/DesignKeys.cs lists what must be here;
       the self-test and build/pack-app.ps1 check it. -->
  <ItemGroup>
    <Content Include="..\..\design\fonts\slipgates-sans\ttc\SlipgatesSans.ttc" Link="Assets\Fonts\SlipgatesSans.ttc" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\design\fonts\slipgates-sans\OFL.txt" Link="Assets\Fonts\SlipgatesSans-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\design\fonts\slipgates-mono\ttc\SlipgatesMono.ttc" Link="Assets\Fonts\SlipgatesMono.ttc" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\design\fonts\slipgates-mono\OFL.txt" Link="Assets\Fonts\SlipgatesMono-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentBridge.App.Core\AgentBridge.App.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host's own reader of the release list (#530, #927), so the app and the host read releases one way. -->
    <Compile Include="..\AgentBridge.Host\DiscoveredGithubSource.cs" Link="DiscoveredGithubSource.cs" />
  </ItemGroup>

</Project>
