<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AgentBridge.App.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentBridge.App"
    xmlns:core="using:AgentBridge.App.Core">
    <!-- The Sessions page's panes by window width (docs/design/ui.md §5.2, #180), at the PWA's
         breakpoints (design/tokens.json layout): list · session · inspector from 1280, list · session
         with tabs from 760, and one column below, the list or the session with a way back.
         PaneLayoutViewModel says which pane shows; these states only lay them out. -->
    <Grid x:Name="PageRoot" AutomationProperties.AutomationId="SessionsPage">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Panes">
                <VisualState x:Name="ThreePanes">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource AbLayoutThreePane}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="TwoPanes">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource AbLayoutTwoPane}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- 264–320 (§5.2), the rest to the session. -->
                        <Setter Target="ListColumn.Width" Value="3*" />
                        <Setter Target="SessionColumn.Width" Value="7*" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="OneColumn">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ListColumn.Width" Value="*" />
                        <Setter Target="ListColumn.MaxWidth" Value="Infinity" />
                        <Setter Target="SessionColumn.Width" Value="0" />
                        <Setter Target="ListPane.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ListPane.BorderThickness" Value="0" />
                        <Setter Target="SessionPane.(Grid.Column)" Value="0" />
                        <Setter Target="SessionPane.(Grid.ColumnSpan)" Value="3" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <!-- The list's width is set in code (DesignLayout.List): a resource double can't be a GridLength, and
                 assigning one fails only when the window loads (0xC000027B). -->
            <ColumnDefinition x:Name="ListColumn" MinWidth="{StaticResource AbLayoutListMin}" MaxWidth="{StaticResource AbLayoutList}" />
            <ColumnDefinition x:Name="SessionColumn" Width="*" />
            <ColumnDefinition x:Name="InspectorColumn" Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The list (§6.1). -->
        <Grid
            x:Name="ListPane"
            BorderBrush="{ThemeResource AbStroke}"
            BorderThickness="0,0,1,0"
            AutomationProperties.AutomationId="ListPane"
            Visibility="{x:Bind local:Ui.Show(Layout.ShowList), Mode=OneWay, FallbackValue=Visible}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- The title, with sort and New on its row (#213: the title cut short, never under them). -->
            <Grid Padding="16,16,12,8" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource AbTypeTitle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    AutomationProperties.HeadingLevel="Level1"
                    Text="Sessions" />
                <!-- Your order, Most recent or Machine (#164). -->
                <Button
                    x:Name="SortButton"
                    Grid.Column="1"
                    Style="{StaticResource AbIconButton}"
                    AutomationProperties.AutomationId="SortPicker"
                    AutomationProperties.Name="Sort sessions"
                    ToolTipService.ToolTip="Sort sessions">
                    <ContentControl Style="{StaticResource AbIconMore}" Width="16" Height="16" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedRight" Opening="OnSortOpening" />
                    </Button.Flyout>
                </Button>
                <Button
                    Grid.Column="2"
                    MinHeight="32"
                    Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="NewSession"
                    AutomationProperties.Name="New session"
                    ToolTipService.ToolTip="New session"
                    Visibility="{x:Bind local:Ui.Show(Launch.Available), Mode=OneWay, FallbackValue=Collapsed}"
                    Click="OnNew">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ContentControl Style="{StaticResource AbIconPlus}" Width="16" Height="16" />
                        <TextBlock Text="New" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- The machine tabs (§6.1): All, then each machine by name. -->
            <ScrollViewer
                Grid.Row="1"
                Padding="8,0,8,4"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                Visibility="{x:Bind local:Ui.Show(ViewModel.ShowMachines), Mode=OneWay, FallbackValue=Collapsed}">
                <SelectorBar
                    x:Name="MachineTabs"
                    AutomationProperties.AutomationId="MachinePicker"
                    AutomationProperties.Name="Show sessions from"
                    SelectionChanged="OnMachineTab" />
            </ScrollViewer>

            <StackPanel Grid.Row="2" Padding="16,0,16,0" Spacing="8">
                <InfoBar
                    AutomationProperties.AutomationId="FleetNote"
                    IsClosable="False"
                    Severity="Informational"
                    IsOpen="{x:Bind ViewModel.HasFleetNote, Mode=OneWay, FallbackValue=False}"
                    Message="{x:Bind ViewModel.FleetNote, Mode=OneWay}" />
                <TextBlock
                    Margin="0,8"
                    Style="{StaticResource AbTypeMeta}"
                    Foreground="{ThemeResource AbText2}"
                    AutomationProperties.AutomationId="EmptyText"
                    TextWrapping="Wrap"
                    Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                    Visibility="{x:Bind local:Ui.Show(ViewModel.Empty), Mode=OneWay, FallbackValue=Collapsed}" />
            </StackPanel>

            <ListView
                x:Name="List"
                Grid.Row="3"
                Padding="0,0,0,16"
                SelectionMode="Single"
                AutomationProperties.AutomationId="Rows"
                AutomationProperties.Name="Sessions"
                ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}"
                SelectionChanged="OnRowChosen"
                ContainerContentChanging="OnRowRecycled"
                PreviewKeyDown="OnListKey"
                ContextRequested="OnListMenu">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="8,0,4,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:SessionCardViewModel">
                        <local:SessionRow Card="{x:Bind}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <!-- Ended · N, folded: sessions a host removed while the app was running (#164). -->
                    <Expander
                        Margin="12,8,12,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="Ended"
                        Header="{x:Bind ViewModel.EndedHeader, Mode=OneWay}"
                        Visibility="{x:Bind local:Ui.Show(ViewModel.HasEnded), Mode=OneWay, FallbackValue=Collapsed}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Ended, Mode=OneWay}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:EndedRow">
                                    <StackPanel Padding="0,4">
                                        <TextBlock Style="{StaticResource AbTypeRow}" TextTrimming="CharacterEllipsis" Text="{x:Bind Title}" />
                                        <TextBlock Style="{StaticResource AbTypeMeta}" Foreground="{ThemeResource AbText2}" TextTrimming="CharacterEllipsis" Text="{x:Bind Meta}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </ListView.Footer>
            </ListView>
        </Grid>

        <!-- The session (§6.2, §6.4, §6.5), or what to do with nothing chosen. -->
        <Grid x:Name="SessionPane" Grid.Column="1" AutomationProperties.AutomationId="SessionPane" Visibility="{x:Bind local:Ui.Show(Layout.ShowSession), Mode=OneWay, FallbackValue=Collapsed}">
            <local:SessionView
                x:Name="Session"
                Card="{x:Bind Layout.Selected, Mode=OneWay}"
                Visibility="{x:Bind local:Ui.Some(Layout.Selected), Mode=OneWay, FallbackValue=Collapsed}" />
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource AbTypeRow}"
                Foreground="{ThemeResource AbText2}"
                AutomationProperties.AutomationId="NoSession"
                Text="Choose a session to see its conversation."
                Visibility="{x:Bind local:Ui.Show(Layout.ShowEmpty), Mode=OneWay, FallbackValue=Collapsed}" />
        </Grid>

        <!-- The inspector (§5.2): the session's Details and Tools until U8 (#176) puts its delegates
             first; a section each, so delegates go above without laying these out again. -->
        <ScrollViewer
            x:Name="Inspector"
            Grid.Column="2"
            Width="{StaticResource AbLayoutInspector}"
            BorderBrush="{ThemeResource AbStroke}"
            BorderThickness="1,0,0,0"
            AutomationProperties.AutomationId="Inspector"
            Visibility="{x:Bind local:Ui.Show(Layout.ShowInspector), Mode=OneWay, FallbackValue=Collapsed}">
            <StackPanel Padding="16,20,16,24" Spacing="24">
                <StackPanel Spacing="8" AutomationProperties.AutomationId="InspectorDetails">
                    <TextBlock Style="{StaticResource AbTypeSectionHeader}" Foreground="{ThemeResource AbText2}" AutomationProperties.HeadingLevel="Level2" Text="Details" />
                    <local:SessionDetails x:Name="InspectorDetails" Card="{x:Bind Layout.Selected, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Spacing="8" AutomationProperties.AutomationId="InspectorTools" Visibility="{x:Bind local:Ui.Show(Layout.ShowToolsTab), Mode=OneWay, FallbackValue=Collapsed}">
                    <TextBlock Style="{StaticResource AbTypeSectionHeader}" Foreground="{ThemeResource AbText2}" AutomationProperties.HeadingLevel="Level2" Text="Tools" />
                    <local:ToolList Card="{x:Bind Layout.Selected, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>