<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AgentBridge.App.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentBridge.App"
    xmlns:core="using:AgentBridge.App.Core">
    <!-- The Sessions page's panes by window width (docs/design/ui.md §5.2, #180), at the PWA's
         breakpoints (design/tokens.json layout): list · session · inspector from 1280, list · session
         with tabs from 760, and one column below, the list or the session with a way back.
         PaneLayoutViewModel says which pane shows; these states only lay them out. -->
    <Grid x:Name="PageRoot" AutomationProperties.AutomationId="SessionsPage">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Panes">
                <VisualState x:Name="ThreePanes">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource AbLayoutThreePane}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="TwoPanes">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource AbLayoutTwoPane}" />
                    </VisualState.StateTriggers>
                    <!-- The list's width is its divider's, in code (SessionsPage.Dividers), as at three panes. -->
                </VisualState>
                <VisualState x:Name="OneColumn">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- The list's column fills it. Code sizes it only at two and three panes (SessionsPage.Dividers):
                             a width set in code overwrites a setter's, as a local value does. -->
                        <Setter Target="ListColumn.Width" Value="*" />
                        <Setter Target="ListColumn.MaxWidth" Value="Infinity" />
                        <Setter Target="SessionColumn.Width" Value="0" />
                        <Setter Target="ListPane.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ListPane.BorderThickness" Value="0" />
                        <Setter Target="SessionPane.(Grid.Column)" Value="0" />
                        <Setter Target="SessionPane.(Grid.ColumnSpan)" Value="3" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <!-- The list's width is set in code (DesignLayout.List, then its divider's, SessionsPage.Dividers): a resource
                 double can't be a GridLength, and assigning one fails only when the window loads (0xC000027B). -->
            <ColumnDefinition x:Name="ListColumn" MinWidth="{StaticResource AbLayoutListMin}" MaxWidth="{StaticResource AbLayoutListMax}" />
            <ColumnDefinition x:Name="SessionColumn" Width="*" />
            <ColumnDefinition x:Name="InspectorColumn" Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The list (§6.1). -->
        <Grid
            x:Name="ListPane"
            BorderBrush="{ThemeResource AbStroke}"
            BorderThickness="0,0,1,0"
            AutomationProperties.AutomationId="ListPane"
            Visibility="{x:Bind local:Ui.Show(Layout.ShowList), Mode=OneWay, FallbackValue=Visible}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- The title, with sort and New on its row (#213: the title cut short, never under them). -->
            <Grid x:Name="ListHead" Padding="16,16,12,8" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource AbTypeTitle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    AutomationProperties.HeadingLevel="Level1"
                    Text="Sessions" />
                <!-- Your order, Most recent or Machine (#164). -->
                <Button
                    x:Name="SortButton"
                    Grid.Column="1"
                    Style="{StaticResource AbIconButton}"
                    AutomationProperties.AutomationId="SortPicker"
                    AutomationProperties.Name="Sort sessions"
                    ToolTipService.ToolTip="Sort sessions">
                    <ContentControl Style="{StaticResource AbIconMore}" Width="16" Height="16" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedRight" Opening="OnSortOpening" />
                    </Button.Flyout>
                </Button>
                <Button
                    Grid.Column="2"
                    MinHeight="32"
                    Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="NewSession"
                    AutomationProperties.Name="New session"
                    ToolTipService.ToolTip="New session"
                    Visibility="{x:Bind local:Ui.Show(Launch.Available), Mode=OneWay, FallbackValue=Collapsed}"
                    Click="OnNew">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ContentControl Style="{StaticResource AbIconPlus}" Width="16" Height="16" />
                        <TextBlock Text="New" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- The machine tabs (§6.1, #290): All, then each machine by name, as many as fit, the
                 one chosen always among them; the rest under More. Never scrolled sideways. -->
            <Grid
                x:Name="MachineBar"
                Grid.Row="1"
                Padding="8,0,8,4"
                ColumnSpacing="4"
                Visibility="{x:Bind local:Ui.Show(ViewModel.ShowMachines), Mode=OneWay, FallbackValue=Collapsed}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <SelectorBar
                    x:Name="MachineTabs"
                    AutomationProperties.AutomationId="MachinePicker"
                    AutomationProperties.Name="Show sessions from"
                    SelectionChanged="OnMachineTab" />
                <Button
                    x:Name="MoreMachines"
                    Grid.Column="1"
                    MinHeight="32"
                    MinWidth="32"
                    Padding="8,0"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Background="{ThemeResource SubtleFillColorTransparentBrush}"
                    CornerRadius="{StaticResource AbRadiusControl}"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="MoreMachines"
                    ToolTipService.ToolTip="More machines">
                    <StackPanel x:Name="MoreMachinesContent" Orientation="Horizontal" Spacing="4">
                        <TextBlock x:Name="MoreMachinesText" VerticalAlignment="Center" Style="{StaticResource AbTypeRow}" />
                        <ContentControl x:Name="MoreMachinesChevron" Style="{StaticResource AbIconChevron}" Width="12" Height="12" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <ContentControl.RenderTransform>
                                <RotateTransform Angle="90" />
                            </ContentControl.RenderTransform>
                        </ContentControl>
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout x:Name="MoreMachinesMenu" Placement="BottomEdgeAlignedLeft" Opening="OnMoreMachinesOpening" />
                    </Button.Flyout>
                </Button>
            </Grid>

            <StackPanel x:Name="ListNotes" Grid.Row="2" Padding="16,0,16,0" Spacing="8">
                <InfoBar
                    x:Name="FleetNote"
                    AutomationProperties.AutomationId="FleetNote"
                    IsClosable="False"
                    Severity="Informational"
                    IsOpen="{x:Bind ViewModel.HasFleetNote, Mode=OneWay, FallbackValue=False}"
                    Message="{x:Bind ViewModel.FleetNote, Mode=OneWay}" />
                <TextBlock
                    Margin="0,8"
                    Style="{StaticResource AbTypeMeta}"
                    Foreground="{ThemeResource AbText2}"
                    AutomationProperties.AutomationId="EmptyText"
                    TextWrapping="Wrap"
                    Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                    Visibility="{x:Bind local:Ui.Show(ViewModel.Empty), Mode=OneWay, FallbackValue=Collapsed}" />
            </StackPanel>

            <ListView
                x:Name="List"
                Grid.Row="3"
                Padding="0,0,0,16"
                SelectionMode="Single"
                SingleSelectionFollowsFocus="False"
                AutomationProperties.AutomationId="Rows"
                AutomationProperties.Name="Sessions"
                ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}"
                SelectionChanged="OnRowChosen"
                ContainerContentChanging="OnRowRecycled"
                PreviewKeyDown="OnListKey"
                ContextRequested="OnListMenu">
                <!-- None of the list's own transitions (ui.md §5.3, Arriving and leaving, Reorder): they
                     slide a row's neighbours as it comes, goes or moves, and stagger the rows in on
                     load. Only the row that changed moves (SessionsPage, SessionRow). -->
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="8,0,4,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.Header>
                    <!-- Needs you · N (§6.1, #165), the list's first section: moved here from the Sessions page's
                         cards as it was, its approval logic untouched (NeedsYou.cs); the grid only spaces it. -->
                    <Grid Padding="12,0,12,8">
                        <!-- Needs you · N (#165): every pending question on every machine, oldest first. It
                             refers to the cards below and never moves them. -->
                        <Border
                            AutomationProperties.AutomationId="NeedsYou"
                            AutomationProperties.Name="{x:Bind ViewModel.NeedsYouHeader, Mode=OneWay}"
                            Visibility="{x:Bind local:Ui.Show(ViewModel.HasNeedsYou), Mode=OneWay}"
                            Background="{ThemeResource AbNeedsFill}"
                            BorderBrush="{ThemeResource AbNeeds}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    AutomationProperties.HeadingLevel="Level2"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AbNeedsHead}"
                                    Text="{x:Bind ViewModel.NeedsYouHeader, Mode=OneWay}" />
                                <ItemsControl x:Name="LaneItems" ItemsSource="{x:Bind ViewModel.NeedsYou}" IsTabStop="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="10" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="core:NeedsYouEntry">
                                            <Grid ColumnSpacing="8" AutomationProperties.AutomationId="NeedsYouEntry">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- The Needs you glyph (#178), decorative: the lane's heading says it. -->
                                                <local:StatusGlyphView Size="16" Margin="0,8,0,0" VerticalAlignment="Top" Glyph="{x:Bind Glyph}" AutomationProperties.AutomationId="NeedsYouGlyph" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <HyperlinkButton
                                                        Padding="0"
                                                        MinHeight="32"
                                                        AutomationProperties.AutomationId="NeedsYouOpen"
                                                        AutomationProperties.Name="{x:Bind OpenName, Mode=OneWay}"
                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                        Click="{x:Bind Open}">
                                                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{x:Bind Title, Mode=OneWay}" />
                                                    </HyperlinkButton>
                                                    <TextBlock
                                                        TextWrapping="Wrap"
                                                        FlowDirection="LeftToRight"
                                                        TextReadingOrder="DetectFromContent"
                                                        Text="{x:Bind Line}"
                                                        Visibility="{x:Bind local:Ui.Show(ShowLine)}" />
                                                    <!-- An approval answered here shows its prompt whole: everything Approve once allows. -->
                                                    <local:MarkdownView
                                                        AutomationProperties.AutomationId="NeedsYouPrompt"
                                                        WrapCode="True"
                                                        Markdown="{x:Bind Prompt}"
                                                        Visibility="{x:Bind local:Ui.Show(HasPrompt)}" />
                                                    <TextBlock Style="{StaticResource AbSecondaryText}" FontSize="12" Text="{x:Bind Meta, Mode=OneWay}" />
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource AbNeedsText}"
                                                        Text="Answer at the machine"
                                                        Visibility="{x:Bind local:Ui.Show(AtMachine)}" />
                                                    <!-- Deny moves to a line of its own when the two don't fit, as in a narrow window with large text. -->
                                                    <local:FlowPanel Spacing="8" LineSpacing="8" Margin="0,4,0,0" Visibility="{x:Bind local:Ui.Show(Approvable)}">
                                                        <Button
                                                            MinHeight="32"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            AutomationProperties.AutomationId="NeedsYouApprove"
                                                            AutomationProperties.Name="{x:Bind ApproveName, Mode=OneWay}"
                                                            IsEnabled="{x:Bind CanAnswer, Mode=OneWay}"
                                                            Click="{x:Bind Approve}">
                                                            <!-- The ring while its answer is on its way (ui.md §5.3, Send and Answer), beside the label, never over it. -->
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <local:InFlightRing Active="{x:Bind ApproveInFlight, Mode=OneWay}" />
                                                                <TextBlock Text="{x:Bind ApproveLabel, Mode=OneWay}" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button
                                                            MinHeight="32"
                                                            AutomationProperties.AutomationId="NeedsYouDeny"
                                                            AutomationProperties.Name="{x:Bind DenyName, Mode=OneWay}"
                                                            IsEnabled="{x:Bind CanAnswer, Mode=OneWay}"
                                                            Click="{x:Bind Deny}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <local:InFlightRing Active="{x:Bind DenyInFlight, Mode=OneWay}" />
                                                                <TextBlock Text="{x:Bind DenyLabel, Mode=OneWay}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </local:FlowPanel>
                                                    <!-- The machine failed the op: the same request again, as the card's Send again.
                                                         On a row of its own, so a narrow window or large text can't push it out of sight. -->
                                                    <Button
                                                        MinHeight="32"
                                                        AutomationProperties.AutomationId="NeedsYouResend"
                                                        AutomationProperties.Name="{x:Bind ResendName, Mode=OneWay}"
                                                        Content="Send again"
                                                        Visibility="{x:Bind local:Ui.Show(ShowResend), Mode=OneWay}"
                                                        Click="{x:Bind Resend}" />
                                                    <!-- In the text colour, not the outcome's: the role colours are checked against
                                                         the card, not the Needs you fill, and the words say the outcome. -->
                                                    <TextBlock
                                                        TextWrapping="Wrap"
                                                        IsTextSelectionEnabled="True"
                                                        Text="{x:Bind StatusText, Mode=OneWay}"
                                                        Foreground="{ThemeResource AbText}"
                                                        Visibility="{x:Bind local:Ui.Show(HasStatus), Mode=OneWay}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:SessionCardViewModel">
                        <local:SessionRow Card="{x:Bind}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <!-- Ended · N, folded: sessions a host removed while the app was running (#164). -->
                    <Expander
                        Margin="12,8,12,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="Ended"
                        Header="{x:Bind ViewModel.EndedHeader, Mode=OneWay}"
                        Visibility="{x:Bind local:Ui.Show(ViewModel.HasEnded), Mode=OneWay, FallbackValue=Collapsed}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Ended, Mode=OneWay}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:EndedRow">
                                    <StackPanel Padding="0,4">
                                        <TextBlock Style="{StaticResource AbTypeRow}" TextTrimming="CharacterEllipsis" Text="{x:Bind Title}" />
                                        <TextBlock Style="{StaticResource AbTypeMeta}" Foreground="{ThemeResource AbText2}" TextTrimming="CharacterEllipsis" Text="{x:Bind Meta}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </ListView.Footer>
            </ListView>
        </Grid>

        <!-- The dividers (§5.2, #297) lie over the panes' hairlines, above the panes (ZIndex), each in the tab order
             between the panes it divides, and each on the side of its line away from a scroll bar, as the list's and
             the conversation's run down their right edges. The list's shows wherever the list and the session both
             do (SessionsPage.Dividers). -->
        <local:PaneDividerView
            x:Name="ListDivider"
            Grid.Column="1"
            Canvas.ZIndex="1"
            Margin="-1,0,0,0"
            Divider="List"
            AutomationProperties.AutomationId="ListDivider"
            AutomationProperties.Name="Resize the sessions list"
            Visibility="Collapsed" />

        <!-- The session (§6.2, §6.4, §6.5), or what to do with nothing chosen. -->
        <Grid x:Name="SessionPane" Grid.Column="1" AutomationProperties.AutomationId="SessionPane" Visibility="{x:Bind local:Ui.Show(Layout.ShowSession), Mode=OneWay, FallbackValue=Collapsed}">
            <local:SessionView
                x:Name="Session"
                Card="{x:Bind Layout.Selected, Mode=OneWay}"
                Visibility="{x:Bind local:Ui.Some(Layout.Selected), Mode=OneWay, FallbackValue=Collapsed}" />
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource AbTypeRow}"
                Foreground="{ThemeResource AbText2}"
                AutomationProperties.AutomationId="NoSession"
                Text="Choose a session to see its conversation."
                Visibility="{x:Bind local:Ui.Show(Layout.ShowEmpty), Mode=OneWay, FallbackValue=Collapsed}" />
        </Grid>

        <local:PaneDividerView
            x:Name="InspectorDivider"
            Grid.Column="2"
            Canvas.ZIndex="1"
            Divider="Inspector"
            AutomationProperties.AutomationId="InspectorDivider"
            AutomationProperties.Name="Resize the inspector"
            Visibility="{x:Bind local:Ui.Show(Layout.ShowInspector), Mode=OneWay, FallbackValue=Collapsed}" />

        <!-- The inspector (§5.2, §6.3): the delegate selected in the session's strip, or with none the
             session's Details and Tools. -->
        <ScrollViewer
            x:Name="Inspector"
            Grid.Column="2"
            Width="{StaticResource AbLayoutInspector}"
            BorderBrush="{ThemeResource AbStroke}"
            BorderThickness="1,0,0,0"
            AutomationProperties.AutomationId="Inspector"
            Visibility="{x:Bind local:Ui.Show(Layout.ShowInspector), Mode=OneWay, FallbackValue=Collapsed}">
            <Grid x:Name="InspectorContent" Padding="16,20,16,24">
                <local:DelegateInspector
                    x:Name="InspectorDelegate"
                    BackLabel="Back to the session's details"
                    Card="{x:Bind Layout.Selected, Mode=OneWay}"
                    Visibility="{x:Bind local:Ui.Show(Layout.ShowDelegateInspector), Mode=OneWay, FallbackValue=Collapsed}" />
                <StackPanel Spacing="24" Visibility="{x:Bind local:Ui.Show(Layout.ShowSessionInspector), Mode=OneWay, FallbackValue=Visible}">
                    <StackPanel Spacing="8" AutomationProperties.AutomationId="InspectorDetails">
                        <TextBlock Style="{StaticResource AbTypeSectionHeader}" Foreground="{ThemeResource AbText2}" AutomationProperties.HeadingLevel="Level2" Text="Details" />
                        <local:SessionDetails x:Name="InspectorDetails" Card="{x:Bind Layout.Selected, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="8" AutomationProperties.AutomationId="InspectorTools" Visibility="{x:Bind local:Ui.Show(Layout.ShowToolsTab), Mode=OneWay, FallbackValue=Collapsed}">
                        <TextBlock Style="{StaticResource AbTypeSectionHeader}" Foreground="{ThemeResource AbText2}" AutomationProperties.HeadingLevel="Level2" Text="Tools" />
                        <local:ToolList Card="{x:Bind Layout.Selected, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>