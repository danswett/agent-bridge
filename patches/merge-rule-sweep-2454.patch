diff --git a/.github/workflows/merge-rule-sweep.yml b/.github/workflows/merge-rule-sweep.yml
new file mode 100644
index 00000000..43003c46
--- /dev/null
+++ b/.github/workflows/merge-rule-sweep.yml
@@ -0,0 +1,46 @@
+name: Merge rule sweep
+
+# Cancels stuck Merge rule runs (#2454, merge-rule follow-up b; Quality's spec). merge-rule.yml's evaluate job times out
+# at 10 minutes, but only once a runner takes the job: its runs wait in one queue: max group, and a run waiting there
+# never times out (Nov 23: five, hours past that timeout, held every later run). So quality/merge-rule-sweep.ps1
+# cancels runs waiting over 30 minutes or running over 15, and never the newest run per pull request (or head). A run
+# past twice its limit, or one that refuses a plain cancel, is force-cancelled. It never deletes a run and touches no
+# other workflow's runs. It runs main's own script: nothing a pull request can change runs here.
+on:
+  schedule:
+    - cron: '7,22,37,52 * * * *'
+  workflow_dispatch:
+    inputs:
+      dry_run:
+        description: Report what would be cancelled, and cancel nothing
+        type: boolean
+        default: false
+
+permissions: {}
+
+concurrency:
+  group: merge-rule-sweep
+  cancel-in-progress: true
+
+jobs:
+  sweep:
+    if: github.repository == 'danswett/agent-bridge'
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    permissions:
+      actions: write # cancel and force-cancel Merge rule runs; nothing else
+      contents: read
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: main
+          persist-credentials: false
+          sparse-checkout: quality
+      - name: Cancel Merge rule runs waiting over 30 minutes or running over 15
+        shell: pwsh
+        env:
+          GH_TOKEN: ${{ github.token }}
+          REPOSITORY: ${{ github.repository }}
+          DRY_RUN: ${{ github.event_name == 'workflow_dispatch' && inputs.dry_run }}
+        run: |
+          & ./quality/merge-rule-sweep.ps1 -Repository $env:REPOSITORY -WaitingMaxMinutes 30 -RunningMaxMinutes 15 -DryRun:($env:DRY_RUN -eq 'true')
