+        head_sha = $sha; head_branch = $(if ($Branch) { $Branch } else { "br$Id" })
+        pull_requests = @(if ($Pr) { @{ number = $Pr; head = @{ sha = $(if ($PrHead) { $PrHead } else { $sha }); ref = $(if ($Branch) { $Branch } else { "br$Id" }) } } })
