   Jobs then run browser-only `playwright install`, without another apt update. Linux runners only.
+  It only RESTORES the archives cache and never writes one: full.yml (a workflow_run, in the default branch's context) uses only this action;
+  ci.yml saves with ../playwright-system-packages-save.
 
 inputs:
   browsers:
@@ -19,12 +21,14 @@ inputs:
       Anything else downloads as before.
     required: false
     default: 'false'
-  save:
-    description: >
-      'true' only where the job may write the archives cache: each ci.yml call says so. The default is false, the safe one, and full.yml says false
-      itself: it runs in the default branch's context on a workflow_run and so never writes a cache (only restores).
-    required: false
-    default: 'false'
+
+outputs:
+  cache-key:
+    description: The archives cache's exact key, for ../playwright-system-packages-save (ci.yml only; this action never writes a cache).
+    value: ${{ steps.debs.outputs.cache-primary-key }}
+  cache-ready:
+    description: 'true when the archives are downloaded and verified and may be saved by the save action.'
+    value: ${{ steps.packages.outputs.cache-ready }}
 
 runs:
   using: composite
@@ -59,8 +63,3 @@ runs:
       run: |
         read -ra browsers <<< "$BROWSERS"
         bash "$GITHUB_ACTION_PATH/download.sh" "${browsers[@]}"
-    - if: always() && steps.packages.outputs.cache-ready == 'true' && inputs.save == 'true'
-      uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
-      with:
-        path: ~/.cache/playwright-apt-debs
-        key: ${{ steps.debs.outputs.cache-primary-key }}
diff --git a/.github/actions/playwright-system-packages/test.sh b/.github/actions/playwright-system-packages/test.sh
