index f9fe6324..1b2fa545 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -300,6 +300,19 @@ jobs:
           "NUGET_PACKAGES=$t/nuget-packages", "NUGET_HTTP_CACHE_PATH=$t/nuget-http", "NUGET_PLUGINS_CACHE_PATH=$t/nuget-plugins", "DOTNET_CLI_HOME=$t/dotnet-home", "MSBUILDDISABLENODEREUSE=1" | Add-Content $env:GITHUB_ENV
           # A clean workspace: checkout cleans already; this also clears what a crashed job left.
           git clean -ffdx
+      # The ab-ci runners can't reach nuget.org (run 45277647321): each runner's .env names a mirror in
+      # AGENT_BRIDGE_NUGET_SOURCE, and this job's restores use a config in RUNNER_TEMP that lists only it (MSBuild reads
+      # RestoreConfigFile from the environment; dotnet tool restore gets --configfile). The repository's nuget.config is
+      # untouched, so the cache key is the same. A hosted runner skips this and restores from nuget.org as before.
+      - name: NuGet through the runner's mirror (self-hosted only)
+        if: runner.environment == 'self-hosted'
+        shell: pwsh
+        run: |
+          $src = "$env:AGENT_BRIDGE_NUGET_SOURCE"
+          if ($src -notmatch '^https://[A-Za-z0-9.-]+/[^\s"<>&]*$') { Write-Host '::error::this self-hosted runner names no https mirror in AGENT_BRIDGE_NUGET_SOURCE, and nuget.org is unreachable from it'; exit 1 }
+          $cfg = Join-Path $env:RUNNER_TEMP 'mirror.nuget.config'
+          "<?xml version=`"1.0`" encoding=`"utf-8`"?><configuration><packageSources><clear /><add key=`"mirror`" value=`"$src`" /></packageSources></configuration>" | Set-Content -Encoding utf8 $cfg
+          "RestoreConfigFile=$cfg", "NUGET_MIRROR_CONFIG=$cfg" | Add-Content $env:GITHUB_ENV
       - name: Choose what to test
         # The whole solution when the whole ring runs (a change to the solution, a workflow or
         # quality/, or main with no passed base), as before. Otherwise a solution filter of the selected test
@@ -331,8 +344,9 @@ jobs:
