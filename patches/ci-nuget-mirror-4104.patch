+      # The ab-ci runners can't reach nuget.org (run 45277647321, NU1301). On a self-hosted runner only, this job's
+      # restores use a config in RUNNER_TEMP (MSBuild reads RestoreConfigFile from the environment; the tool restore
+      # below gets --configfile) that lists only the runner's mirror (AGENT_BRIDGE_NUGET_SOURCE in its .env, https),
+      # clears every fallback folder, and requires every package to carry nuget.org's repository signature: the mirror
+      # can serve nuget.org's own bytes or nothing (NU3034). A mirror that is down fails the restore (NU1301), with no
+      # other source to fall back on. nuget.config, the cache key and every hosted runner's restore are unchanged.
+      # nuget.org's repository certificate (SHA-256 below) rotates rarely and announced: a rotation fails closed here.
+      - name: NuGet through the runner's mirror, nuget.org-signed packages only (self-hosted only)
+        if: runner.environment == 'self-hosted'
+        shell: pwsh
+        run: |
+          $src = "$env:AGENT_BRIDGE_NUGET_SOURCE"
+          if ($src -notmatch '^https://[A-Za-z0-9.-]+/[^\s"<>&]*$') { Write-Host '::error::this self-hosted runner names no https mirror in AGENT_BRIDGE_NUGET_SOURCE, and nuget.org is unreachable from it'; exit 1 }
+          $cfg = Join-Path $env:RUNNER_TEMP 'mirror.nuget.config'
+          @(
+            '<?xml version="1.0" encoding="utf-8"?>', '<configuration>',
+            '  <config><add key="signatureValidationMode" value="require" /></config>',
+            "  <packageSources><clear /><add key=`"mirror`" value=`"$src`" /></packageSources>",
+            '  <fallbackPackageFolders><clear /></fallbackPackageFolders>',
+            '  <trustedSigners><repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">',
+            '    <certificate fingerprint="1F4B311D9ACC115C8DC8018B5A49E00FCE6DA8E2855F9F014CA6F34570BC482D" hashAlgorithm="SHA256" allowUntrustedRoot="false" />',
+            '  </repository></trustedSigners>', '</configuration>') | Set-Content -Encoding utf8 $cfg
+          "RestoreConfigFile=$cfg", "NUGET_MIRROR_CONFIG=$cfg" | Add-Content $env:GITHUB_ENV
