From: SG Quality Lead R8 <danswett@users.noreply.github.com>
Date: Mon, 23 Nov 2026 22:22:01 -0800
Subject: [PATCH] s 6a2

---
 .github/workflows/full.yml                    | 56 ++++++++++++++++++-
 quality/catalog.yml                           |  4 +-
 .../FullWorkflowTests.cs                      | 34 ++++++++++-
 3 files changed, 89 insertions(+), 5 deletions(-)

diff --git a/.github/workflows/full.yml b/.github/workflows/full.yml
index ce1863d7e..ca16cb8cc 100644
--- a/.github/workflows/full.yml
+++ b/.github/workflows/full.yml
@@ -517,11 +517,65 @@ jobs:
           if-no-files-found: error
           retention-days: 30
 
+  app-selftest:
+    # The packed Windows app, started from the publish folder app-pack uploaded in THIS run (the very files packed), in demo mode: it must draw the cards and answer
+    # one (build/app-self-test.ps1 says how the app ended when it did not end well, #240). x64's failure fails the job and holds the release. Arm64 gets one retry
+    # (#2026) and still fails the job when the retry fails too: full-gate waives Arm64's self-test (owner, #2454) and full-red's issue names it, so it is never silent.
+    name: app-selftest (${{ matrix.runtime }})
+    needs: [trigger, app-pack]
+    if: needs.trigger.outputs.ok == 'true'
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - { runtime: win-x64, runner: windows-latest, out: out/app, artifact: agent-bridge-windows }
+          - { runtime: win-arm64, runner: windows-11-arm, out: out/app-arm64, artifact: agent-bridge-windows-arm64 }
+    runs-on: ${{ matrix.runner }}
+    env:
+      APP_VERSION: 0.1.${{ github.event.workflow_run.run_number || inputs.ci_run_number }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ needs.trigger.outputs.sha }}
+          persist-credentials: false
+      - uses: ./.github/actions/arm64-foreground
+        if: matrix.runtime == 'win-arm64'
+      - name: The publish folder app-pack uploaded
+        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          name: ${{ matrix.artifact }}-publish-${{ env.APP_VERSION }}
+          path: ${{ matrix.out }}/publish
+      - name: The published app draws the demo's cards and answers one
+        id: selftest
+        continue-on-error: ${{ matrix.runtime == 'win-arm64' }}
+        shell: pwsh
+        run: ./build/app-self-test.ps1 -Exe ${{ matrix.out }}/publish/AgentBridge.exe -Result "$env:RUNNER_TEMP/selftest/result.json" -TimeoutSeconds 720
+      - uses: ./.github/actions/arm64-foreground
+        if: steps.selftest.outcome == 'failure' && matrix.runtime == 'win-arm64'
+      - name: The published app draws the demo's cards and answers one (win-arm64 retry, #2026)
+        id: selftest-retry
+        if: steps.selftest.outcome == 'failure' && matrix.runtime == 'win-arm64'
+        continue-on-error: true
+        shell: pwsh
+        run: |
+          Write-Output "::warning title=app-selftest (win-arm64)::the self-test failed once; retrying it once (#2026)"
+          ./build/app-self-test.ps1 -Exe ${{ matrix.out }}/publish/AgentBridge.exe -Result "$env:RUNNER_TEMP/selftest-retry/result.json" -TimeoutSeconds 720
+      - name: The win-arm64 self-test passed on retry (flake notice, #2026)
+        if: steps.selftest.outcome == 'failure' && steps.selftest-retry.outcome == 'success'
+        shell: pwsh
+        run: Write-Output "::warning title=app-selftest (win-arm64) flake::the self-test failed once and passed on retry; flake record https://github.com/danswett/agent-bridge/issues/2026"
+      - name: The win-arm64 self-test failed twice
+        if: steps.selftest-retry.outcome == 'failure'
+        shell: pwsh
+        run: |
+          Write-Output "::error title=app-selftest (win-arm64)::the self-test failed on both attempts (#2026)"
+          exit 1
+
   full-gate:
     # The one result for this workflow, as quality-gate is for ci.yml (the catalog check requires this shape): it needs every other
     # job, runs whatever they did, and fails when any ended other than success, a skipped one included, so a FULL run whose lane
     # did not run is no pass. It passes only when the FAST run was not a green push to main, and then says there was nothing to test.
-    needs: [trigger, spikes, spikes-linux, pwa-e2e, pwa-ui, app-pack]
+    needs: [trigger, spikes, spikes-linux, pwa-e2e, pwa-ui, app-pack, app-selftest]
     if: always()
     runs-on: ubuntu-latest
     timeout-minutes: 5
diff --git a/quality/catalog.yml b/quality/catalog.yml
index 6e06c26d4..cce9db049 100644
--- a/quality/catalog.yml
+++ b/quality/catalog.yml
@@ -1258,11 +1258,11 @@ suites:
     ring: 2
     select: always
     # The release train's packages (S2, #4104, piece 6a): FULL publishes, packs (Velopack) and records the installer input and SBOM of the Windows app on both
-    # architectures at the FAST run's version, for the commit that run passed on. Additive: ci.yml's app job still packs and publishes until the cut-over (6b).
+    # architectures at the FAST run's version, for the commit that run passed on, and self-tests the packed publish folder (Arm64 retried once and waived, visibly). Additive: ci.yml's app job still packs and publishes until the cut-over (6b).
     platforms: [win-x64, win-arm64]
     runner: hosted
     command: see full.yml app-pack
-    where: full.yml app-pack
+    where: full.yml app-pack, app-selftest
     lane: full
     status: exists
   # ---------------------------------------------------------------- live, on disposable machines
diff --git a/tests/AgentBridge.Quality.Tests/FullWorkflowTests.cs b/tests/AgentBridge.Quality.Tests/FullWorkflowTests.cs
index 408d84a53..a48142fdb 100644
--- a/tests/AgentBridge.Quality.Tests/FullWorkflowTests.cs
+++ b/tests/AgentBridge.Quality.Tests/FullWorkflowTests.cs
@@ -28,7 +28,7 @@ public class FullWorkflowTests
     [Fact]
     public void Full_yml_has_the_trigger_job_the_spikes_pwa_e2e_and_the_gate_and_ci_yml_no_longer_has_them()
     {
-        Assert.Equal(["app-pack", "full-gate", "pwa-e2e", "pwa-ui", "spikes", "spikes-linux", "trigger"], Jobs("full.yml").Children.Keys.Select(k => k.ToString()).Order(StringComparer.Ordinal));
+        Assert.Equal(["app-pack", "app-selftest", "full-gate", "pwa-e2e", "pwa-ui", "spikes", "spikes-linux", "trigger"], Jobs("full.yml").Children.Keys.Select(k => k.ToString()).Order(StringComparer.Ordinal));
         Assert.DoesNotContain(Jobs("ci.yml").Children.Keys, k => k.ToString().StartsWith("spikes", StringComparison.Ordinal) || k.ToString().StartsWith("pwa-", StringComparison.Ordinal));
     }
 
@@ -80,7 +80,7 @@ public class FullWorkflowTests
         foreach (var (id, job) in jobs.Children.Where(j => j.Key.ToString() is not ("trigger" or "full-gate")))
         {
             var needs = ((YamlMappingNode)job)["needs"];
-            Assert.Equal(["trigger"], needs is YamlSequenceNode many ? many.Children.Select(c => c.ToString()) : [needs.ToString()]);
+            Assert.Contains("trigger", needs is YamlSequenceNode many ? many.Children.Select(c => c.ToString()) : [needs.ToString()]); // a job may also wait for the FULL job it builds on
             Assert.Equal("needs.trigger.outputs.ok == 'true'", Expression(Scalar(job, "if")));
         }
         foreach (var (id, job) in jobs.Children)
@@ -236,4 +236,34 @@ public class FullWorkflowTests
         Assert.DoesNotContain("github.run_number", AllText(job), StringComparison.Ordinal);
         Assert.Contains("-Commit $env:SHA -RunId '${{ github.run_id }}'", AllText(job), StringComparison.Ordinal);
     }
+
+    [Fact]
+    public void App_selftest_runs_this_runs_packed_publish_folder_on_each_architecture_and_retries_Arm64_once()
+    {
+        var job = (YamlMappingNode)Jobs("full.yml")["app-selftest"];
+        var include = ((YamlSequenceNode)((YamlMappingNode)((YamlMappingNode)job["strategy"])["matrix"])["include"]).Children.ToList();
+        var steps = ((YamlSequenceNode)job["steps"]).Children.OfType<YamlMappingNode>().ToList();
+        var download = steps.Single(s => s.Children.ContainsKey("uses") && Scalar(s, "uses").StartsWith("actions/download-artifact@", StringComparison.Ordinal));
+        var packed = ((YamlSequenceNode)((YamlMappingNode)Jobs("full.yml")["app-pack"])["steps"]).Children.OfType<YamlMappingNode>()
+            .Where(s => s.Children.ContainsKey("uses") && Scalar(s, "uses").StartsWith("actions/upload-artifact@", StringComparison.Ordinal)).Select(s => Scalar(s["with"], "name")).ToList();
+        var first = steps.Single(s => s.Children.ContainsKey("id") && Scalar(s, "id") == "selftest");
+        var retry = steps.Single(s => s.Children.ContainsKey("id") && Scalar(s, "id") == "selftest-retry");
+        var twice = steps.Single(s => s.Children.ContainsKey("name") && Scalar(s, "name").Contains("failed twice", StringComparison.Ordinal));
+
+        Assert.Equal(["app-selftest (win-arm64)", "app-selftest (win-x64)"], include.Select(l => $"app-selftest ({Scalar(l, "runtime")})").Order(StringComparer.Ordinal));
+        Assert.Equal(["app-pack", "trigger"], (job["needs"] is YamlSequenceNode n ? n.Children.Select(c => c.ToString()) : [job["needs"].ToString()]).Order(StringComparer.Ordinal));
+        // The folder app-pack uploaded in THIS run, by the same name: no run-id, so it is never another run's bytes.
+        Assert.Contains(Scalar(download["with"], "name"), packed);
+        Assert.False(((YamlMappingNode)download["with"]).Children.ContainsKey("run-id"));
+        // x64's first failure fails the job; Arm64 gets one retry (#2026) and the job still fails if the retry fails too (full-gate waives it, visibly).
+        foreach (var (runtime, retried) in new[] { ("win-x64", false), ("win-arm64", true) })
+        {
+            var ctx = new Dictionary<string, string?> { ["matrix.runtime"] = runtime, ["steps.selftest.outcome"] = "failure", ["steps.selftest-retry.outcome"] = retried ? "failure" : "skipped" };
+            Assert.Equal(retried, MergeRuleTests.IfExpression.Value(Expression(Scalar(first, "continue-on-error")), ctx) is true);
+            Assert.Equal(retried, MergeRuleTests.IfExpression.Evaluate(Expression(Scalar(retry, "if")), ctx));
+            Assert.Equal(retried, MergeRuleTests.IfExpression.Evaluate(Expression(Scalar(twice, "if")), ctx));
+        }
+        Assert.Equal("true", Scalar(retry, "continue-on-error"));
+        Assert.Contains("exit 1", Scalar(twice, "run"), StringComparison.Ordinal);
+    }
 }
