diff --git a/tests/AgentBridge.Quality.Tests/ReleaseTrainWorkflowTests.cs b/tests/AgentBridge.Quality.Tests/ReleaseTrainWorkflowTests.cs
new file mode 100644
index 0000000..20f81b0
--- /dev/null
+++ b/tests/AgentBridge.Quality.Tests/ReleaseTrainWorkflowTests.cs
@@ -0,0 +1,69 @@
+using AgentBridge.Quality;
+using Xunit;
+
+// The release train's verify job (.github/workflows/release-train.yml): the owner's rule is that Arm64 jobs never
+// gate the train, though both packages are still required; the Arm64 installed-app self-test only records unless
+// the repository variable TRAIN_ARM64_SELFTEST_GATES is exactly true. x64's self-test and every package check
+// stay required on both architectures.
+public sealed class ReleaseTrainWorkflowTests
+{
+    const string Switch = "TRAIN_ARM64_SELFTEST_GATES";
+
+    static string Workflow() => File.ReadAllText(Path.Combine(ChangedFiles.RepoRoot(AppContext.BaseDirectory), ".github", "workflows", "release-train.yml"))
+        .ReplaceLineEndings("\n");
+
+    static string Job(string text, string id)
+    {
+        var start = text.IndexOf($"\n  {id}:\n", StringComparison.Ordinal);
+        Assert.True(start >= 0, $"job {id} is missing");
+        var next = System.Text.RegularExpressions.Regex.Match(text[(start + 1)..], "\n  [a-z-]+:\n");
+        return next.Success ? text[start..(start + 1 + next.Index)] : text[start..];
+    }
+    static string Step(string job, string name)
+    {
+        var marker = $"      - name: {name}\n";
+        var start = job.IndexOf(marker, StringComparison.Ordinal);
+        Assert.True(start >= 0, $"step '{name}' is missing");
+        var next = job.IndexOf("\n      - ", start + marker.Length, StringComparison.Ordinal);
+        return next < 0 ? job[start..] : job[start..next];
+    }
+
+    [Fact]
+    public void The_arm64_installed_app_self_test_only_records_unless_the_switch_is_true_and_x64s_is_always_required()
+    {
+        var verify = Job(Workflow(), "verify");
+        var selfTest = Step(verify, "The installed app self-tests");
+
+        Assert.Contains($"continue-on-error: ${{{{ matrix.runtime == 'win-arm64' && vars.{Switch} != 'true' }}}}", selfTest, StringComparison.Ordinal);
+        // The only way to exempt a leg is that expression: it is false for x64 whatever the variable says.
+        Assert.Single(System.Text.RegularExpressions.Regex.Matches(verify, "continue-on-error"));
+    }
+
+    [Theory]
+    [InlineData("The picked run's release files, byte for byte")]
+    [InlineData("The picked run's installer input")]
+    [InlineData("Refuse missing, foreign or altered installer input before running it")]
+    [InlineData("The package installs per user into its own channel and the manifest is its channel's")]
+    public void Both_architectures_keep_the_package_presence_hash_and_manifest_checks_required(string step)
+    {
+        Assert.DoesNotContain("continue-on-error", Step(Job(Workflow(), "verify"), step), StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void A_red_arm64_self_test_is_recorded_in_the_summary_and_a_warning_names_it()
+    {
+        var record = Step(Job(Workflow(), "verify"), "Record the self-test result");
+
+        Assert.Contains("GITHUB_STEP_SUMMARY", record, StringComparison.Ordinal);
+        Assert.Contains("::warning title=release train::", record, StringComparison.Ordinal);
+        Assert.Contains($"vars.{Switch}", record, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void Publish_still_needs_the_whole_verify_job_so_a_required_check_failing_publishes_nothing()
+    {
+        var publish = Job(Workflow(), "publish");
+
+        Assert.Contains("needs: [pick, verify]", publish, StringComparison.Ordinal);
+    }
+}
