diff --git a/.github/workflows/release-train.yml b/.github/workflows/release-train.yml
new file mode 100644
index 0000000..ea2452d
--- /dev/null
+++ b/.github/workflows/release-train.yml
@@ -0,0 +1,331 @@
+name: Release train
+
+# Publishes the newest main commit whose CI passed whole, hourly or by hand, apart from merging
+# (docs/app-windows.md, "The release train"). Merges never block it, and it never publishes an
+# unverified commit or one older than the latest release: build/select-release-commit.ps1 picks,
+# build/publish-prerelease.ps1 still refuses a duplicate or older version, in the same
+# concurrency group as ci.yml's publish job. Nothing new is a no-op.
+on:
+  schedule:
+    - cron: '17 * * * *'
+  workflow_dispatch:
+    inputs:
+      dry_run:
+        description: 'Dry run: pick and verify only, with no publish, Beta manifest or CDN purge'
+        type: boolean
+        default: false
+
+concurrency:
+  group: release-train
+  cancel-in-progress: false
+
+permissions:
+  contents: read
+
+env:
+  # Unset today, so the train publishes unsigned like ci.yml; once true it refuses (no sign step yet).
+  APP_SIGNING: ${{ vars.APP_SIGNING }}
+
+jobs:
+  pick:
+    name: Pick the newest verified commit
+    # Reads only: it lists runs and releases and writes nothing.
+    if: github.repository == 'danswett/agent-bridge' && github.ref == 'refs/heads/main'
+    runs-on: windows-latest
+    timeout-minutes: 15
+    permissions:
+      contents: read
+      actions: read # list main's CI runs, jobs and artifacts
+    outputs:
+      sha: ${{ steps.pick.outputs.sha }}
+      version: ${{ steps.pick.outputs.version }}
+      run: ${{ steps.pick.outputs.run }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+      - name: Pick the commit
+        id: pick
+        shell: pwsh
+        env:
+          GH_TOKEN: ${{ github.token }}
+          REPOSITORY: ${{ github.repository }}
+        run: |
+          . ./build/select-release-commit.ps1
+          Assert-TrainMayPublish $env:APP_SIGNING
+          $repo = $env:REPOSITORY
+          $latest = Invoke-ReleaseGh api "repos/$repo/releases?per_page=100" --paginate --jq '.[] | select(.draft == false) | .tag_name' |
+            Where-Object { $_ -cmatch '^v\d+\.\d+\.\d+$' } | Sort-Object { [semver]$_.Substring(1) } -Descending | Select-Object -First 1
+          $release = if ($latest) { [pscustomobject]@{ Tag = $latest; Commit = (Invoke-ReleaseGh api "repos/$repo/git/ref/tags/$latest" --jq '.object.sha') } }
+          $pick = Select-ReleaseCommit -Runs (Get-ReleaseRuns $repo) -Latest $release -IsDescendant { param($sha, $base) (Invoke-ReleaseGh api "repos/$repo/compare/$base...$sha" --jq '.status') -in 'ahead' }
+          if (-not $pick) { Write-Host 'nothing new to publish'; exit 0 }
+          "sha=$($pick.Sha)", "version=$($pick.Version)", "run=$($pick.Id)" | Add-Content $env:GITHUB_OUTPUT
+
+  verify:
+    name: Install and self-test the exact CI bytes (${{ matrix.runtime }})
+    # The train publishes what CI built, never a rebuild; before it does, each architecture's package is
+    # installed per user and the installed app self-tested, as CI's app-installer job does. Any failure
+    # here means publish is skipped (it needs this job) and the alert job below fails the run.
+    needs: [pick]
+    if: needs.pick.outputs.sha != ''
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - runtime: win-x64
+            runner: windows-latest
+            out: out/app
+            artifact: agent-bridge-windows
+          - runtime: win-arm64
+            runner: windows-11-arm
+            out: out/app-arm64
+            artifact: agent-bridge-windows-arm64
+    runs-on: ${{ matrix.runner }}
+    timeout-minutes: 40
+    permissions:
+      contents: read
+      actions: read # download the picked run's artifacts
+    env:
+      APP_VERSION: ${{ needs.pick.outputs.version }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ needs.pick.outputs.sha }}
+          persist-credentials: false
+      - uses: ./.github/actions/arm64-foreground
+        if: matrix.runtime == 'win-arm64'
+      - name: The picked run's release files, byte for byte
+        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          name: ${{ matrix.artifact }}-${{ needs.pick.outputs.version }}
+          path: ${{ matrix.out }}/releases
+          run-id: ${{ needs.pick.outputs.run }}
+          github-token: ${{ github.token }}
+      - name: The picked run's installer input
+        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          name: ${{ matrix.artifact }}-installer-input-${{ needs.pick.outputs.version }}
+          path: ${{ runner.temp }}/installer-input
+          run-id: ${{ needs.pick.outputs.run }}
+          github-token: ${{ github.token }}
+      - name: Refuse missing, foreign or altered installer input before running it
+        shell: pwsh
+        env:
+          RUNTIME: ${{ matrix.runtime }}
+          OUT: ${{ matrix.out }}
+          SHA: ${{ needs.pick.outputs.sha }}
+          RUN_ID: ${{ needs.pick.outputs.run }}
+        run: |
+          . ./build/app-installer-input.ps1
+          Assert-AppInstallerInput -InputPath "$env:RUNNER_TEMP/installer-input" -Releases "$env:OUT/releases" -Version $env:APP_VERSION -Runtime $env:RUNTIME -Commit $env:SHA -RunId $env:RUN_ID | Tee-Object -FilePath $env:GITHUB_STEP_SUMMARY -Append
+      - name: The package installs per user into its own channel and the manifest is its channel's
+        shell: pwsh
+        env:
+          RUNTIME: ${{ matrix.runtime }}
+          OUT: ${{ matrix.out }}
+        run: |
+          . ./build/app-channels.ps1
+          $target = Get-AppChannel $env:RUNTIME
+          $setup = Join-Path "$env:OUT/releases" (Get-AppAssetName $target.Channel 'Installer' $env:APP_VERSION)
+          $logs = "$env:RUNNER_TEMP/selftest/installed"
+          New-Item -ItemType Directory -Force $logs | Out-Null
+          $p = Start-Process $setup -ArgumentList '--silent', '--log', "$logs/setup.log" -PassThru
+          if (-not $p.WaitForExit(300000)) { Stop-Process -Id $p.Id; Write-Error 'Setup did not finish'; exit 1 }
+          if ($p.ExitCode) { Get-Content "$logs/setup.log" -ErrorAction SilentlyContinue; Write-Error "Setup exited with $($p.ExitCode)"; exit 1 }
+          $root = "$env:LOCALAPPDATA/AgentBridgeApp"
+          $manifest = Get-Content "$root/current/sq.version" -Raw
+          if ($manifest -notmatch "<channel>$([regex]::Escape($target.Channel))</channel>") { Write-Error "installed into another channel than $($target.Channel)"; exit 1 }
+      # The installed app's self-test. x64's is required. Arm64's only records (owner and Quality: Arm64 jobs
+      # never gate the train, though the Arm64 package, its hash and its manifest above stay required) unless
+      # the repository variable TRAIN_ARM64_SELFTEST_GATES is exactly true, which makes a red Arm64 self-test
+      # hold the release. Unset is the default: not blocking.
+      - name: The installed app self-tests
+        id: selftest
+        continue-on-error: ${{ matrix.runtime == 'win-arm64' && vars.TRAIN_ARM64_SELFTEST_GATES != 'true' }}
+        shell: pwsh
+        run: |
+          $root = "$env:LOCALAPPDATA/AgentBridgeApp"
+          $logs = "$env:RUNNER_TEMP/selftest/installed"
+          ./build/app-self-test.ps1 -Exe "$root/current/AgentBridge.exe" -Result "$logs/result.json" -TimeoutSeconds 720
+          exit $LASTEXITCODE
+      - name: Record the self-test result
+        if: always() && steps.selftest.outcome != 'skipped'
+        shell: bash
+        env:
+          RUNTIME: ${{ matrix.runtime }}
+          OUTCOME: ${{ steps.selftest.outcome }}
+          GATES: ${{ vars.TRAIN_ARM64_SELFTEST_GATES }}
+        run: |
+          gating="required"
+          if [ "$RUNTIME" = "win-arm64" ]; then
+            if [ "${GATES,,}" = "true" ]; then gating="gating (TRAIN_ARM64_SELFTEST_GATES is true)"; else gating="recorded, not gating (TRAIN_ARM64_SELFTEST_GATES is not true)"; fi
+          fi
+          echo "### Release train: $RUNTIME installed-app self-test: $OUTCOME; $gating" >> "$GITHUB_STEP_SUMMARY"
+          if [ "$OUTCOME" = "failure" ] && [ "$RUNTIME" = "win-arm64" ] && [ "${GATES,,}" != "true" ]; then
+            echo "::warning title=release train::the Arm64 installed-app self-test failed; it is recorded and does not hold the release"
+          fi
+
+  alert:
+    name: Alert when verification fails
+    # Verification failing means nothing was published: this job fails the run with a named error so a
+    # red train run is the alert (no other channel is wired here).
+    needs: [pick, verify]
+    if: always() && needs.verify.result == 'failure'
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    permissions: {}
+    steps:
+      - name: Nothing was published
+        env:
+          SHA: ${{ needs.pick.outputs.sha }}
+          RUN_ID: ${{ needs.pick.outputs.run }}
+        run: |
+          echo "::error title=release train::verification of CI run $RUN_ID (commit $SHA) failed; nothing was published"
+          echo "### Release train: verification failed, nothing published ($SHA, CI run $RUN_ID)" >> "$GITHUB_STEP_SUMMARY"
+          exit 1
+
+  publish:
+    name: Publish the picked commit
+    # contents: write is here only, and only for a verified pick. APP_SIGNING true never gets here: the
+    # pick job fails first. A failed verification skips this job (it needs verify to succeed).
+    needs: [pick, verify]
+    # A dry run (workflow_dispatch input) stops after verify: nothing is published, no manifest, no purge.
+    if: needs.pick.outputs.sha != '' && !inputs.dry_run
+    runs-on: windows-latest
+    timeout-minutes: 30
+    permissions:
+      contents: write # create the release and its tag (the only job that writes)
+      actions: read # download the picked run's artifacts
+    concurrency:
+      group: publish-prerelease
+      cancel-in-progress: false
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ needs.pick.outputs.sha }}
+          fetch-depth: 0
+          persist-credentials: false
+      - uses: actions/setup-dotnet@0f4a354dd5547a28c70b7853dbd95d5b67886e73 # v6.1.0
+        with:
+          dotnet-version: '10.0.x'
+      - run: dotnet tool install -g vpk --version 1.2.161
+      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          name: agent-bridge-windows-${{ needs.pick.outputs.version }}
+          path: out/app/releases
+          run-id: ${{ needs.pick.outputs.run }}
+          github-token: ${{ github.token }}
+      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          name: agent-bridge-windows-arm64-${{ needs.pick.outputs.version }}
+          path: out/app-arm64/releases
+          run-id: ${{ needs.pick.outputs.run }}
+          github-token: ${{ github.token }}
+      - name: Publish the pre-release
+        id: publish
+        shell: pwsh
+        env:
+          GH_TOKEN: ${{ github.token }}
+          REPOSITORY: ${{ github.repository }}
+          VERSION: ${{ needs.pick.outputs.version }}
+          SHA: ${{ needs.pick.outputs.sha }}
+        run: |
+          # -MainHead is the chosen commit and this checkout is a clone at it. The train publishes
+          # the newest passed commit, so ci.yml publish's stand-aside for a later app change does
+          # not apply (publish-prerelease.ps1 skips it when MainHead is the commit, and then reads
+          # nothing from -MainRepo); a duplicate, an older version or a commit behind the latest
+          # release is still refused.
+          ./build/publish-prerelease.ps1 -Version $env:VERSION -ReleasesDir out/app/releases, out/app-arm64/releases -Repository $env:REPOSITORY -Commit $env:SHA -MainHead $env:SHA -MainRepo .
+      - name: Publish the static Beta download manifest
+        # Ported from ci.yml's publish job (owner decision A): the manifest names the release this run published.
+        if: steps.publish.outputs.manifest-tag != ''
+        shell: pwsh
+        env:
+          GH_TOKEN: ${{ github.token }}
+          REPOSITORY: ${{ github.repository }}
+          MANIFEST_TAG: ${{ steps.publish.outputs.manifest-tag }}
+        run: |
+          $json = gh api "repos/$env:REPOSITORY/releases/tags/$env:MANIFEST_TAG"
+          if ($LASTEXITCODE) { throw "couldn't read the published Beta metadata ($LASTEXITCODE)" }
+          $json | Set-Content out/beta-release-input.json -Encoding utf8NoBOM
+          ./build/release-manifest.ps1 -ReleaseJson out/beta-release-input.json -Repository $env:REPOSITORY -Out out/beta-release.json -Publish
+
+  purge:
+    name: Refresh the release-list CDN
+    # After a release is published, purge the relay's list pages by URL and check the relay serves the new
+    # release (#3870 option A; the Worker's zone-keyed cache key is #3880). Failing loudly here never
+    # unpublishes anything: the release is out, the relay is just not yet showing it.
+    needs: [pick, publish]
+    if: needs.publish.result == 'success'
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    # Main only; holds the secret CF_PURGE_TOKEN (Cloudflare Cache Purge on the slipgates.com zone, nothing
+    # else) and the variable CF_ZONE_ID, set in GitHub settings, never typed in a terminal.
+    environment: release-purge
+    permissions: {}
+    steps:
+      - name: Purge the list pages by URL, then check the relay serves the published release
+        shell: pwsh
+        env:
+          CF_PURGE_TOKEN: ${{ secrets.CF_PURGE_TOKEN }}
+          CF_ZONE_ID: ${{ vars.CF_ZONE_ID }}
+          TAG: v${{ needs.pick.outputs.version }}
+        run: |
+          $ErrorActionPreference = 'Stop'
+          if (-not $env:CF_PURGE_TOKEN -or -not $env:CF_ZONE_ID) { throw 'CF_PURGE_TOKEN or CF_ZONE_ID is not set in the release-purge environment' }
+          # The public zone URLs the Worker keys its cache on: the page clients read (first ten) and the
+          # larger page older clients still ask for.
+          $base = 'https://releases.slipgates.com/repos/danswett/agent-bridge/releases'
+          $urls = @("${base}?per_page=10&page=1", "${base}?per_page=100&page=1")
+          $headers = @{ Authorization = "Bearer $env:CF_PURGE_TOKEN" }
+          $body = @{ files = $urls } | ConvertTo-Json -Compress
+          $answer = Invoke-RestMethod -Method Post -Uri "https://api.cloudflare.com/client/v4/zones/$env:CF_ZONE_ID/purge_cache" -Headers $headers -ContentType 'application/json' -Body $body
+          if (-not $answer.success) { throw "Cloudflare refused the purge: $(($answer.errors | ForEach-Object { $_.message }) -join '; ')" }
+          Write-Host "purged $($urls.Count) URLs"
+          # Re-fetch until both pages name the published tag with a fresh copy, within a minute.
+          $stale = $null
+          foreach ($attempt in 1..6) {
+            $stale = $null
+            foreach ($url in $urls) {
+              $response = Invoke-WebRequest -Uri $url -Headers @{ Accept = 'application/vnd.github+json' } -SkipHttpErrorCheck
+              $age = [int](@($response.Headers['Age'])[0] ?? -1)
+              $tags = if ($response.StatusCode -eq 200) { @(($response.Content | ConvertFrom-Json) | ForEach-Object { $_.tag_name }) } else { @() }
+              if ($response.StatusCode -ne 200) { $stale = "$url answered $($response.StatusCode)" }
+              elseif ($tags -cnotcontains $env:TAG) { $stale = "$url does not list $env:TAG yet (Age $age)" }
+              elseif ($age -lt 0 -or $age -gt 120) { $stale = "$url lists $env:TAG but its copy is $age seconds old" }
+            }
+            if (-not $stale) { break }
+            Start-Sleep -Seconds 10
+          }
+          if ($stale) {
+            Write-Host "::error title=release train::the relay is still stale after the purge: $stale. The release is published; the CDN list was not refreshed."
+            exit 1
+          }
+          Write-Host "the relay serves $env:TAG"
+
+  dry-run-report:
+    name: Dry run report
+    # Only for a dry run: says what the train would have published and whether verification passed.
+    needs: [pick, verify]
+    if: always() && inputs.dry_run
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    permissions: {}
+    steps:
+      - name: What a real run would do
+        env:
+          SHA: ${{ needs.pick.outputs.sha }}
+          VERSION: ${{ needs.pick.outputs.version }}
+          RUN_ID: ${{ needs.pick.outputs.run }}
+          VERIFY: ${{ needs.verify.result }}
+        run: |
+          if [ -z "$SHA" ]; then
+            echo "### Release train dry run: nothing to publish (no new verified commit)" >> "$GITHUB_STEP_SUMMARY"
+            exit 0
+          fi
+          echo "### Release train dry run: would publish v$VERSION (commit $SHA, CI run $RUN_ID); verification: $VERIFY" >> "$GITHUB_STEP_SUMMARY"
+          if [ "$VERIFY" != "success" ]; then
+            echo "::error title=release train dry run::verification would fail: nothing would be published"
+            exit 1
+          fi
