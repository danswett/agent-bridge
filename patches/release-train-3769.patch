diff --git a/.github/workflows/release-train.yml b/.github/workflows/release-train.yml
new file mode 100644
index 0000000..fb5073b
--- /dev/null
+++ b/.github/workflows/release-train.yml
@@ -0,0 +1,80 @@
+name: Release train
+
+# Publishes the newest main commit whose CI passed whole, hourly or by hand, apart from merging
+# (docs/app-windows.md, "The release train"). Merges never block it, and it never publishes an
+# unverified commit or one older than the latest release: build/select-release-commit.ps1 picks,
+# build/publish-prerelease.ps1 still refuses a duplicate or older version, in the same
+# concurrency group as ci.yml's publish job. Nothing new is a no-op.
+on:
+  schedule:
+    - cron: '17 * * * *'
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+env:
+  # Unset today, so the train publishes unsigned like ci.yml; once true it refuses (no sign step yet).
+  APP_SIGNING: ${{ vars.APP_SIGNING }}
+
+jobs:
+  train:
+    if: github.repository == 'danswett/agent-bridge' && github.ref == 'refs/heads/main'
+    runs-on: windows-latest
+    timeout-minutes: 30
+    permissions:
+      contents: write
+      actions: read
+    concurrency:
+      group: publish-prerelease
+      cancel-in-progress: false
+      queue: max
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+      - name: Pick the commit
+        id: pick
+        shell: pwsh
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          . ./build/select-release-commit.ps1
+          Assert-TrainMayPublish $env:APP_SIGNING
+          $repo = '${{ github.repository }}'
+          $latest = gh api "repos/$repo/releases?per_page=100" --paginate --jq '.[] | select(.draft == false) | .tag_name' |
+            Where-Object { $_ -cmatch '^v\d+\.\d+\.\d+$' } | Sort-Object { [semver]$_.Substring(1) } -Descending | Select-Object -First 1
+          $release = if ($latest) { [pscustomobject]@{ Tag = $latest; Commit = (gh api "repos/$repo/git/ref/tags/$latest" --jq '.object.sha') } }
+          $pick = Select-ReleaseCommit -Runs (Get-ReleaseRuns $repo) -Latest $release -IsDescendant { param($sha, $base) (gh api "repos/$repo/compare/$base...$sha" --jq '.status') -in 'ahead' }
+          if (-not $pick) { Write-Host 'nothing new to publish'; exit 0 }
+          "sha=$($pick.Sha)", "version=0.1.$($pick.Number)", "run=$($pick.Id)" | Add-Content $env:GITHUB_OUTPUT
+      - if: steps.pick.outputs.sha != ''
+        uses: actions/setup-dotnet@0f4a354dd5547a28c70b7853dbd95d5b67886e73 # v6.1.0
+        with:
+          dotnet-version: '10.0.x'
+      - if: steps.pick.outputs.sha != ''
+        run: dotnet tool install -g vpk --version 1.2.161
+      - if: steps.pick.outputs.sha != ''
+        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          name: agent-bridge-windows-${{ steps.pick.outputs.version }}
+          path: out/app/releases
+          run-id: ${{ steps.pick.outputs.run }}
+          github-token: ${{ github.token }}
+      - if: steps.pick.outputs.sha != ''
+        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          name: agent-bridge-windows-arm64-${{ steps.pick.outputs.version }}
+          path: out/app-arm64/releases
+          run-id: ${{ steps.pick.outputs.run }}
+          github-token: ${{ github.token }}
+      - name: Publish the pre-release
+        if: steps.pick.outputs.sha != ''
+        shell: pwsh
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          # -MainHead is the chosen commit itself: the train publishes the newest passed commit,
+          # so the stand-aside for a later app change (ci.yml publish's) does not apply.
+          ./build/publish-prerelease.ps1 -Version '${{ steps.pick.outputs.version }}' -ReleasesDir out/app/releases, out/app-arm64/releases -Repository '${{ github.repository }}' -Commit '${{ steps.pick.outputs.sha }}' -MainHead '${{ steps.pick.outputs.sha }}' -MainRepo .
