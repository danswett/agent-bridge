diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 2ab972da..ab87cbf6 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -1576,9 +1576,10 @@ jobs:
   pwa-ui:
     # The product PWA in Chromium and WebKit against the published build (with its CSP), in demo
     # mode. Split over runners (#457): one run of every spec took 11 to 16 minutes on one, and set
-    # the wall time of every PWA change. Both browsers now have three
-    # shards. Playwright's --shard splits what --project selects, so together the six run every
-    # spec in both browsers. Chromium is split by test with --fully-parallel like WebKit.
+    # the wall time of every PWA change. Chromium has three shards and WebKit four: by one main
+    # run's times (#2454), three WebKit shards ran 11.0, 7.9 and 11.6 minutes, four by count come
+    # to at most about 8.8. Playwright's --shard splits what --project selects, so together the
+    # seven run every spec in both browsers. Chromium is split by test with --fully-parallel like WebKit.
     # By file, the first WebKit shard got axe, delegates and answer, and ran 5 minutes to the others'
     # 2 (no spec shares state between its tests; each has its own page). Two workers, as before: a
     # third made WebKit slower on these 4-CPU runners, not faster. test/e2e is pwa-e2e's
@@ -1593,7 +1594,7 @@ jobs:
         include: >-
           ${{ fromJSON(format('[{0}{1}]',
           '{"name":"chromium 1/3","project":"chromium","shard":"1/3","renders":true},{"name":"chromium 2/3","project":"chromium","shard":"2/3"},{"name":"chromium 3/3","project":"chromium","shard":"3/3"}',
-          github.event_name != 'pull_request' && ',{"name":"webkit 1/3","project":"webkit","shard":"1/3"},{"name":"webkit 2/3","project":"webkit","shard":"2/3"},{"name":"webkit 3/3","project":"webkit","shard":"3/3"}' || '')) }}
+          github.event_name != 'pull_request' && ',{"name":"webkit 1/4","project":"webkit","shard":"1/4"},{"name":"webkit 2/4","project":"webkit","shard":"2/4"},{"name":"webkit 3/4","project":"webkit","shard":"3/4"},{"name":"webkit 4/4","project":"webkit","shard":"4/4"}' || '')) }}
     runs-on: ubuntu-24.04
     # 35 minutes for every leg, as for every job that runs `playwright install --with-deps`
     # (#689). WebKit needs 181 system packages (114 MB), and on main run 41927187905 a slow apt
