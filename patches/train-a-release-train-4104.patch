diff --git a/.github/workflows/release-train.yml b/.github/workflows/release-train.yml
new file mode 100644
index 000000000..b853eeff0
--- /dev/null
+++ b/.github/workflows/release-train.yml
@@ -0,0 +1,238 @@
+name: Release train
+
+# Publishes the newest main commit whose FAST lane (ci.yml) and FULL lane (full.yml) both passed, hourly or by hand, apart from merging
+# (docs/app-windows.md, "The release train"; S2, #4104). It never rebuilds: it installs and self-tests FULL's exact packages, then publishes them. It never
+# publishes an unverified commit or one older than the latest release (build/select-release-commit.ps1 picks; build/publish-prerelease.ps1 refuses a duplicate or
+# older version, in ci.yml's publish group). Only while the repository variable TRAIN_LIVE is exactly true, and never on a dry run: otherwise it picks and
+# verifies only, so the train can soak on FULL's real packages before it is switched on.
+on:
+  schedule:
+    - cron: '17 * * * *'
+  workflow_dispatch:
+    inputs:
+      dry_run:
+        description: 'Dry run: pick, verify and report only. Nothing is published, whatever TRAIN_LIVE says'
+        type: boolean
+        default: false
+
+concurrency:
+  group: release-train
+  cancel-in-progress: false
+
+permissions:
+  contents: read
+
+env:
+  # Unset today, so the train publishes unsigned like ci.yml; once true it refuses (no sign step yet).
+  APP_SIGNING: ${{ vars.APP_SIGNING }}
+
+jobs:
+  pick:
+    name: Pick the newest verified commit
+    if: github.repository == 'danswett/agent-bridge' && github.ref == 'refs/heads/main'
+    runs-on: windows-latest
+    timeout-minutes: 15
+    permissions:
+      contents: read
+      actions: read # list main's CI and Full runs, jobs and artifacts
+    outputs:
+      sha: ${{ steps.pick.outputs.sha }}
+      version: ${{ steps.pick.outputs.version }}
+      # The FAST run's id and number (the version's last part), and the FULL run's id: FULL built the packages, so every download reads it.
+      run: ${{ steps.pick.outputs.run }}
+      number: ${{ steps.pick.outputs.number }}
+      full-run: ${{ steps.pick.outputs.full-run }}
+      # The Arm64 results the owner waived, for the publish summary; empty when nothing was waived.
+      waived: ${{ steps.pick.outputs.waived }}
+      live: ${{ vars.TRAIN_LIVE == 'true' && !inputs.dry_run }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+      - name: Pick the commit
+        id: pick
+        shell: pwsh
+        env:
+          GH_TOKEN: ${{ github.token }}
+          REPOSITORY: ${{ github.repository }}
+        run: |
+          . ./build/select-release-commit.ps1
+          Assert-TrainMayPublish $env:APP_SIGNING
+          $repo = $env:REPOSITORY
+          $latest = Invoke-ReleaseGh api "repos/$repo/releases?per_page=100" --paginate --jq '.[] | select(.draft == false) | .tag_name' |
+            Where-Object { $_ -cmatch '^v\d+\.\d+\.\d+$' } | Sort-Object { [semver]$_.Substring(1) } -Descending | Select-Object -First 1
+          $release = if ($latest) { [pscustomobject]@{ Tag = $latest; Commit = (Invoke-ReleaseGh api "repos/$repo/git/ref/tags/$latest" --jq '.object.sha') } }
+          $pick = Select-ReleaseCommit -Runs (Get-ReleaseRuns $repo) -Latest $release -IsDescendant { param($sha, $base) (Invoke-ReleaseGh api "repos/$repo/compare/$base...$sha" --jq '.status') -in 'ahead' }
+          if (-not $pick) { Write-Host 'nothing new to publish'; exit 0 }
+          Get-PickOutputs $pick | Add-Content $env:GITHUB_OUTPUT
+
+  verify:
+    name: Install and self-test the exact FULL bytes (${{ matrix.runtime }})
+    # The train publishes what FULL built, never a rebuild; before it does, each architecture's package is installed per user and the installed app
+    # self-tested, as FULL's app-installer job does. A failure that gates turns the run red and skips publish (it needs this job).
+    needs: [pick]
+    if: needs.pick.outputs.sha != ''
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - runtime: win-x64
+            runner: windows-latest
+            out: out/app
+            artifact: agent-bridge-windows
+          - runtime: win-arm64
+            runner: windows-11-arm
+            out: out/app-arm64
+            artifact: agent-bridge-windows-arm64
+    runs-on: ${{ matrix.runner }}
+    timeout-minutes: 40
+    permissions:
+      contents: read
+      actions: read # download the FULL run's artifacts
+    env:
+      APP_VERSION: ${{ needs.pick.outputs.version }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ needs.pick.outputs.sha }}
+          persist-credentials: false
+      - uses: ./.github/actions/arm64-foreground
+        if: matrix.runtime == 'win-arm64'
+      - name: The FULL run's release files, byte for byte
+        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          name: ${{ matrix.artifact }}-${{ needs.pick.outputs.version }}
+          path: ${{ matrix.out }}/releases
+          run-id: ${{ needs.pick.outputs.full-run }}
+          github-token: ${{ github.token }}
+      - name: The FULL run's installer input
+        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          name: ${{ matrix.artifact }}-installer-input-${{ needs.pick.outputs.version }}
+          path: ${{ runner.temp }}/installer-input
+          run-id: ${{ needs.pick.outputs.full-run }}
+          github-token: ${{ github.token }}
+      # Required on both architectures: the package is never optional, and its hash and provenance are checked against the commit and the FULL run.
+      - name: Refuse missing, foreign or altered installer input before running it
+        shell: pwsh
+        env:
+          RUNTIME: ${{ matrix.runtime }}
+          OUT: ${{ matrix.out }}
+          SHA: ${{ needs.pick.outputs.sha }}
+          RUN_ID: ${{ needs.pick.outputs.full-run }}
+        run: |
+          . ./build/app-installer-input.ps1
+          Assert-AppInstallerInput -InputPath "$env:RUNNER_TEMP/installer-input" -Releases "$env:OUT/releases" -Version $env:APP_VERSION -Runtime $env:RUNTIME -Commit $env:SHA -RunId $env:RUN_ID | Tee-Object -FilePath $env:GITHUB_STEP_SUMMARY -Append
+      # What RUNS the app on Arm64 is waived (owner, #2454): the install and self-test below only record there. x64's are required, as is the check above.
+      - name: The package installs per user into its own channel and the manifest is its channel's
+        id: install
+        continue-on-error: ${{ matrix.runtime == 'win-arm64' }}
+        shell: pwsh
+        env:
+          RUNTIME: ${{ matrix.runtime }}
+          OUT: ${{ matrix.out }}
+        run: |
+          . ./build/app-channels.ps1
+          $target = Get-AppChannel $env:RUNTIME
+          $setup = Join-Path "$env:OUT/releases" (Get-AppAssetName $target.Channel 'Installer' $env:APP_VERSION)
+          $logs = "$env:RUNNER_TEMP/selftest/installed"
+          New-Item -ItemType Directory -Force $logs | Out-Null
+          $p = Start-Process $setup -ArgumentList '--silent', '--log', "$logs/setup.log" -PassThru
+          if (-not $p.WaitForExit(300000)) { Stop-Process -Id $p.Id; Write-Error 'Setup did not finish'; exit 1 }
+          if ($p.ExitCode) { Get-Content "$logs/setup.log" -ErrorAction SilentlyContinue; Write-Error "Setup exited with $($p.ExitCode)"; exit 1 }
+          $root = "$env:LOCALAPPDATA/AgentBridgeApp"
+          $manifest = Get-Content "$root/current/sq.version" -Raw
+          if ($manifest -notmatch "<channel>$([regex]::Escape($target.Channel))</channel>") { Write-Error "installed into another channel than $($target.Channel)"; exit 1 }
+      - name: The installed app self-tests
+        id: selftest
+        continue-on-error: ${{ matrix.runtime == 'win-arm64' }}
+        shell: pwsh
+        run: |
+          $root = "$env:LOCALAPPDATA/AgentBridgeApp"
+          $logs = "$env:RUNNER_TEMP/selftest/installed"
+          ./build/app-self-test.ps1 -Exe "$root/current/AgentBridge.exe" -Result "$logs/result.json" -TimeoutSeconds 720
+          exit $LASTEXITCODE
+      - name: Record the install and self-test result
+        if: always() && steps.install.outcome != 'skipped'
+        shell: bash
+        env:
+          RUNTIME: ${{ matrix.runtime }}
+          INSTALL: ${{ steps.install.outcome }}
+          SELFTEST: ${{ steps.selftest.outcome }}
+        run: |
+          how="required"
+          if [ "$RUNTIME" = "win-arm64" ]; then how="recorded, not gating (waived)"; fi
+          echo "### Release train: $RUNTIME install $INSTALL, installed-app self-test $SELFTEST; $how" >> "$GITHUB_STEP_SUMMARY"
+
+  publish:
+    name: Publish the picked commit
+    # contents: write is here only, and only for a verified, live pick (APP_SIGNING true never gets here: pick fails first).
+    needs: [pick, verify]
+    if: >-
+      !cancelled() && needs.pick.outputs.sha != '' && needs.pick.outputs.live == 'true' && needs.verify.result == 'success'
+    runs-on: windows-latest
+    timeout-minutes: 30
+    permissions:
+      contents: write # create the release and its tag (the only job that writes)
+      actions: read # download the FULL run's artifacts
+    concurrency:
+      group: publish-prerelease
+      cancel-in-progress: false
+    outputs:
+      published: ${{ steps.publish.outputs.published }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ needs.pick.outputs.sha }}
+          fetch-depth: 0
+          persist-credentials: false
+      - uses: actions/setup-dotnet@0f4a354dd5547a28c70b7853dbd95d5b67886e73 # v6.1.0
+        with:
+          dotnet-version: '10.0.x'
+      - run: dotnet tool install -g vpk --version 1.2.161
+      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          name: agent-bridge-windows-${{ needs.pick.outputs.version }}
+          path: out/app/releases
+          run-id: ${{ needs.pick.outputs.full-run }}
+          github-token: ${{ github.token }}
+      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          name: agent-bridge-windows-arm64-${{ needs.pick.outputs.version }}
+          path: out/app-arm64/releases
+          run-id: ${{ needs.pick.outputs.full-run }}
+          github-token: ${{ github.token }}
+      - name: Publish the pre-release
+        id: publish
+        shell: pwsh
+        env:
+          GH_TOKEN: ${{ github.token }}
+          REPOSITORY: ${{ github.repository }}
+          VERSION: ${{ needs.pick.outputs.version }}
+          SHA: ${{ needs.pick.outputs.sha }}
+        run: |
+          # -MainHead is the chosen commit and this checkout is a clone at it. The train publishes the newest verified commit, so a later app change
+          # is the next verified commit's to publish; a duplicate, an older version or a commit behind the latest release is still refused.
+          ./build/publish-prerelease.ps1 -Version $env:VERSION -ReleasesDir out/app/releases, out/app-arm64/releases -Repository $env:REPOSITORY -Commit $env:SHA -MainHead $env:SHA -MainRepo .
+      - name: Say what was waived
+        if: needs.pick.outputs.waived != ''
+        shell: bash
+        env:
+          WAIVED: ${{ needs.pick.outputs.waived }}
+        run: |
+          echo "### Release train: $WAIVED" >> "$GITHUB_STEP_SUMMARY"
+          echo "::warning title=release train::$WAIVED"
+      - name: Publish the static Beta download manifest
+        # Ported from ci.yml's publish job (owner decision A): the manifest names the release this run published.
+        if: steps.publish.outputs.manifest-tag != ''
+        shell: pwsh
+        env:
+          GH_TOKEN: ${{ github.token }}
+          REPOSITORY: ${{ github.repository }}
+          MANIFEST_TAG: ${{ steps.publish.outputs.manifest-tag }}
+        run: |
+          $json = gh api "repos/$env:REPOSITORY/releases/tags/$env:MANIFEST_TAG"
+          if ($LASTEXITCODE) { throw "couldn't read the published Beta metadata ($LASTEXITCODE)" }
+          $json | Set-Content out/beta-release-input.json -Encoding utf8NoBOM
+          ./build/release-manifest.ps1 -ReleaseJson out/beta-release-input.json -Repository $env:REPOSITORY -Out out/beta-release.json -Publish
diff --git a/docs/app-windows.md b/docs/app-windows.md
index 9ebe296cf..92c84eea3 100644
--- a/docs/app-windows.md
+++ b/docs/app-windows.md
@@ -1290,6 +1290,11 @@ for a later app change either, so a green run publishes its own commit without w
   train and `ci.yml`'s `publish` job can run side by side without publishing twice. Neither
   stands aside for a later app change any more (#4104): the train is to publish the newest verified
   commit, and a later change is the next verified commit's to publish.
+* **The workflow and its switch** (`release-train.yml`, written in S2 piece C and not yet applied: a patch for Quality). `pick` runs the selector and hands on the commit,
+  the version, the FAST run's id and **the FULL run's id**, which every download reads (the FAST run builds no package). `verify` installs and self-tests FULL's exact
+  bytes on each architecture; **the package and its hash are required on both, the install and self-test are required on x64 and only recorded on Arm64** (the
+  owner's waiver, said in the run's summary and in the publish summary). `publish` runs only while the repository variable `TRAIN_LIVE` is exactly `true`, never on a
+  dry run, and only after verification passed. Otherwise it picks and verifies only (red if verification fails), so the train can soak on FULL's packages.
 * **Signing (design).** The train is to have no sign step. While `APP_SIGNING` is unset it is to publish unsigned,
   as `ci.yml` does. When `APP_SIGNING` is anything but unset or `false` (`true` in any case, spaces ignored, or a value it does not know) it is to refuse and fail the run, never publishing
   unsigned, until it gains the sign step (the selector's `Assert-TrainMayPublish` already does this).
