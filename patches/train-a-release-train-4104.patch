diff --git a/tests/AgentBridge.Quality.Tests/ReleaseTrainWorkflowTests.cs b/tests/AgentBridge.Quality.Tests/ReleaseTrainWorkflowTests.cs
new file mode 100644
index 000000000..465d74602
--- /dev/null
+++ b/tests/AgentBridge.Quality.Tests/ReleaseTrainWorkflowTests.cs
@@ -0,0 +1,139 @@
+using YamlDotNet.RepresentationModel;
+
+namespace AgentBridge.Quality.Tests;
+
+/// <summary>
+/// release-train.yml (docs/app-windows.md, "The release train"; S2, #4104): publishes what the FULL lane verified, never a rebuild. It picks the newest main
+/// commit whose FAST and FULL lanes passed, installs and self-tests FULL's exact packages on both architectures, and publishes only while
+/// the repository variable TRAIN_LIVE is exactly true. Every download reads the FULL run (the FAST run builds no package), only publish writes, and the
+/// Arm64 install and self-test are recorded, not gating (the owner's waiver), while the Arm64 package and its hash stay required.
+/// </summary>
+public class ReleaseTrainWorkflowTests
+{
+    const string Text = ".github/workflows/release-train.yml";
+
+    static string Raw => File.ReadAllText(Path.Combine(ChangedFiles.RepoRoot(AppContext.BaseDirectory), Text));
+
+    static YamlMappingNode Workflow()
+    {
+        var stream = new YamlStream();
+        stream.Load(new StringReader(Raw));
+        return (YamlMappingNode)stream.Documents[0].RootNode;
+    }
+
+    static YamlMappingNode Jobs() => (YamlMappingNode)Workflow()["jobs"];
+
+    static YamlMappingNode Job(string id) => (YamlMappingNode)Jobs()[id];
+
+    static IEnumerable<YamlMappingNode> Steps(string id) => ((YamlSequenceNode)Job(id)["steps"]).Children.OfType<YamlMappingNode>();
+
+    static string Scalar(YamlNode node, string key) => ((YamlScalarNode)((YamlMappingNode)node)[key]).Value!;
+
+    static string Expression(string value) => value.Trim().StartsWith("${{", StringComparison.Ordinal) ? value.Trim()[3..^2].Trim() : value.Trim();
+
+    [Fact]
+    public void It_runs_hourly_and_by_hand_from_one_queue_and_never_for_a_pull_request_or_a_push()
+    {
+        var on = (YamlMappingNode)Workflow()["on"];
+        var concurrency = (YamlMappingNode)Workflow()["concurrency"];
+
+        Assert.Equal(["schedule", "workflow_dispatch"], on.Children.Keys.Select(k => k.ToString()).Order(StringComparer.Ordinal));
+        Assert.Equal(("release-train", "false"), (concurrency["group"].ToString(), concurrency["cancel-in-progress"].ToString()));
+        Assert.Equal("read", ((YamlMappingNode)Workflow()["permissions"])["contents"].ToString());
+        Assert.Equal(["pick", "publish", "verify"], Jobs().Children.Keys.Select(k => k.ToString()).Order(StringComparer.Ordinal));
+    }
+
+    [Fact]
+    public void Pick_uses_the_selector_refuses_signing_and_hands_on_the_FULL_run_id_the_waived_notice_and_whether_it_is_live()
+    {
+        var outputs = (YamlMappingNode)Job("pick")["outputs"];
+        var script = string.Join("\n", Steps("pick").Where(s => s.Children.ContainsKey("run")).Select(s => Scalar(s, "run")));
+
+        Assert.Equal(["full-run", "live", "number", "run", "sha", "version", "waived"], outputs.Children.Keys.Select(k => k.ToString()).Order(StringComparer.Ordinal));
+        foreach (var call in new[] { "select-release-commit.ps1", "Assert-TrainMayPublish", "Get-ReleaseRuns", "Select-ReleaseCommit", "Get-PickOutputs" })
+            Assert.Contains(call, script, StringComparison.Ordinal);
+        var live = MergeRuleTests.IfExpression.Value(Expression(Scalar(outputs, "live")), new Dictionary<string, string?> { ["vars.TRAIN_LIVE"] = "true", ["inputs.dry_run"] = "" });
+        var dry = MergeRuleTests.IfExpression.Value(Expression(Scalar(outputs, "live")), new Dictionary<string, string?> { ["vars.TRAIN_LIVE"] = "true", ["inputs.dry_run"] = "true" });
+        var off = MergeRuleTests.IfExpression.Value(Expression(Scalar(outputs, "live")), new Dictionary<string, string?> { ["vars.TRAIN_LIVE"] = null, ["inputs.dry_run"] = "" });
+        Assert.Equal([true, false, false], [live is true, dry is true, off is true]);
+    }
+
+    [Fact]
+    public void Every_download_reads_the_FULL_run_because_the_FAST_run_builds_no_package()
+    {
+        var downloads = Jobs().Children.Keys.SelectMany(id => Steps(id.ToString()))
+            .Where(s => s.Children.ContainsKey("uses") && Scalar(s, "uses").StartsWith("actions/download-artifact@", StringComparison.Ordinal)).ToList();
+
+        Assert.NotEmpty(downloads);
+        Assert.All(downloads, s => Assert.Equal("${{ needs.pick.outputs.full-run }}", Scalar(s["with"], "run-id")));
+    }
+
+    [Theory]
+    [InlineData("abc", "true", "success", true)]
+    [InlineData("abc", "true", "failure", false)]
+    [InlineData("abc", "true", "skipped", false)]
+    [InlineData("abc", "false", "success", false)]
+    [InlineData("", "true", "success", false)]
+    public void Publish_runs_only_for_a_live_pick_whose_verification_passed(string sha, string live, string verify, bool publishes)
+    {
+        var condition = Expression(Scalar(Job("publish"), "if"));
+
+        var got = MergeRuleTests.IfExpression.Evaluate(condition, new Dictionary<string, string?>
+        {
+            ["needs.pick.outputs.sha"] = sha, ["needs.pick.outputs.live"] = live, ["needs.verify.result"] = verify,
+        });
+
+        Assert.Equal(publishes, got);
+    }
+
+    [Fact]
+    public void Only_publish_writes_and_nothing_signs_or_attests_here_yet()
+    {
+        foreach (var (id, job) in Jobs().Children)
+        {
+            var permissions = ((YamlMappingNode)job).Children.TryGetValue("permissions", out var p) ? ((YamlMappingNode?)p)?.Children.Select(c => $"{c.Key}: {c.Value}").ToArray() ?? [] : [];
+            Assert.Equal(id.ToString() == "publish", permissions.Contains("contents: write"));
+            Assert.DoesNotContain(permissions, x => x.StartsWith("id-token", StringComparison.Ordinal));
+        }
+        Assert.DoesNotContain("environment:", Raw, StringComparison.Ordinal);
+    }
+
+    [Theory]
+    [InlineData("win-x64", false)]
+    [InlineData("win-arm64", true)]
+    public void The_installed_app_check_gates_for_x64_and_is_only_recorded_for_Arm64(string runtime, bool recorded)
+    {
+        var gated = Steps("verify").Where(s => s.Children.ContainsKey("name")
+            && (Scalar(s, "name").Contains("installs per user", StringComparison.Ordinal) || Scalar(s, "name").Contains("self-tests", StringComparison.Ordinal))).ToList();
+
+        Assert.Equal(2, gated.Count);
+        foreach (var step in gated)
+        {
+            var value = MergeRuleTests.IfExpression.Value(Expression(Scalar(step, "continue-on-error")), new Dictionary<string, string?> { ["matrix.runtime"] = runtime });
+            Assert.Equal(recorded, value is true);
+        }
+    }
+
+    [Fact]
+    public void The_package_and_its_hash_are_required_on_both_architectures()
+    {
