diff --git a/.github/workflows/full.yml b/.github/workflows/full.yml
new file mode 100644
index 000000000..fe432bc54
--- /dev/null
+++ b/.github/workflows/full.yml
@@ -0,0 +1,218 @@
+name: Full
+
+# The FULL lane (quality/README.md section 4.7; S2, #4104): the checks the merge gate no longer waits for. ci.yml is the FAST lane
+# and the only one the merge rule, main-red and the ruleset read; this workflow never gates a merge, so it has no pull_request,
+# merge_group or push trigger (quality/catalog.yml `lane: full`, and the catalog check enforces it). It runs after a push to main
+# whose FAST run finished green (a workflow_run of CI), or by hand for a commit (the release train dispatches it for one it wants
+# to publish). Every job tests the commit the FAST run passed on, never the branch tip. A newer push cancels an older run: the
+# latest wins. Piece 4 has the spikes here; the app's self-test, pack and installers, pwa-ui and pwa-e2e follow (pieces 5 and 6).
+on:
+  # Unlike main-red, this checks out the triggering run's commit: only main's own pushed commit, since the trigger job passes only for
+  # a green push run on main (branches: [main] and the event and branch tests below), never a pull request's or a fork's code.
+  workflow_run: # zizmor: ignore[dangerous-triggers]
+    workflows: [CI]
+    types: [completed]
+    branches: [main]
+  workflow_dispatch:
+    inputs:
+      sha:
+        description: The main commit to test
+        type: string
+        required: true
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ${{ github.event_name == 'workflow_run' && 'full-main' || format('full-{0}', inputs.sha) }}
+  cancel-in-progress: true
+
+jobs:
+  trigger:
+    # Whether there is anything to test: a run by hand, or a CI run that was a green push to main. Every other job needs this and
+    # runs only when it says so, and full-gate says why when it didn't.
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    outputs:
+      ok: ${{ github.event_name == 'workflow_dispatch' || (github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.event == 'push' && github.event.workflow_run.head_branch == 'main') }}
+    steps:
+      - name: The commit under test
+        env:
+          SHA: ${{ github.event.workflow_run.head_sha || inputs.sha }}
+        run: echo "FULL lane for commit $SHA" >> "$GITHUB_STEP_SUMMARY"
+
+  spikes:
+    needs: trigger
+    if: needs.trigger.outputs.ok == 'true'
+    runs-on: windows-latest
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ github.event.workflow_run.head_sha || inputs.sha }}
+          persist-credentials: false
+      - uses: actions/setup-dotnet@0f4a354dd5547a28c70b7853dbd95d5b67886e73 # v6.1.0
+        with:
+          dotnet-version: '10.0.x'
+      - name: NuGet packages from main's cache
+        id: nuget
+        uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
+        with:
+          path: ~/.nuget/packages
+          key: nuget-${{ github.job }}-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('**/*.csproj', '**/Directory.*', '**/nuget.config', '.config/dotnet-tools.json', '**/global.json') }}
+      - name: Build spike projects
+        shell: pwsh
+        run: |
+          $projects = Get-ChildItem spikes -Recurse -Filter *.csproj
+          foreach ($p in $projects) {
+            dotnet build $p.FullName -c Release --nologo
+            if ($LASTEXITCODE) { exit $LASTEXITCODE }
+          }
+      - name: Save NuGet packages to main's cache
+        if: github.ref == 'refs/heads/main' && steps.nuget.outputs.cache-hit != 'true'
+        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
+        with:
+          path: ~/.nuget/packages
+          key: ${{ steps.nuget.outputs.cache-primary-key }}
+      - name: Parse spike scripts
+        shell: pwsh
+        run: |
+          $bad = 0
+          foreach ($f in Get-ChildItem spikes -Recurse -Filter *.ps1) {
+            $errors = $null
+            [void][System.Management.Automation.Language.Parser]::ParseFile($f.FullName, [ref]$null, [ref]$errors)
+            if ($errors) { $errors | ForEach-Object { Write-Error "$($f.Name): $_" }; $bad++ }
+          }
+          exit $bad
+      - name: S3 publish carries the compiled XAML
+        # The build output runs either way; only a published copy fails at startup when
+        # the app's .pri is missing, so check the publish folder itself.
+        shell: pwsh
+        run: |
+          dotnet publish spikes/s3-winui-velopack/App/AgentBridgeS3.csproj -c Release -o "$env:RUNNER_TEMP/s3" --nologo
+          if ($LASTEXITCODE) { exit $LASTEXITCODE }
+          if (-not (Test-Path "$env:RUNNER_TEMP/s3/AgentBridgeS3.pri")) { Write-Error 'AgentBridgeS3.pri is missing from the publish output'; exit 1 }
+      - name: S6 device keys
+        # A runner may have no TPM; the TPM checks then report SKIP and the DPAPI ones still run.
+        shell: pwsh
+        run: dotnet spikes/s6-tpm-keys/src/S6.Check/bin/Release/net10.0-windows/s6-check.dll check
+
+  spikes-linux:
+    # The spikes' Linux checks, on one runner since both install the same Playwright browsers
+    # (they were two jobs, s2-noise-interop and s4-relay, until #459):
+    #  - S2: the .NET and WebCrypto Noise implementations must keep agreeing byte for byte, in
+    #    Node, Chromium and WebKit (Safari's engine), and live over a WebSocket;
+    #  - S4: the relay's security and routing checks against a fake GitHub, then the PWA in
+    #    Chromium and WebKit through the same relay, then the container build.
+    needs: trigger
+    if: needs.trigger.outputs.ok == 'true'
+    runs-on: ubuntu-24.04
+    # 35, as every job that runs `playwright install --with-deps` gets (#689): room for the five
+    # minutes the download step gives a slow apt mirror and a full download from Canonical's
+    # archive, on top of the checks.
+    timeout-minutes: 35
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ github.event.workflow_run.head_sha || inputs.sha }}
+          persist-credentials: false
+      - uses: actions/setup-dotnet@0f4a354dd5547a28c70b7853dbd95d5b67886e73 # v6.1.0
+        with:
+          dotnet-version: '10.0.x'
+      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
+        with:
+          node-version: '22'
+      - name: S2 builds and checks its vectors
+        working-directory: spikes/s2-noise-interop
+        run: |
+          dotnet build dotnet/S2.Noise.csproj -c Release --nologo
+          dotnet dotnet/bin/Release/net10.0/s2-noise.dll check
+      - name: S2 fresh vectors from .NET, replayed in Node
+        working-directory: spikes/s2-noise-interop
+        run: |
+          dotnet dotnet/bin/Release/net10.0/s2-noise.dll vectors "$RUNNER_TEMP/vectors.json"
+          cp "$RUNNER_TEMP/vectors.json" web/vectors.json
+          node js/test-node.mjs
+      - name: S4 builds and checks the relay against a fake GitHub
+        working-directory: spikes/s4-relay
+        run: |
+          dotnet build src/S4.DevStack -c Release --nologo
+          dotnet build src/S4.Host -c Release --nologo
+          dotnet src/S4.DevStack/bin/Release/net10.0/s4-devstack.dll check
+          node js/test-sw.mjs
+      - name: npm ci, for both
+        run: |
+          npm ci --prefix spikes/s2-noise-interop
+          npm ci --prefix spikes/s4-relay
+      - name: Which Playwright
+        id: playwright
+        working-directory: spikes/s4-relay
+        run: echo "version=$(node -p "require('playwright-core/package.json').version")" >> "$GITHUB_OUTPUT"
+      # Playwright's browsers come from a cache only main writes, keyed by the Playwright version
+      # npm ci installed (#459). The install below still runs every time: it fetches the browsers
+      # on a miss and installs their system packages either way.
+      - name: Playwright's browsers from main's cache
+        id: browsers
+        uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
+        with:
+          path: ~/.cache/ms-playwright
+          key: playwright-${{ runner.os }}-${{ runner.arch }}-${{ steps.playwright.outputs.version }}-chromium-webkit
+      # Their system packages first, so a slow apt mirror can be left (as in pwa-ui; the action's
+      # download.sh says why). The second spike's finds them downloaded while the two agree.
+      - name: Download Playwright's system packages, S2
+        uses: ./.github/actions/playwright-system-packages
+        with:
+          browsers: chromium webkit
+          working-directory: spikes/s2-noise-interop
+      - name: Download Playwright's system packages, S4
+        uses: ./.github/actions/playwright-system-packages
+        with:
+          browsers: chromium webkit
+          working-directory: spikes/s4-relay
+      # In each spike, so a spike that moves to another Playwright still gets its own browsers;
+      # the second is quick while they agree.
+      - name: Playwright's browsers, for both
+        run: |
+          (cd spikes/s2-noise-interop && npx playwright install chromium webkit)
+          (cd spikes/s4-relay && npx playwright install chromium webkit)
+      - name: Save Playwright's browsers to main's cache
+        if: github.ref == 'refs/heads/main' && steps.browsers.outputs.cache-hit != 'true'
+        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
+        with:
+          path: ~/.cache/ms-playwright
+          key: ${{ steps.browsers.outputs.cache-primary-key }}
+      - name: S2 in Chromium and WebKit
+        working-directory: spikes/s2-noise-interop
+        run: node js/test-browsers.mjs
+      - name: S4 the PWA through the relay
+        working-directory: spikes/s4-relay
+        run: node js/test-pwa.mjs
+      - name: S4 container builds
+        working-directory: spikes
+        run: docker build -f s4-relay/Dockerfile -t agent-bridge-relay-s4 .
+
+  full-gate:
+    # The one result for this workflow, as quality-gate is for ci.yml (the catalog check requires this shape): it needs every other
+    # job, runs whatever they did, and fails when any ended other than success, a skipped one included, so a FULL run whose lane
+    # did not run is no pass. It passes only when the FAST run was not a green push to main, and then says there was nothing to test.
+    needs: [trigger, spikes, spikes-linux]
+    if: always()
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      - name: Every FULL job passed
+        env:
+          NEEDS: ${{ toJSON(needs) }}
+        run: |
+          if [ "$(echo "$NEEDS" | jq -r '.trigger.result')" != success ]; then
+            echo "::error::the trigger job did not succeed"
+            exit 1
+          fi
+          if [ "$(echo "$NEEDS" | jq -r '.trigger.outputs.ok')" != true ]; then
+            echo "The FAST run was not a green push to main, so there was nothing to test." >> "$GITHUB_STEP_SUMMARY"
+            exit 0
+          fi
+          bad=$(echo "$NEEDS" | jq -r 'to_entries[] | select(.key != "trigger" and .value.result != "success") | "\(.key): \(.value.result)"')
+          if [ -n "$bad" ]; then
+            echo "::error::FULL jobs that did not pass: $bad"
+            exit 1
+          fi
