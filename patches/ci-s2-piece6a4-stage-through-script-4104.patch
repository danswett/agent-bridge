index 000000000..ed8d3273c
--- /dev/null
+++ b/tests/AgentBridge.Quality.Tests/StageStepsWorkflowTests.cs
@@ -0,0 +1,85 @@
+using System.Text.RegularExpressions;
+using YamlDotNet.RepresentationModel;
+
+namespace AgentBridge.Quality.Tests;
+
+/// <summary>
+/// The self-test text a run uploads to a PUBLIC artifact is staged by one script, build/stage-selftest-text.ps1 (S2, #4104): ci.yml's app and
+/// app-installer jobs and full.yml's app-selftest and app-installer jobs all call it, with one allow-list per kind and the same 7-day uploads, and no
+/// workflow holds the refusals (links, control characters, dump/zip/ELF signatures, bad JSON) inline: they live in the script, proven equal to the
+/// block they replaced by StageSelftestTextTests.
+/// </summary>
+public class StageStepsWorkflowTests
+{
+    static string Read(string file) => File.ReadAllText(Path.Combine(ChangedFiles.RepoRoot(AppContext.BaseDirectory), ".github/workflows", file));
+
+    static YamlMappingNode Job(string file, string job)
+    {
+        var stream = new YamlStream();
+        stream.Load(new StringReader(Read(file)));
+        return (YamlMappingNode)((YamlMappingNode)((YamlMappingNode)stream.Documents[0].RootNode)["jobs"])[job];
+    }
+
+    static List<YamlMappingNode> Steps(string file, string job) => ((YamlSequenceNode)Job(file, job)["steps"]).Children.OfType<YamlMappingNode>().ToList();
+
+    static string Value(YamlMappingNode node, string key) => node.Children.TryGetValue(key, out var v) ? ((YamlScalarNode)v).Value! : "";
+
+    /// <summary>The staging step with this id, the upload that follows it, and the allow-list the step passes.</summary>
+    static (YamlMappingNode Stage, YamlMappingNode Upload, string[] Names) Staging(string file, string job, string id)
+    {
+        var steps = Steps(file, job);
+        var at = steps.FindIndex(s => Value(s, "id") == id);
+        Assert.True(at >= 0, $"{file} {job} has no step {id}");
+        var names = Regex.Matches(Regex.Match(Value(steps[at], "run"), @"-Names\s+(.+)", RegexOptions.Singleline).Groups[1].Value, "'([^']+)'").Select(m => m.Groups[1].Value).ToArray();
+        return (steps[at], steps[at + 1], names);
+    }
+
+    static readonly (string Job, string Id, string Artifact)[] Kinds =
+    [
+        ("app", "selftest-text", "app-self-test-${{ matrix.runtime }}"),
+        ("app-installer", "installed-selftest-text", "app-installer-self-test-${{ matrix.runtime }}"),
+    ];
+
+    [Theory]
+    [InlineData("ci.yml", "app", "selftest-text", "app-self-test-${{ matrix.runtime }}")]
+    [InlineData("ci.yml", "app-installer", "installed-selftest-text", "app-installer-self-test-${{ matrix.runtime }}")]
+    [InlineData("full.yml", "app-selftest", "selftest-text", "app-self-test-${{ matrix.runtime }}")]
+    [InlineData("full.yml", "app-installer", "installed-selftest-text", "app-installer-self-test-${{ matrix.runtime }}")]
+    public void Every_staging_step_calls_the_script_runs_always_and_is_followed_by_a_seven_day_upload_of_what_it_staged(string file, string job, string id, string artifact)
+    {
+        var (stage, upload, names) = Staging(file, job, id);
+        var run = Value(stage, "run");
+
+        Assert.StartsWith("./build/stage-selftest-text.ps1 -Source (Join-Path $env:RUNNER_TEMP 'selftest') -Out (Join-Path $env:RUNNER_TEMP 'public-", run.Trim(), StringComparison.Ordinal);
+        Assert.Equal("always()", Value(stage, "if"));
+        Assert.NotEmpty(names);
+        Assert.Equal($"always() && steps.{id}.outcome == 'success'", Value(upload, "if"));
+        Assert.StartsWith("actions/upload-artifact@", Value(upload, "uses"), StringComparison.Ordinal);
+        Assert.Equal("7", Value((YamlMappingNode)upload["with"], "retention-days"));
+        Assert.Equal(artifact, Value((YamlMappingNode)upload["with"], "name"));
+        // The upload names exactly the files the step stages, no more (nothing unnamed leaves the runner).
+        var out_ = Regex.Match(run, @"-Out \(Join-Path \$env:RUNNER_TEMP '([^']+)'\)").Groups[1].Value;
+        Assert.Equal(names.Select(n => $"${{{{ runner.temp }}}}/{out_}/{n}").Order(StringComparer.Ordinal),
+            Value((YamlMappingNode)upload["with"], "path").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Order(StringComparer.Ordinal));
+    }
+
+    [Fact]
+    public void Both_workflows_pass_the_same_allow_list_for_each_kind_of_self_test()
+    {
+        foreach (var (_, id, _) in Kinds)
+        {
+            var ci = Staging("ci.yml", id == "selftest-text" ? "app" : "app-installer", id).Names;
+            var full = Staging("full.yml", id == "selftest-text" ? "app-selftest" : "app-installer", id).Names;
+            Assert.Equal(ci, full);
+        }
+    }
+
+    [Fact]
+    public void No_workflow_holds_the_refusals_inline_because_they_live_in_the_script_only()
+    {
+        foreach (var file in new[] { "ci.yml", "full.yml" })
+            foreach (var marker in new[] { "Read-DiagnosticText", "Linked diagnostic", "MDMP", "Binary diagnostic input refused", "ConvertFrom-Json -InputObject $text" })
+                Assert.DoesNotContain(marker, Read(file), StringComparison.Ordinal);
+        Assert.Contains("Read-DiagnosticText", File.ReadAllText(Path.Combine(ChangedFiles.RepoRoot(AppContext.BaseDirectory), "build/stage-selftest-text.ps1")), StringComparison.Ordinal);
+    }
+}
