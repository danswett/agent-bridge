From 48608ed9ed7ea4d7d71bd62c7cd956d402323498 Mon Sep 17 00:00:00 2001
From: SG Quality Lead R8 <danswett@users.noreply.github.com>
Date: Mon, 23 Nov 2026 23:23:34 -0800
Subject: [PATCH] s 4b

---
 .github/workflows/full.yml                     |  2 +-
 .../FullWorkflowTests.cs                       | 18 +++++++++++-------
 2 files changed, 12 insertions(+), 8 deletions(-)

diff --git a/.github/workflows/full.yml b/.github/workflows/full.yml
index 76d42f292..aaae9e6b3 100644
--- a/.github/workflows/full.yml
+++ b/.github/workflows/full.yml
@@ -38,7 +38,7 @@ jobs:
       contents: read
     outputs:
       sha: ${{ steps.commit.outputs.sha }}
-      ok: ${{ github.event_name == 'workflow_dispatch' || (github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.event == 'push' && github.event.workflow_run.head_branch == 'main') }}
+      ok: ${{ github.event_name == 'workflow_dispatch' || (github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.event == 'push' && github.event.workflow_run.head_branch == 'main' && github.event.workflow_run.head_repository.full_name == github.repository) }}
     steps:
       # The commit every other job checks out. A workflow_run's is read from the CI run itself through the API (by its number), not taken from
       # the event's text, and either is refused unless it is 40 lowercase hex: no job reads the event's commit, they all read this output.
diff --git a/tests/AgentBridge.Quality.Tests/FullWorkflowTests.cs b/tests/AgentBridge.Quality.Tests/FullWorkflowTests.cs
index e86baecbd..c8052833b 100644
--- a/tests/AgentBridge.Quality.Tests/FullWorkflowTests.cs
+++ b/tests/AgentBridge.Quality.Tests/FullWorkflowTests.cs
@@ -47,13 +47,15 @@ public class FullWorkflowTests
     }
 
     [Theory]
-    [InlineData("workflow_run", "success", "push", "main", true)]
-    [InlineData("workflow_run", "failure", "push", "main", false)]
-    [InlineData("workflow_run", "cancelled", "push", "main", false)]
-    [InlineData("workflow_run", "success", "pull_request", "main", false)]
-    [InlineData("workflow_run", "success", "push", "feature", false)]
-    [InlineData("workflow_dispatch", null, null, null, true)]
-    public void The_trigger_job_says_ok_only_for_a_green_push_run_of_ci_on_main_or_a_run_by_hand(string eventName, string? conclusion, string? runEvent, string? branch, bool ok)
+    [InlineData("workflow_run", "success", "push", "main", "o/r", true)]
+    [InlineData("workflow_run", "failure", "push", "main", "o/r", false)]
+    [InlineData("workflow_run", "cancelled", "push", "main", "o/r", false)]
+    [InlineData("workflow_run", "success", "pull_request", "main", "o/r", false)]
+    [InlineData("workflow_run", "success", "push", "feature", "o/r", false)]
+    [InlineData("workflow_run", "success", "push", "main", "evil/r", false)]
+    [InlineData("workflow_run", "success", "pull_request", "main", "evil/r", false)]
+    [InlineData("workflow_dispatch", null, null, null, null, true)]
+    public void The_trigger_job_says_ok_only_for_a_green_push_run_of_ci_on_main_of_this_repository_or_a_run_by_hand(string eventName, string? conclusion, string? runEvent, string? branch, string? repository, bool ok)
     {
         var job = (YamlMappingNode)Jobs("full.yml")["trigger"];
         var output = Scalar(job["outputs"], "ok");
@@ -64,6 +66,8 @@ public class FullWorkflowTests
             ["github.event.workflow_run.conclusion"] = conclusion,
             ["github.event.workflow_run.event"] = runEvent,
             ["github.event.workflow_run.head_branch"] = branch,
+            ["github.event.workflow_run.head_repository.full_name"] = repository,
+            ["github.repository"] = "o/r",
         });
 
         Assert.Equal(ok, value is true || value is string s && s == "true");
