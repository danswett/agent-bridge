+  app-installer:
+    # The packed Windows app installed the way a person installs it (#1766): the Setup.exe app-pack built in THIS run, run silently per user into its own channel and
+    # architecture, then the installed copy self-tested. Never a second build or another run's files. Arm64's failure fails the job and full-gate waives it (owner, #2454), visibly.
+    name: app-installer (${{ matrix.runtime }})
+    needs: [trigger, app-pack]
+    if: needs.trigger.outputs.ok == 'true'
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - runtime: win-x64
+            runner: windows-latest
+            out: out/app
+            artifact: agent-bridge-windows
+          - runtime: win-arm64
+            runner: windows-11-arm
+            out: out/app-arm64
+            artifact: agent-bridge-windows-arm64
+    runs-on: ${{ matrix.runner }}
+    env:
+      APP_VERSION: 0.1.${{ github.event.workflow_run.run_number || inputs.ci_run_number }}
+      SHA: ${{ needs.trigger.outputs.sha }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ needs.trigger.outputs.sha }}
+          persist-credentials: false
+      - uses: ./.github/actions/arm64-foreground
+        if: matrix.runtime == 'win-arm64' && matrix.runner == 'windows-11-arm'
+      - name: The matching tested release files from this run
+        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          name: ${{ matrix.artifact }}-${{ env.APP_VERSION }}
+          path: ${{ matrix.out }}/releases
+      - name: The matching installer notices and identity from this run
+        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          name: ${{ matrix.artifact }}-installer-input-${{ env.APP_VERSION }}
+          path: ${{ runner.temp }}/installer-input
+      - name: Refuse missing, foreign or altered installer input before running it
+        shell: pwsh
+        run: |
+          . ./build/app-installer-input.ps1
+          Assert-AppInstallerInput -InputPath "$env:RUNNER_TEMP/installer-input" -Releases '${{ matrix.out }}/releases' -Version $env:APP_VERSION -Runtime '${{ matrix.runtime }}' -Commit $env:SHA -RunId '${{ github.run_id }}' | Tee-Object -FilePath $env:GITHUB_STEP_SUMMARY -Append
+          New-Item -ItemType Directory -Force "$env:RUNNER_TEMP/selftest" | Out-Null
+          Copy-Item "$env:RUNNER_TEMP/installer-input/installer-input.json" "$env:RUNNER_TEMP/selftest/installer-input.json"
+      - name: The installer installs per user, into its own channel and architecture, and the installed app starts
+        # The Setup.exe a person downloads, run silently on this throwaway runner: per user, no
+        # admin, into %LOCALAPPDATA%\AgentBridgeApp. A silent install starts nothing, so no host or
+        # logon task is registered; the installed copy then runs the same self-test. The channel it
+        # recorded is the feed it will update from, for good (build/app-channels.ps1).
+        shell: pwsh
+        run: |
+          . ./build/app-channels.ps1
+          $target = Get-AppChannel '${{ matrix.runtime }}'
+          $setup = Join-Path '${{ matrix.out }}/releases' (Get-AppAssetName $target.Channel 'Installer' $env:APP_VERSION)
+          $logs = "$env:RUNNER_TEMP/selftest/installed"
+          New-Item -ItemType Directory -Force $logs | Out-Null
+          $p = Start-Process $setup -ArgumentList '--silent', '--log', "$logs/setup.log" -PassThru
+          if (-not $p.WaitForExit(300000)) { Stop-Process -Id $p.Id; Write-Error 'Setup did not finish'; exit 1 }
+          if ($p.ExitCode) { Get-Content "$logs/setup.log" -ErrorAction SilentlyContinue; Write-Error "Setup exited with $($p.ExitCode)"; exit 1 }
+          $root = "$env:LOCALAPPDATA/AgentBridgeApp"
+          $manifest = Get-Content "$root/current/sq.version" -Raw
+          Write-Output $manifest
+          if ($manifest -notmatch "<channel>$([regex]::Escape($target.Channel))</channel>") { Write-Error "installed into another channel than $($target.Channel)"; exit 1 }
+          # x64's Update.exe is the x86 one vpk gives a pack without --runtime, as installed copies have.
+          $expected = [ordered]@{ 'current/AgentBridge.exe' = $target.Machine; 'current/agent-bridge-host.exe' = $target.Machine; 'current/agent-bridge-injector.exe' = $target.Machine; 'current/agent-bridge-host-hook.exe' = $target.Machine; 'Update.exe' = $(if ($target.Machine -eq 'x64') { 'x86' } else { $target.Machine }) }
+          $bad = 0
+          foreach ($file in $expected.Keys) {
+            $machine = Get-PeMachine ([IO.File]::ReadAllBytes((Join-Path $root $file)))
+            Write-Output "${file}: $machine"
+            if ($machine -ne $expected[$file]) { Write-Error "$file is $machine, not $($expected[$file])"; $bad++ }
+          }
+          if ($bad) { exit 1 }
+          . ./build/app-notices.ps1
+          Write-AppDistributionEvidence -Publish "$env:RUNNER_TEMP/installer-input/publish" -Releases '${{ matrix.out }}/releases' -Version $env:APP_VERSION -Runtime '${{ matrix.runtime }}' -Installed "$root/current" -Out "$logs/distribution-evidence.json"
+          ./build/app-self-test.ps1 -Exe "$root/current/AgentBridge.exe" -Result "$logs/result.json" -TimeoutSeconds 720
+          exit $LASTEXITCODE
+      - name: A failed installed self-test includes the app process exit cause
+        if: ${{ !cancelled() }}
+        shell: pwsh
+        run: ./build/test-app-self-test-cause.ps1 -Evidence "$env:RUNNER_TEMP/selftest/installed/app-exit-cause.json"
+
   full-gate:
     # The one result for this workflow, as quality-gate is for ci.yml (the catalog check requires this shape): it needs every other
     # job, runs whatever they did, and fails when any ended other than success, a skipped one included, so a FULL run whose lane
     # did not run is no pass. It passes only when the FAST run was not a green push to main, and then says there was nothing to test.
-    needs: [trigger, spikes, spikes-linux, pwa-e2e, pwa-ui, app-pack, app-selftest]
+    # One waiver (owner, #2454): what RUNS the app on Arm64, its self-test and installer, may be red; the jobs stay red, full-red's issue names them and the publish
+    # summary carries a notice. The Arm64 PACK is required, as is everything on x64.
+    needs: [trigger, spikes, spikes-linux, pwa-e2e, pwa-ui, app-pack, app-selftest, app-installer]
     if: always()
     runs-on: ubuntu-latest
     timeout-minutes: 5
+    permissions:
+      actions: read # this run's jobs, which `needs` cannot show: a matrix is one result
+      contents: read
     steps:
-      - name: Every FULL job passed
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        if: ${{ contains(needs.*.result, 'failure') }}
+        with:
+          ref: ${{ needs.trigger.outputs.sha }}
+          persist-credentials: false
+          sparse-checkout: quality
+      - name: Waive the failed Arm64 self-test and installer (owner, #2454)
+        id: waiver
+        if: ${{ contains(needs.*.result, 'failure') }}
         env:
+          GH_TOKEN: ${{ github.token }}
+          REPO: ${{ github.repository }}
+          RUN_ID: ${{ github.run_id }}
           NEEDS: ${{ toJSON(needs) }}
+        run: |
+          printf '%s' "$NEEDS" > "$RUNNER_TEMP/needs.json"
+          fetched=
+          for attempt in 1 2 3; do
+            if gh api --paginate --slurp "repos/$REPO/actions/runs/$RUN_ID/jobs?filter=latest&per_page=100" > "$RUNNER_TEMP/jobs.json"; then
+              fetched=yes
+              break
+            fi
+            sleep $((attempt * 5))
+          done
+          if [ -z "$fetched" ]; then
+            echo "::warning title=full-gate::the jobs API failed 3 times, so no Arm64 result is waived"
+            exit 0
+          fi
+          pwsh -NoProfile -File quality/arm64-waiver.ps1 -NeedsFile "$RUNNER_TEMP/needs.json" -JobsFile "$RUNNER_TEMP/jobs.json" -OutFile "$RUNNER_TEMP/waived.json" -SummaryFile "$GITHUB_STEP_SUMMARY" -Waivable 'app-selftest (win-arm64);app-installer (win-arm64)'
+          waived=$(cat "$RUNNER_TEMP/waived.json")
+          if [ "$waived" != "[]" ]; then
+            effective=$(echo "$NEEDS" | jq -c --argjson w "$waived" 'with_entries(.key as $k | if ($w | any(. == $k)) then .value.result = "success" else . end)')
+            echo "needs=$effective" >> "$GITHUB_OUTPUT"
+          fi
+      - name: Every FULL job passed
+        env:
+          NEEDS: ${{ steps.waiver.outputs.needs || toJSON(needs) }}
         run: |
           if [ "$(echo "$NEEDS" | jq -r '.trigger.result')" != success ]; then
             echo "::error::the trigger job did not succeed"
