diff --git a/.github/workflows/pwa-webkit.yml b/.github/workflows/pwa-webkit.yml
new file mode 100644
index 00000000..ad1ff3ef
--- /dev/null
+++ b/.github/workflows/pwa-webkit.yml
@@ -0,0 +1,91 @@
+name: PWA WebKit
+
+# The PWA's WebKit legs off the push path (#2454, item B; the owner decides whether to turn it on).
+# With the repository variable PWA_WEBKIT_OFF_PUSH set to 'true', ci.yml's main push runs leave WebKit
+# out, and this runs it instead: on main's head every hour, by hand, and, called by the release train,
+# on the commit the train would publish. Unset (the default), every job here is skipped and ci.yml
+# runs WebKit on every main push, as before. WebKit is the post-merge tier (quality/catalog.yml
+# pwa-ui suite, #3209), so it never holds a merge either way. Its steps are pwa-ui's in ci.yml for
+# the WebKit project; keep the two the same.
+on:
+  schedule:
+    - cron: '41 * * * *'
+  workflow_dispatch:
+  workflow_call:
+    inputs:
+      ref:
+        description: The commit to test (the release train's pick)
+        type: string
+        required: true
+
+permissions:
+  contents: read
+
+# An hourly run gives way to the next one; a train's call for a commit is a group of its own.
+concurrency:
+  group: pwa-webkit-${{ inputs.ref || 'main' }}
+  cancel-in-progress: ${{ inputs.ref == '' }}
+
+jobs:
+  webkit:
+    name: webkit ${{ matrix.shard }}
+    # Only while the switch is on, in this repository, and only for main or the train's commit.
+    if: vars.PWA_WEBKIT_OFF_PUSH == 'true' && github.repository == 'danswett/agent-bridge' && (inputs.ref != '' || github.ref == 'refs/heads/main')
+    strategy:
+      fail-fast: false
+      matrix:
+        shard: ['1/3', '2/3', '3/3']
+    runs-on: ubuntu-24.04
+    # As pwa-ui's legs (#689): room for WebKit's 181 system packages on a slow apt mirror.
+    timeout-minutes: 35
+    defaults:
+      run:
+        working-directory: pwa
+    env:
+      PWA_SKIP_E2E: '1'
+      PROJECT: webkit
+      SHARD: ${{ matrix.shard }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ inputs.ref || github.sha }}
+          persist-credentials: false
+          fetch-depth: 1
+      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
+        with:
+          node-version: '22'
+      - run: npm ci
+      - name: Which Playwright
+        id: playwright
+        run: echo "version=$(node -p "require('playwright-core/package.json').version")" >> "$GITHUB_OUTPUT"
+      - name: Playwright's browsers from main's cache
+        id: browsers
+        uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
+        with:
+          path: ~/.cache/ms-playwright
+          key: playwright-${{ runner.os }}-${{ runner.arch }}-${{ steps.playwright.outputs.version }}-webkit
+      - name: Download Playwright's system packages
+        uses: ./.github/actions/playwright-system-packages
+        with:
+          browsers: webkit
+          working-directory: pwa
+      - run: npx playwright install "$PROJECT"
+      # Only main's own hourly run saves (ci.yml's main pushes no longer do while this is on); never a
+      # train's call or a run by hand.
+      - name: Save Playwright's browsers to main's cache
+        if: github.event_name == 'schedule' && github.ref == 'refs/heads/main' && inputs.ref == '' && steps.browsers.outputs.cache-hit != 'true'
+        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
+        with:
+          path: ~/.cache/ms-playwright
+          key: ${{ steps.browsers.outputs.cache-primary-key }}
+      - run: npx playwright test --project="$PROJECT" --shard="$SHARD" --fully-parallel
+      # Every test that failed, then passed on the one WebKit retry (#1692), so a retry never hides a flake.
+      - name: Flaky report
+        if: ${{ !cancelled() }}
+        run: node tools/flaky-report.mjs playwright-report/report.json --summary "$GITHUB_STEP_SUMMARY"
+      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        if: failure()
+        with:
+          name: pwa-test-results-webkit-${{ strategy.job-index }}
+          path: pwa/test-results
+          retention-days: 7
