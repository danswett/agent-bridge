             $runs = @((Read-Api "repos/$env:GITHUB_REPOSITORY/actions/workflows/ci.yml/runs?branch=main&event=push&per_page=20").workflow_runs)
             foreach ($r in $runs) { $r | Add-Member -NotePropertyName jobs -NotePropertyValue @((Read-Api "repos/$env:GITHUB_REPOSITORY/actions/runs/$($r.id)/jobs?filter=latest&per_page=100").jobs) }
