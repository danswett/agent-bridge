+            # found by its head_sha with the release train's own helpers, and read only when the push run lacks some of the jobs.
+            . ./build/select-release-commit.ps1
+            $getFull = {
+              param($sha)
+              $found = @(@((Read-Api (Get-FullRunsPath $env:GITHUB_REPOSITORY $sha)).workflow_runs) | Where-Object { $_ } | ForEach-Object { "$($_.id)`t$($_.conclusion)`t$($_.head_sha)`t$($_.event)`t$($_.head_branch)" })
+              $row = Select-FullRunRow $found $sha
+              if (-not $row) { return $null }
+              [pscustomobject]@{ Id = $row.Id; Conclusion = $row.Conclusion; jobs = @((Read-Api "repos/$env:GITHUB_REPOSITORY/actions/runs/$($row.Id)/jobs?filter=latest&per_page=100").jobs) }
+            }
+            $candidate = & quality/pages-candidate.ps1 -Runs $runs -GetFull $getFull
             if (-not $candidate.sha) {
               Write-Host $candidate.reason; 'deploy=false' >> $env:GITHUB_OUTPUT; exit 0
             }
