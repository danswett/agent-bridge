From 16ed899eebfb49c337bebf4af7abce8a9fa1ef83 Mon Sep 17 00:00:00 2001
From: SG Quality Lead R8 <danswett@users.noreply.github.com>
Date: Mon, 23 Nov 2026 22:31:54 -0800
Subject: [PATCH] s trigger-sha

---
 .github/workflows/full.yml                    | 29 ++++++++++++++++---
 .../FullWorkflowTests.cs                      | 22 +++++++++++++-
 2 files changed, 46 insertions(+), 5 deletions(-)

diff --git a/.github/workflows/full.yml b/.github/workflows/full.yml
index 91c2fb68c..b9717b4e6 100644
--- a/.github/workflows/full.yml
+++ b/.github/workflows/full.yml
@@ -33,13 +33,34 @@ jobs:
     # runs only when it says so, and full-gate says why when it didn't.
     runs-on: ubuntu-latest
     timeout-minutes: 5
+    permissions:
+      actions: read
+      contents: read
     outputs:
+      sha: ${{ steps.commit.outputs.sha }}
       ok: ${{ github.event_name == 'workflow_dispatch' || (github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.event == 'push' && github.event.workflow_run.head_branch == 'main') }}
     steps:
+      # The commit every other job checks out. A workflow_run's is read from the CI run itself through the API (by its number), not taken from
+      # the event's text, and either is refused unless it is 40 lowercase hex: no job reads the event's commit, they all read this output.
       - name: The commit under test
+        id: commit
         env:
-          SHA: ${{ github.event.workflow_run.head_sha || inputs.sha }}
-        run: echo "FULL lane for commit $SHA" >> "$GITHUB_STEP_SUMMARY"
+          EVENT: ${{ github.event_name }}
+          RUN_ID: ${{ github.event.workflow_run.id }}
+          INPUT_SHA: ${{ inputs.sha }}
+          REPO: ${{ github.repository }}
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          fail() { echo "::error title=full.yml::$1"; exit 1; }
+          if [ "$EVENT" = workflow_run ]; then
+            [[ "$RUN_ID" =~ ^[0-9]+$ ]] || fail "the CI run has no number"
+            sha=$(gh api "repos/$REPO/actions/runs/$RUN_ID" --jq .head_sha) || fail "couldn't read the CI run"
+          else
+            sha=$INPUT_SHA
+          fi
+          [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || fail "the commit under test is not 40 lowercase hex characters"
+          echo "sha=$sha" >> "$GITHUB_OUTPUT"
+          echo "FULL lane for commit $sha" >> "$GITHUB_STEP_SUMMARY"
 
   spikes:
     needs: trigger
@@ -48,7 +69,7 @@ jobs:
     steps:
       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
         with:
-          ref: ${{ github.event.workflow_run.head_sha || inputs.sha }}
+          ref: ${{ needs.trigger.outputs.sha }}
           persist-credentials: false
       - uses: actions/setup-dotnet@0f4a354dd5547a28c70b7853dbd95d5b67886e73 # v6.1.0
         with:
@@ -107,7 +128,7 @@ jobs:
     steps:
       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
         with:
-          ref: ${{ github.event.workflow_run.head_sha || inputs.sha }}
+          ref: ${{ needs.trigger.outputs.sha }}
           persist-credentials: false
       - uses: actions/setup-dotnet@0f4a354dd5547a28c70b7853dbd95d5b67886e73 # v6.1.0
         with:
diff --git a/tests/AgentBridge.Quality.Tests/FullWorkflowTests.cs b/tests/AgentBridge.Quality.Tests/FullWorkflowTests.cs
index 9c1537d2a..2243eb31f 100644
--- a/tests/AgentBridge.Quality.Tests/FullWorkflowTests.cs
+++ b/tests/AgentBridge.Quality.Tests/FullWorkflowTests.cs
@@ -8,7 +8,7 @@ namespace AgentBridge.Quality.Tests;
 /// </summary>
 public class FullWorkflowTests
 {
-    const string Sha = "${{ github.event.workflow_run.head_sha || inputs.sha }}";
+    const string Sha = "${{ needs.trigger.outputs.sha }}";
 
     static string Root => ChangedFiles.RepoRoot(AppContext.BaseDirectory);
 
@@ -140,4 +140,24 @@ public class FullWorkflowTests
             .Single(s => s.Children.ContainsKey("uses") && Scalar(s, "uses").StartsWith("actions/cache/save@", StringComparison.Ordinal));
         Assert.Contains("inputs.save == 'true'", Scalar(save, "if"), StringComparison.Ordinal);
     }
+
+    /// <summary>
+    /// CodeQL's cache-poisoning alerts on #4254: FULL runs in the default branch's context and checks out a commit to test. Only the trigger job reads the
+    /// event's commit: it reads the CI run itself through the API (by number), refuses anything but 40 lowercase hex, and every other job checks out that
+    /// output, so no checkout or cache step takes a commit straight from the event.
+    /// </summary>
+    [Fact]
+    public void Only_the_trigger_reads_the_events_commit_and_hands_on_a_verified_one_that_every_checkout_uses()
+    {
+        var text = File.ReadAllText(Path.Combine(Root, ".github", "workflows", "full.yml")).Replace("\r\n", "\n");
+        var trigger = (YamlMappingNode)Jobs("full.yml")["trigger"];
+        var step = ((YamlSequenceNode)trigger["steps"]).Children.OfType<YamlMappingNode>().Single(s => s.Children.ContainsKey("id") && Scalar(s, "id") == "commit");
+        var script = Scalar(step, "run");
+
+        Assert.Equal("${{ steps.commit.outputs.sha }}", Scalar(trigger["outputs"], "sha"));
+        Assert.Equal("read", Scalar(trigger["permissions"], "actions"));
+        foreach (var part in new[] { "gh api \"repos/$REPO/actions/runs/$RUN_ID\" --jq .head_sha", "^[0-9]+$", "^[0-9a-f]{40}$", "sha=$sha\" >> \"$GITHUB_OUTPUT\"" })
+            Assert.Contains(part, script, StringComparison.Ordinal);
+        Assert.DoesNotContain("github.event.workflow_run.head_sha", text, StringComparison.Ordinal);
+    }
 }
\ No newline at end of file
