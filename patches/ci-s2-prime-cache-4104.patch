diff --git a/.github/workflows/prime-playwright-cache.yml b/.github/workflows/prime-playwright-cache.yml
new file mode 100644
index 000000000..f46be743a
--- /dev/null
+++ b/.github/workflows/prime-playwright-cache.yml
@@ -0,0 +1,71 @@
+name: Prime Playwright cache
+
+# Fills the Playwright system-package archives cache that the FULL lane restores, on main only (S2, #4104). full.yml runs from a workflow_run, in the default branch's context, so it only RESTORES
+# caches and never writes one (CodeQL's cache-poisoning alerts). A cold key is therefore filled here, from main's own checked-in code, in main's cache scope, where FULL reads it.
+#
+# It runs on a push to main that can change a key (the action, this file, a package lock that moves Playwright's version), daily (the runner image rolls without a repository change, and a key
+# carries the image's version), and by hand. NEVER for a pull request or a workflow_run. A dispatch on any ref but main runs nothing (the job is main-only): a run from a branch would write only
+# that ref's cache scope, which FULL never reads, so the way to prime it by hand is `gh workflow run prime-playwright-cache.yml --ref main`.
+#
+# The download is the same bounded, mirror-rotating one every job uses (.github/actions/playwright-system-packages): every .deb is checked against the hash the signed index gave before the step
+# says cache-ready, and the save step is the very next step, runs only on success, and saves exactly the key the restore used (the action's cache-key output), so a download that did not verify is
+# never saved. The token is read-only: actions/cache saves through the runner's cache service, which needs no token scope (`actions: write` is only for the REST API that deletes caches, unused here).
+on:
+  push:
+    branches: [main]
+    paths:
+      - .github/actions/playwright-system-packages/**
+      - .github/actions/playwright-system-packages-save/**
+      - .github/workflows/prime-playwright-cache.yml
+      - pwa/package-lock.json
+      - spikes/s2-noise-interop/package-lock.json
+      - spikes/s4-relay/package-lock.json
+  schedule:
+    - cron: '41 5 * * *'
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+# One run at a time, never cancelled mid-save: two runs of this workflow cannot race the same key.
+concurrency:
+  group: prime-playwright-cache
+  cancel-in-progress: false
+
+jobs:
+  prime:
+    # Only main: a run by hand on another branch would write that branch's scope, which FULL never reads.
+    if: github.ref == 'refs/heads/main' && github.repository == 'danswett/agent-bridge'
+    name: prime (${{ matrix.dir }}, ${{ matrix.browsers }})
+    runs-on: ubuntu-24.04
+    timeout-minutes: 45
+    strategy:
+      fail-fast: false
+      matrix:
+        # Exactly the sets full.yml restores: the PWA's legs (one browser each, and both for pwa-e2e) and the two spikes.
+        include:
+          - { dir: pwa, browsers: chromium }
+          - { dir: pwa, browsers: webkit }
+          - { dir: pwa, browsers: chromium webkit }
+          - { dir: spikes/s2-noise-interop, browsers: chromium webkit }
+          - { dir: spikes/s4-relay, browsers: chromium webkit }
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
+        with:
+          node-version: '22'
+      - run: npm ci
+        working-directory: ${{ matrix.dir }}
+      - name: Download Playwright's system packages
+        id: system-packages
+        uses: ./.github/actions/playwright-system-packages
+        with:
+          browsers: ${{ matrix.browsers }}
+          working-directory: ${{ matrix.dir }}
+      - name: Save Playwright's system-package archives
+        if: success() && steps.system-packages.outputs.cache-ready == 'true'
+        uses: ./.github/actions/playwright-system-packages-save
+        with:
+          key: ${{ steps.system-packages.outputs.cache-key }}
