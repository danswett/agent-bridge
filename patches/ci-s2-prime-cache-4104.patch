diff --git a/tests/AgentBridge.Quality.Tests/PrimeCacheWorkflowTests.cs b/tests/AgentBridge.Quality.Tests/PrimeCacheWorkflowTests.cs
new file mode 100644
index 000000000..cb3b40ab8
--- /dev/null
+++ b/tests/AgentBridge.Quality.Tests/PrimeCacheWorkflowTests.cs
@@ -0,0 +1,141 @@
+using YamlDotNet.RepresentationModel;
+
+namespace AgentBridge.Quality.Tests;
+
+/// <summary>
+/// prime-playwright-cache.yml (S2, #4104): full.yml restores Playwright's system-package archives but never writes a cache (it runs in the default branch's context), so a cold key is filled here, from
+/// main's own checked-in code in main's cache scope, where FULL reads it. The workflow must be that and nothing more: it can never run for a pull request or from a branch, it only reads the repository,
+/// it saves exactly the key the restore used and only after every .deb was verified against the signed indexes, and two runs never race.
+/// </summary>
+public class PrimeCacheWorkflowTests
+{
+    const string Restore = "./.github/actions/playwright-system-packages", Save = "./.github/actions/playwright-system-packages-save";
+    const string File_ = "prime-playwright-cache.yml";
+
+    static string Root => ChangedFiles.RepoRoot(AppContext.BaseDirectory);
+
+    static YamlMappingNode Load(string path)
+    {
+        var stream = new YamlStream();
+        stream.Load(new StringReader(File.ReadAllText(Path.Combine(Root, path))));
+        return (YamlMappingNode)stream.Documents[0].RootNode;
+    }
+
+    static YamlMappingNode Workflow() => Load($".github/workflows/{File_}");
+
+    static string Scalar(YamlNode node, string key) => ((YamlScalarNode)((YamlMappingNode)node)[key]).Value!;
+
+    static YamlMappingNode Prime() => (YamlMappingNode)((YamlMappingNode)Workflow()["jobs"])["prime"];
+
+    static List<YamlMappingNode> Steps(YamlMappingNode job) => ((YamlSequenceNode)job["steps"]).Children.OfType<YamlMappingNode>().ToList();
+
+    static bool Uses(YamlMappingNode s, string action) => s.Children.ContainsKey("uses") && Scalar(s, "uses") == action;
+
+    [Fact]
+    public void It_runs_only_on_a_push_to_main_on_a_schedule_and_by_hand_never_for_a_pull_request_or_a_workflow_run()
+    {
+        var on = (YamlMappingNode)Workflow()["on"];
+        var push = (YamlMappingNode)on["push"];
+
+        Assert.Equal(["push", "schedule", "workflow_dispatch"], on.Children.Keys.Select(k => k.ToString()).Order(StringComparer.Ordinal));
+        Assert.Equal(["main"], ((YamlSequenceNode)push["branches"]).Children.Select(c => c.ToString()));
+        // only a change that can change a key: the action, this workflow, and a package lock that moves Playwright's version
+        var paths = ((YamlSequenceNode)push["paths"]).Children.Select(c => c.ToString()).ToList();
+        Assert.Contains(".github/actions/playwright-system-packages/**", paths);
+        Assert.Contains(".github/workflows/prime-playwright-cache.yml", paths);
+        Assert.Contains("pwa/package-lock.json", paths);
+        Assert.NotEmpty(((YamlSequenceNode)on["schedule"]).Children);
+        // the image rolls without a repository change, so a schedule re-primes a key that went cold
+        Assert.Matches(@"^\d+ \d+ \* \* \*$", Scalar(((YamlSequenceNode)on["schedule"]).Children[0], "cron")); // daily
+    }
+
+    [Fact]
+    public void It_reads_the_repository_only_holds_no_secret_runs_only_on_main_and_checks_out_without_credentials()
+    {
+        var workflow = Workflow();
+        var job = Prime();
+
+        Assert.Equal(["contents"], ((YamlMappingNode)workflow["permissions"]).Children.Keys.Select(k => k.ToString())); // no actions: write: the cache service needs no token scope, only the REST delete API does
+        Assert.Equal("read", Scalar(workflow["permissions"], "contents"));
+        Assert.False(job.Children.ContainsKey("permissions"));
+        Assert.Contains("github.ref == 'refs/heads/main'", Scalar(job, "if"), StringComparison.Ordinal); // a dispatch on a branch runs nothing
+        Assert.Contains("github.repository == 'danswett/agent-bridge'", Scalar(job, "if"), StringComparison.Ordinal);
+        Assert.DoesNotContain("secrets.", File.ReadAllText(Path.Combine(Root, ".github", "workflows", File_)), StringComparison.Ordinal);
+        var checkout = Steps(job).Single(s => s.Children.ContainsKey("uses") && Scalar(s, "uses").StartsWith("actions/checkout@", StringComparison.Ordinal));
+        Assert.Equal("false", Scalar(checkout["with"], "persist-credentials"));
+        Assert.False(((YamlMappingNode)checkout["with"]).Children.ContainsKey("ref"));
+    }
+
+    [Fact]
+    public void Two_runs_never_race_the_same_key_one_group_and_no_cancelling_of_a_save_in_flight()
+    {
+        var group = (YamlMappingNode)Workflow()["concurrency"];
+
+        Assert.Equal("prime-playwright-cache", Scalar(group, "group"));
+        Assert.Equal("false", Scalar(group, "cancel-in-progress"));
+    }
+
+    [Fact]
+    public void It_downloads_with_the_restore_action_then_saves_the_exact_key_it_restored_and_only_once_every_deb_was_verified()
+    {
+        var steps = Steps(Prime());
+        var restore = steps.Single(s => Uses(s, Restore));
+        var save = steps.Single(s => Uses(s, Save));
+
+        Assert.Equal("system-packages", Scalar(restore, "id"));
+        Assert.Equal(steps.IndexOf(restore) + 1, steps.IndexOf(save)); // nothing between the verified download and the save
+        Assert.Equal("success() && steps.system-packages.outputs.cache-ready == 'true'", Scalar(save, "if"));
+        Assert.Equal("${{ steps.system-packages.outputs.cache-key }}", Scalar(save["with"], "key"));
+        // that output IS the key the restore step used, not a recomputed one
+        var action = Load(".github/actions/playwright-system-packages/action.yml");
+        var actionSteps = ((YamlSequenceNode)((YamlMappingNode)action["runs"])["steps"]).Children.OfType<YamlMappingNode>().ToList();
+        var debs = actionSteps.Single(s => s.Children.ContainsKey("id") && Scalar(s, "id") == "debs");
+        Assert.StartsWith("actions/cache/restore@", Scalar(debs, "uses"), StringComparison.Ordinal);
+        Assert.Equal("${{ steps.debs.outputs.cache-primary-key }}", Scalar(((YamlMappingNode)action["outputs"])["cache-key"], "value"));
+        Assert.Equal("${{ steps.packages.outputs.cache-ready }}", Scalar(((YamlMappingNode)action["outputs"])["cache-ready"], "value"));
+    }
+
+    [Fact]
+    public void The_download_says_cache_ready_only_after_it_checked_every_deb_against_the_signed_index()
+    {
+        var script = File.ReadAllText(Path.Combine(Root, ".github", "actions", "playwright-system-packages", "download.sh"));
+
+        var ready = script.LastIndexOf("cache-ready=true", StringComparison.Ordinal);
+        Assert.True(ready > 0);
+        Assert.Single(System.Text.RegularExpressions.Regex.Matches(script, "cache-ready=true"));
+        Assert.True(script.LastIndexOf("sha256sum --check", StringComparison.Ordinal) < ready, "cache-ready must come after the last hash check against the signed index");
+        // a deb is copied into the cache only when it passed that check: the fetch is verified before it is kept
+        Assert.Contains("sha256sum --check --status", script, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public void It_primes_exactly_the_package_sets_the_FULL_lane_restores()
+    {
+        var matrix = ((YamlSequenceNode)((YamlMappingNode)((YamlMappingNode)Prime()["strategy"])["matrix"])["include"]).Children
+            .Select(e => (Dir: Scalar(e, "dir"), Browsers: Scalar(e, "browsers"))).ToList();
+        var fullCalls = ((YamlMappingNode)Load(".github/workflows/full.yml")["jobs"]).Children.Values
+            .SelectMany(j => ((YamlSequenceNode)((YamlMappingNode)j)["steps"]).Children.OfType<YamlMappingNode>())
+            .Where(s => Uses(s, Restore)).ToList();
+
+        Assert.NotEmpty(fullCalls);
+        Assert.Equal(matrix.Count, matrix.Distinct().Count());
+        foreach (var call in fullCalls)
+        {
+            var dir = Scalar(call["with"], "working-directory");
+            var browsers = Scalar(call["with"], "browsers");
+            // a pwa-ui leg's browser is its matrix project: chromium or webkit
+            var wanted = browsers == "${{ matrix.project }}" ? new[] { (dir, "chromium"), (dir, "webkit") } : [(dir, browsers)];
+            Assert.All(wanted, w => Assert.Contains(w, matrix));
+        }
+    }
+
+    [Fact]
+    public void The_README_says_to_dispatch_it_on_main_because_a_branch_run_would_write_only_that_refs_scope()
+    {
+        var readme = File.ReadAllText(Path.Combine(Root, "quality", "README.md"));
+
+        Assert.Contains("prime-playwright-cache.yml", readme, StringComparison.Ordinal);
+        Assert.Contains("gh workflow run prime-playwright-cache.yml --ref main", readme, StringComparison.Ordinal);
+        Assert.Contains("only that ref's cache scope", readme, StringComparison.Ordinal);
+    }
+}
