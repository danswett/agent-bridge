{
  "_about": "Language-neutral contract for the Slipgates MCP server (beta-messaging.md sec 5). The Node runner (mcp/test/contract.test.mjs) and the .NET server's runner execute THIS file. Placeholders: \"$uuid\" any UUID, \"$any\" any value, \"$absent\" key must be missing, \"re:<regex>\" text class. Objects match as subsets, arrays by length then element. replies maps host op to a result, or {\"$error\":\"text\"} (host refuses). host.hang and host.close list ops the host never answers / answers by closing. token:false = no AGENT_BRIDGE_TOKEN. steps[].ops are the pipe ops after the hello pair, in order; noOps are op-name prefixes that must never appear; onlyOps is the allowlist for the whole case.",
  "ids": { "s": "11111111-1111-4111-8111-111111111111", "r": "22222222-2222-4222-8222-222222222222" },
  "allOps": ["sessions.list", "session.get", "session.reply", "session.launch", "launch.status", "launch.options", "usage.get", "fleet.end"],
  "cases": [
    { "name": "no host: no tools, calls are errors", "hostless": true, "tools": [],
      "steps": [{ "tool": "list_agent_sessions", "args": {}, "expect": { "error": true } }] },
    { "name": "a refused agent.hello fails the open: no tools", "host": { "caps": ["sessions.read"], "helloError": true }, "tools": [] },
    { "name": "listing follows the capabilities: read only", "host": { "caps": ["sessions.read"], "principal": "p" }, "tools": ["list_agent_sessions", "read_agent_session"] },
    { "name": "listing follows the capabilities: reply adds reply", "host": { "caps": ["sessions.read", "sessions.reply"], "principal": "p" }, "tools": ["list_agent_sessions", "read_agent_session", "reply_to_agent_session"] },
    { "name": "listing follows the capabilities: launch adds end, launch, result, options", "host": { "caps": ["sessions.launch"], "principal": "p" },
      "tools": ["end_agent_session", "get_launch_options", "launch_agent_session", "read_launch_result"] },
    { "name": "every capability lists exactly the eight tools, none to stop, answer, approve or trust", "host": { "caps": ["sessions.read", "sessions.reply", "sessions.launch", "usage"], "principal": "p" },
      "tools": ["end_agent_session", "get_launch_options", "launch_agent_session", "list_agent_sessions", "read_agent_session", "read_agent_usage", "read_launch_result", "reply_to_agent_session"] },
    { "name": "unattributed lists only list and read, and refuses the rest with no pipe call", "host": { "caps": ["sessions.read", "sessions.reply", "sessions.launch", "usage"], "token": false },
      "tools": ["list_agent_sessions", "read_agent_session"],
      "steps": [
        { "tool": "reply_to_agent_session", "args": { "session_id": "s1", "text": "hi" }, "expect": { "error": true, "noOps": ["session.", "fleet.", "launch.", "usage."] } },
        { "tool": "end_agent_session", "args": { "session_id": "$s" }, "expect": { "error": true, "noOps": ["fleet."] } },
        { "tool": "read_agent_usage", "args": {}, "expect": { "error": true, "noOps": ["usage."] } }] },
    { "name": "usage is hidden without the exact usage capability", "host": { "caps": ["usage.shared", "usage.write", "future.usage"], "principal": "p" }, "tools": [],
      "steps": [{ "tool": "read_agent_usage", "args": {}, "expect": { "error": true, "text": "re:not available", "noOps": ["usage."] } }] },
    { "name": "usage keeps allowance fields and a host refusal stays an error", "host": { "caps": ["usage"], "principal": "p", "replies": { "usage.get": { "agents": [{ "agent": "codex", "windows": [], "error": "No reading" }] } } },
      "steps": [
        { "tool": "read_agent_usage", "args": {}, "expect": { "out": { "agents": [{ "agent": "codex", "windows": [], "error": "No reading" }] }, "ops": [{ "op": "usage.get", "data": {} }] } },
        { "tool": "read_agent_usage", "args": { "scope": "fleet", "machine": "m2" }, "expect": { "error": true } }] },
    { "name": "usage refusal from the host is an error, not an empty report", "host": { "caps": ["usage"], "principal": "p", "replies": { "usage.get": { "$error": "no usage here" } } },
      "steps": [{ "tool": "read_agent_usage", "args": {}, "expect": { "error": true } }] },
    { "name": "list hides the working folder by default and shows it only with include content", "host": { "caps": ["sessions.read"], "principal": "p",
        "replies": { "sessions.list": { "sessions": [{ "id": "s1", "agent": "claude", "title": "T", "repository": "r", "branch": "b", "status": "idle", "cwd": "C:/work", "activity": { "response": "hi" } }] } } },
      "steps": [
        { "tool": "list_agent_sessions", "args": {}, "expect": { "out": { "sessions": [{ "id": "s1", "title": "T", "repository": "r", "branch": "b", "cwd": "$absent", "activity": "$absent" }] } } },
        { "tool": "list_agent_sessions", "args": { "include": "content" }, "expect": { "out": { "sessions": [{ "id": "s1", "cwd": "C:/work", "activity": { "response": "hi" } }] } } },
        { "tool": "list_agent_sessions", "args": { "include": "everything" }, "expect": { "error": true } }] },
    { "name": "same-person scope: list and reply reach this machine only, scope and machine arguments send nothing wider", "host": { "caps": ["sessions.read", "sessions.reply"], "principal": "p",
        "replies": { "sessions.list": { "sessions": [] }, "session.get": { "id": "s1", "status": "idle", "activity": { "turnCount": 1, "response": "hello" } }, "session.reply": { "outcome": "delivered" } } },
      "steps": [
        { "tool": "list_agent_sessions", "args": { "scope": "fleet" }, "expect": { "ops": [{ "op": "sessions.list", "data": {} }] } },
        { "tool": "reply_to_agent_session", "args": { "session_id": "s1", "text": "x", "machine": "other" }, "expect": { "ops": [{ "op": "session.get" }, { "op": "session.reply", "data": { "machine": "$absent" } }] } }] },
    { "name": "reply sends the whole text under a fresh request id and returns since", "host": { "caps": ["sessions.reply"], "principal": "p",
        "replies": { "session.get": { "id": "s1", "status": "idle", "activity": { "turnCount": 1, "response": "hello" } }, "session.reply": { "outcome": "delivered" } } },
      "steps": [{ "tool": "reply_to_agent_session", "args": { "session_id": "s1", "text": "héllo" },
        "expect": { "out": { "id": "s1", "outcome": "delivered", "sent": 6, "since": "79057cc0d6ced65f" }, "ops": [{ "op": "session.get", "data": { "id": "s1" } }, { "op": "session.reply", "data": { "id": "s1", "request": "$uuid", "text": "héllo" } }] } }] },
    { "name": "a refusing host is reported as refused with its reason and no since; the same-person refusal text passes through", "host": { "caps": ["sessions.reply"], "principal": "p",
        "replies": { "session.get": { "id": "s1", "status": "idle" }, "session.reply": { "outcome": "refused", "reason": "notSameAccount" } } },
      "steps": [{ "tool": "reply_to_agent_session", "args": { "session_id": "s1", "text": "x" }, "expect": { "out": { "outcome": "refused", "reason": "notSameAccount", "since": "$absent" } } }] },
    { "name": "reply to a missing session is refused without a reply op", "host": { "caps": ["sessions.reply"], "principal": "p", "replies": { "session.get": { "missing": true } } },
      "steps": [{ "tool": "reply_to_agent_session", "args": { "session_id": "gone", "text": "x" }, "expect": { "out": { "outcome": "refused" }, "ops": [{ "op": "session.get" }] } }] },
    { "name": "reply with a host that never answers (15 s) is unknown, not thrown", "slow": true, "host": { "caps": ["sessions.reply"], "principal": "p", "hang": ["session.reply"],
        "replies": { "session.get": { "id": "s1", "status": "idle" } } },
      "steps": [{ "tool": "reply_to_agent_session", "args": { "session_id": "s1", "text": "x" }, "expect": { "out": { "outcome": "unknown", "since": "$any" } } }] },
    { "name": "reply with a host that closes mid-request is unknown", "host": { "caps": ["sessions.reply"], "principal": "p", "close": ["session.reply"],
        "replies": { "session.get": { "id": "s1", "status": "idle" } } },
      "steps": [{ "tool": "reply_to_agent_session", "args": { "session_id": "s1", "text": "x" }, "expect": { "out": { "outcome": "unknown" } } }] },
    { "name": "read is not done while the turn is unchanged, and done with the answer once it moved", "host": { "caps": ["sessions.read"], "principal": "p",
        "replies": { "session.get": { "id": "s1", "status": "idle", "statusSince": "t9", "activity": { "turnCount": 1, "response": "hello" } } } },
      "steps": [
        { "tool": "read_agent_session", "args": { "session_id": "s1", "since": "79057cc0d6ced65f" }, "expect": { "out": { "found": true, "done": false, "response": "" } } },
        { "tool": "read_agent_session", "args": { "session_id": "s1", "since": "0000000000000000" }, "expect": { "out": { "found": true, "done": true, "response": "hello", "since": "79057cc0d6ced65f" } } },
        { "tool": "read_agent_session", "args": { "session_id": "s1" }, "expect": { "out": { "done": true, "response": "hello" } } }] },
    { "name": "read of an unknown session is found false", "host": { "caps": ["sessions.read"], "principal": "p", "replies": { "session.get": { "missing": true } } },
      "steps": [{ "tool": "read_agent_session", "args": { "session_id": "nope" }, "expect": { "out": { "found": false, "done": false } } }] },
    { "name": "launch defaults the role, maps permissions, remembers the outcome; read_launch_result returns it", "host": { "caps": ["sessions.launch"], "principal": "p",
        "replies": { "session.launch": { "outcome": "launched", "session": "s9" } } },
      "steps": [
        { "tool": "launch_agent_session", "args": { "request": "req-1", "prompt": "go", "permissions": "Allow all", "machine": "other" },
          "expect": { "out": { "request": "req-1", "outcome": "launched", "session": "s9" }, "ops": [{ "op": "session.launch", "data": { "request": "req-1", "prompt": "go", "role": "default", "permissions": "allowAll", "machine": "$absent" } }] } },
        { "tool": "read_launch_result", "args": { "request": "req-1" }, "expect": { "out": { "outcome": "launched", "session": "s9" } } },
        { "tool": "read_launch_result", "args": { "request": "never" }, "expect": { "out": { "status": "unknown" } } }] },
    { "name": "launch keeps an explicit role and generates a request id when none is given", "host": { "caps": ["sessions.launch"], "principal": "p", "replies": { "session.launch": { "outcome": "launched" } } },
      "steps": [{ "tool": "launch_agent_session", "args": { "role": "reviewer" }, "expect": { "out": { "request": "$any" }, "ops": [{ "op": "session.launch", "data": { "role": "reviewer", "request": "$any" } }] } }] },
    { "name": "launch rejects a null, empty or blank role and a bad request id with no pipe call", "host": { "caps": ["sessions.launch"], "principal": "p", "replies": { "session.launch": { "outcome": "launched" } } },
      "steps": [
        { "tool": "launch_agent_session", "args": { "role": "" }, "expect": { "error": true, "noOps": ["session."] } },
        { "tool": "launch_agent_session", "args": { "role": "   " }, "expect": { "error": true, "noOps": ["session."] } },
        { "tool": "launch_agent_session", "args": { "role": null }, "expect": { "error": true, "noOps": ["session."] } },
        { "tool": "launch_agent_session", "args": { "request": "bad id with spaces" }, "expect": { "error": true, "noOps": ["session."] } }] },
    { "name": "a launch the host refuses is a refused outcome with its reason", "host": { "caps": ["sessions.launch"], "principal": "p", "replies": { "session.launch": { "$error": "launch not allowed" } } },
      "steps": [{ "tool": "launch_agent_session", "args": { "request": "req-2" }, "expect": { "out": { "request": "req-2", "outcome": "refused", "reason": "re:launch not allowed" } } }] },
    { "name": "get_launch_options passes the host answer through", "host": { "caps": ["sessions.launch"], "principal": "p", "replies": { "launch.options": { "agents": [{ "id": "claude" }] } } },
      "steps": [{ "tool": "get_launch_options", "args": {}, "expect": { "out": { "agents": [{ "id": "claude" }] }, "ops": [{ "op": "launch.options", "data": {} }] } }] },
    { "name": "end_agent_session is fleet.end with no grant and a fresh request id, never session.stop", "host": { "caps": ["sessions.launch"], "principal": "p", "replies": { "fleet.end": { "outcome": "ended" } } },
      "steps": [{ "tool": "end_agent_session", "args": { "session_id": "$s" },
        "expect": { "out": { "id": "$s", "request": "$uuid", "outcome": "ended" }, "ops": [{ "op": "fleet.end", "data": { "version": 1, "request": "$uuid", "grant": "00000000-0000-0000-0000-000000000000", "session": "$s" } }], "noOps": ["session.stop"] } }] },
    { "name": "end_agent_session reports the host's refusal reason and never retries by itself", "host": { "caps": ["sessions.launch"], "principal": "p", "replies": { "fleet.end": { "outcome": "refused", "reason": "not started by an agent" } } },
      "steps": [{ "tool": "end_agent_session", "args": { "session_id": "$s", "request": "$r" }, "expect": { "out": { "request": "$r", "outcome": "refused", "reason": "re:agent" }, "ops": [{ "op": "fleet.end" }] } }] },
    { "name": "end_agent_session local refusals send nothing: missing, short and non-UUID ids, non-UUID request", "host": { "caps": ["sessions.launch"], "principal": "p", "replies": { "fleet.end": { "outcome": "ended" } } },
      "steps": [
        { "tool": "end_agent_session", "args": {}, "expect": { "error": true, "noOps": ["fleet."] } },
        { "tool": "end_agent_session", "args": { "session_id": "0123456789abcdef" }, "expect": { "error": true, "noOps": ["fleet."] } },
        { "tool": "end_agent_session", "args": { "session_id": "$s", "request": "not-a-uuid" }, "expect": { "error": true, "noOps": ["fleet."] } }] },
    { "name": "end_agent_session with a lost pipe is unknown and keeps the same request id", "host": { "caps": ["sessions.launch"], "principal": "p", "close": ["fleet.end"] },
      "steps": [{ "tool": "end_agent_session", "args": { "session_id": "$s", "request": "$r" }, "expect": { "out": { "outcome": "unknown", "request": "$r" } } }] },
    { "name": "end_agent_session with a host that never answers (15 s) is unknown", "slow": true, "host": { "caps": ["sessions.launch"], "principal": "p", "hang": ["fleet.end"] },
      "steps": [{ "tool": "end_agent_session", "args": { "session_id": "$s", "request": "$r" }, "expect": { "out": { "outcome": "unknown", "request": "$r" } } }] },
    { "name": "unknown tools, wrong types and missing arguments are errors before any pipe call", "host": { "caps": ["sessions.read", "sessions.reply", "sessions.launch", "usage"], "principal": "p", "replies": {} },
      "steps": [
        { "tool": "session_stop", "args": {}, "expect": { "error": true } },
        { "tool": "toString", "args": {}, "expect": { "error": true } },
        { "tool": "read_agent_session", "args": {}, "expect": { "error": true } },
        { "tool": "reply_to_agent_session", "args": { "session_id": "s1" }, "expect": { "error": true } },
        { "tool": "reply_to_agent_session", "args": { "session_id": "s1", "text": "$long" }, "expect": { "error": true } },
        { "tool": "read_launch_result", "args": {}, "expect": { "error": true, "noOps": ["session.", "launch.", "fleet.", "usage."] } }] },
    { "name": "using every tool touches only the allowed ops, never an answer, approval, trust or stop", "host": { "caps": ["sessions.read", "sessions.reply", "sessions.launch", "usage"], "principal": "p",
        "replies": { "sessions.list": { "sessions": [] }, "session.get": { "id": "s1", "status": "idle" }, "session.reply": { "outcome": "delivered" }, "session.launch": { "outcome": "launched" },
          "launch.options": {}, "usage.get": { "agents": [] }, "fleet.end": { "outcome": "ended" } } },
      "onlyOps": "allOps",
      "steps": [
        { "tool": "list_agent_sessions", "args": {}, "expect": {} }, { "tool": "read_agent_session", "args": { "session_id": "s1" }, "expect": {} },
        { "tool": "reply_to_agent_session", "args": { "session_id": "s1", "text": "x" }, "expect": {} }, { "tool": "launch_agent_session", "args": {}, "expect": {} },
        { "tool": "get_launch_options", "args": {}, "expect": {} }, { "tool": "read_agent_usage", "args": {}, "expect": {} },
        { "tool": "end_agent_session", "args": { "session_id": "$s" }, "expect": {} }] }
  ]
}
