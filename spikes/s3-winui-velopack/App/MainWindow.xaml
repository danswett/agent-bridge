<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AgentBridgeS3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Agent Bridge S3">
    <StackPanel Padding="24" Spacing="12">
        <TextBlock Text="Agent Bridge spike S3" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock x:Name="VersionText" AutomationProperties.AutomationId="Version" Text="Version: ?" />
        <TextBlock x:Name="LaunchText" AutomationProperties.AutomationId="LaunchKind" Text="Launched: ?" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ShowToast" AutomationProperties.AutomationId="ShowToast" Content="Show question toast" Click="ShowToast_Click" />
            <Button x:Name="ToastAndExit" AutomationProperties.AutomationId="ToastAndExit" Content="Show toast, then exit" Click="ToastAndExit_Click" />
            <Button x:Name="CheckUpdates" AutomationProperties.AutomationId="CheckUpdates" Content="Check for updates" Click="CheckUpdates_Click" />
        </StackPanel>
        <TextBlock Text="Last answer from a toast:" />
        <TextBlock x:Name="AnswerText" AutomationProperties.AutomationId="LastAnswer" Text="(none)" TextWrapping="Wrap" />
        <TextBlock x:Name="UpdateText" AutomationProperties.AutomationId="UpdateStatus" Text="" TextWrapping="Wrap" />
    </StackPanel>
</Window>
