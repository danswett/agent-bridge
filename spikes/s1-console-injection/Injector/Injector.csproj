<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: the GUI subsystem, so the process starts with no console at all.
         That is the property under test: the PowerShell daemon is a console process
         and must be launched with a hidden real console to inject. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>s1-injector</AssemblyName>
  </PropertyGroup>

</Project>
