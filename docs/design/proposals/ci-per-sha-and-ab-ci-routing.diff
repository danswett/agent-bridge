       matrix:
         os: ${{ fromJSON(needs.plan.outputs.product-os) }}
-    runs-on: ${{ matrix.os }}
+    # Windows x64 runs on the ab-ci pool for a push or a pull request from this repository, and on a hosted runner
+    # otherwise (a fork never reaches a persistent runner); the variable flips the pool off without a workflow change.
+    # quality/README.md, "CI: speed, runners and what gates main"; CiRunnerRoutingTests holds the guard.
+    runs-on: ${{ (matrix.os == 'windows-latest' && vars.AB_CI_SELF_HOSTED == 'true' && (github.event_name == 'push' || github.event.pull_request.head.repo.full_name == github.repository)) && fromJSON('["self-hosted","windows","x64","ab-ci"]') || matrix.os }}
     # A clean run takes about five minutes. The Linux test step has hung in dotnet test for hours
