+            $passed = @(gh api "repos/$env:REPO/actions/workflows/ci.yml/runs?branch=main&event=push&status=success&per_page=100" --jq '.workflow_runs[] | [.id, .head_sha] | @tsv')
             if ($LASTEXITCODE) {
               "::warning title=plan::couldn't read main's passed CI runs, so the whole ring runs"
             } else {
-              foreach ($sha in $passed) {
-                if ($sha -notmatch '^[0-9a-f]{40}$') { "::warning title=plan::unreadable run head '$sha', so the whole ring runs"; break }
+              $runIds = @{}
+              foreach ($row in $passed) { $id, $sha = $row -split "`t"; if ($sha -cmatch '^[0-9a-f]{40}$' -and -not $runIds.ContainsKey($sha)) { $runIds[$sha] = $id } }
+              # The in-flight parent a passed run relied on to test only its own change: its plan job's plan-base notice. $null for none or no record
+              # (a run from before the record), '?' when it can't be read or isn't in the shape.
+              function Get-Relied([string] $runId) {
+                $job = @(gh api "repos/$env:REPO/actions/runs/$runId/jobs?filter=latest&per_page=100" --jq '.jobs[] | select(.name == "plan") | .id')
+                if ($LASTEXITCODE) { return '?' }
+                if ($job.Count -eq 0) { return $null }
+                $note = @(gh api "repos/$env:REPO/check-runs/$($job[0])/annotations?per_page=100" --jq '.[] | select(.title == "plan-base") | .message')
+                if ($LASTEXITCODE) { return '?' }
+                if ($note.Count -eq 0) { return $null }
