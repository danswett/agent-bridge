+              function Test-Covered([string] $sha) {
+                for ($depth = 0; $sha; $depth++) {
+                  if ($depth -ge 20 -or -not $runIds.ContainsKey($sha)) { return $false }
+                  $parent = Get-Relied $runIds[$sha]
+                  if ($parent -ceq '?') { return $false }
+                  $sha = $parent
+                }
+                return $true
+              }
