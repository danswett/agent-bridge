diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 0c08cb8a..bae282f7 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -167,7 +167,26 @@ jobs:
           $base = 'HEAD^1'
           $known = $env:EVENT -eq 'pull_request'
           if ($env:EVENT -eq 'push') {
-            $passed = @(gh api "repos/$env:REPO/actions/workflows/ci.yml/runs?branch=main&event=push&status=success&per_page=100" --jq '.workflow_runs[] | [.id, .head_sha] | @tsv')
+            # While the first parent's own run is still going it will test the parent's change (a main commit's run is never cancelled by a later
+            # push), so this run tests only its own diff, and records the parent as what it relied on (the judges then count this run green only if
+            # that parent is). A parent still running after 2 hours is a zombie, not relied on; one that failed or was cancelled carries its change
+            # forward through the passed base below, as before. Release debt (below) still widens the base: that run then relies on nothing.
+            $relied = $null
+            $parent = git rev-parse HEAD^1
+            if ($LASTEXITCODE -eq 0 -and $parent -cmatch '^[0-9a-f]{40}$') {
+              $parentRuns = @(gh api "repos/$env:REPO/actions/workflows/ci.yml/runs?branch=main&event=push&head_sha=$parent&per_page=20" --jq '.workflow_runs[] | [.status, .created_at] | @tsv')
+              if ($LASTEXITCODE) {
+                "::warning title=plan::couldn't read the first parent's CI runs, so this run doesn't rely on them"
+              } else {
+                foreach ($row in $parentRuns) {
+                  $state, $created = $row -split "`t"
+                  $at = [datetimeoffset]::MinValue
+                  if (($state -cin 'queued', 'in_progress', 'waiting', 'pending', 'requested') -and [datetimeoffset]::TryParse($created, [cultureinfo]::InvariantCulture, [System.Globalization.DateTimeStyles]::AssumeUniversal, [ref] $at) -and ([datetimeoffset]::UtcNow - $at) -le [timespan]::FromHours(2)) { $relied = $parent }
+                }
+              }
+            }
+            $passed = @()
+            if (-not $relied) { $passed = @(gh api "repos/$env:REPO/actions/workflows/ci.yml/runs?branch=main&event=push&status=success&per_page=100" --jq '.workflow_runs[] | [.id, .head_sha] | @tsv') }
             if ($LASTEXITCODE) {
               "::warning title=plan::couldn't read main's passed CI runs, so the whole ring runs"
             } else {
@@ -205,6 +224,7 @@ jobs:
                 if ($LASTEXITCODE -eq 0 -and (Test-Covered $sha)) { $base = $sha; $known = $true; break }
               }
             }
+            if ($relied) { $base = $relied; $known = $true }
             # A green run may have skipped publishing because main changed the app again.
             # Never discard that release debt: include everything since the latest published
             # version, not a draft or a retained tag whose release has been deleted.
@@ -244,11 +264,12 @@ jobs:
           "base-known=$($known.ToString().ToLowerInvariant())" | Add-Content -Path $env:GITHUB_OUTPUT -Encoding utf8
           if ($env:EVENT -eq 'push') {
             # What the judges read (merge rule, main_green, the train selector): the commit this run diffed from, and the in-flight parent
-            # run it relied on to test only its own change. None yet: every main run diffs from a passed base. An annotation, because the
+            # run it relied on to test only its own change (none when the base is a passed run or release debt widened it). An annotation, because the
             # judges already read a plan job's annotations through the API and a job output isn't served.
             $recorded = git rev-parse $base
             if ($LASTEXITCODE -ne 0) { throw "git rev-parse $base failed ($LASTEXITCODE)" }
-            "::notice title=plan-base::base=$recorded relied-parent=none"
+            $reliedOn = if ($relied -and $known -and $recorded -ceq $relied) { $relied } else { 'none' }
+            "::notice title=plan-base::base=$recorded relied-parent=$reliedOn"
           }
           if ($known -and $touched.Count -gt 0) {
             $shown = ($touched | Select-Object -First 10 | ForEach-Object { '`' + ($_ -replace '[\x00-\x1f\x7f`]', '?') + '`' }) -join ', '
