<?xml version="1.0" encoding="utf-8"?>
<!-- Public packages only. Machines that cannot reach nuget.org directly set
     AGENT_BRIDGE_NUGET_SOURCE to a mirror for quality/run.ps1, which then restores and audits
     through it with a config of its own (quality/README.md §4). A source option alone is not
     enough: audit still reads nuget.org from here. Keep mirrors out of this file. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
