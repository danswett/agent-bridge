<?xml version="1.0" encoding="utf-8"?>
<!-- Public packages only. Machines that cannot reach nuget.org directly restore with an
     explicit mirror instead (dotnet restore with the source option set to its index.json). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
