<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.10.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generated motion resources the app loads, read by MotionTests as the app reads them. -->
    <None Include="..\..\src\AgentBridge.App\Design\DesignResources.xaml" Link="DesignResources.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Another machine through the in-process relay the transport tests run. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\src\AgentBridge.App.Core\AgentBridge.App.Core.csproj" />
    <!-- The logon task's launcher and its restart rule (HostSupervisorTests). -->
    <ProjectReference Include="..\..\src\AgentBridge.HostLauncher\AgentBridge.HostLauncher.csproj" />
    <ProjectReference Include="..\AgentBridge.Transport.Tests\AgentBridge.Transport.Tests.csproj" />
    <!-- The protocol's worked example of a session with delegates (AttributionTests). -->
    <None Include="..\..\docs\protocol\examples\session-subagents.json" Link="examples\session-subagents.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- What a host sends for adversarial permission prompts, drawn as a card draws it (CopilotPermission, #212). -->
    <ProjectReference Include="..\..\src\AgentBridge.Host.Core\AgentBridge.Host.Core.csproj" />
    <None Include="..\fixtures\approvals\*" Link="fixtures\approvals\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
