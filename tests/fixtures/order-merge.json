{
  "order": [
    { "name": "a concurrent move uses the higher counter",
      "a": { "rows": { "r1": { "value": { "key": "m" }, "counter": 5, "deviceTag": "aa" } } },
      "b": { "rows": { "r1": { "value": { "key": "c" }, "counter": 6, "deviceTag": "01" } } },
      "expected": { "rows": { "r1": { "value": { "key": "c" }, "counter": 6, "deviceTag": "01" } }, "membership": {}, "groups": {} }, "rows": ["r1"], "next": 7 },
    { "name": "equal counters use byte order and normalize hex tags",
      "a": { "rows": { "r1": { "value": { "key": "a" }, "counter": 4, "deviceTag": "0100" } } },
      "b": { "rows": { "r1": { "value": { "key": "b" }, "counter": 4, "deviceTag": "00FF" } } },
      "expected": { "rows": { "r1": { "value": { "key": "a" }, "counter": 4, "deviceTag": "0100" } }, "membership": {}, "groups": {} }, "rows": ["r1"], "next": 5 },
    { "name": "a stale move cannot replace a newer move",
      "a": { "rows": { "r1": { "value": { "key": "x" }, "counter": 9, "deviceTag": "01" } } },
      "b": { "rows": { "r1": { "value": { "key": "y" }, "counter": 3, "deviceTag": "ff" } } },
      "expected": { "rows": { "r1": { "value": { "key": "x" }, "counter": 9, "deviceTag": "01" } }, "membership": {}, "groups": {} }, "rows": ["r1"], "next": 10 },
    { "name": "same position inserts keep both rows in tag then row order",
      "a": { "rows": { "z": { "value": { "key": "m" }, "counter": 1, "deviceTag": "bb" }, "b": { "value": { "key": "m" }, "counter": 1, "deviceTag": "aa" } } },
      "b": { "rows": { "a": { "value": { "key": "m", "pinned": true }, "counter": 1, "deviceTag": "aa" } } },
      "expected": { "rows": { "z": { "value": { "key": "m" }, "counter": 1, "deviceTag": "bb" }, "b": { "value": { "key": "m" }, "counter": 1, "deviceTag": "aa" }, "a": { "value": { "key": "m", "pinned": true }, "counter": 1, "deviceTag": "aa" } }, "membership": {}, "groups": {} }, "rows": ["a", "b", "z"], "next": 2,
      "view": [{ "row": "a", "key": "m", "pinned": true, "deviceTag": "aa", "group": null }, { "row": "b", "key": "m", "pinned": false, "deviceTag": "aa", "group": null }, { "row": "z", "key": "m", "pinned": false, "deviceTag": "bb", "group": null }] },
    { "name": "a delete beats an older move",
      "a": { "rows": { "r1": { "value": { "key": "k" }, "counter": 5, "deviceTag": "01" } } },
      "b": { "rows": { "r1": { "tombstone": true, "counter": 6, "deviceTag": "01" } } },
      "expected": { "rows": { "r1": { "tombstone": true, "counter": 6, "deviceTag": "01" } }, "membership": {}, "groups": {} }, "rows": [], "next": 7 },
    { "name": "a newer move beats an older delete",
      "a": { "rows": { "r1": { "value": { "key": "k" }, "counter": 5, "deviceTag": "01" } } },
      "b": { "rows": { "r1": { "tombstone": true, "counter": 4, "deviceTag": "ff" } } },
      "expected": { "rows": { "r1": { "value": { "key": "k" }, "counter": 5, "deviceTag": "01" } }, "membership": {}, "groups": {} }, "rows": ["r1"], "next": 6 },
    { "name": "a group rename after deletion restores membership",
      "a": { "groups": { "g": { "value": "Office", "counter": 3, "deviceTag": "02" } }, "membership": { "r1": { "value": "g", "counter": 1, "deviceTag": "01" } } },
      "b": { "groups": { "g": { "tombstone": true, "counter": 2, "deviceTag": "03" } } },
      "expected": { "rows": {}, "membership": { "r1": { "value": "g", "counter": 1, "deviceTag": "01" } }, "groups": { "g": { "value": "Office", "counter": 3, "deviceTag": "02" } } }, "rows": [], "next": 4, "groups": { "r1": "g", "unknown": null } },
    { "name": "a deleted group falls back to Sessions",
      "a": { "groups": { "g": { "value": "Office", "counter": 2, "deviceTag": "02" } }, "membership": { "r1": { "value": "g", "counter": 1, "deviceTag": "01" }, "r2": { "value": null, "counter": 1, "deviceTag": "01" } } },
      "b": { "groups": { "g": { "tombstone": true, "counter": 3, "deviceTag": "03" } } },
      "expected": { "rows": {}, "membership": { "r1": { "value": "g", "counter": 1, "deviceTag": "01" }, "r2": { "value": null, "counter": 1, "deviceTag": "01" } }, "groups": { "g": { "tombstone": true, "counter": 3, "deviceTag": "03" } } }, "rows": [], "next": 4, "groups": { "r1": null, "r2": null } },
    { "name": "pin updates stay in the row register",
      "a": { "rows": { "r1": { "value": { "key": "a", "pinned": false }, "counter": 1, "deviceTag": "01" } } },
      "b": { "rows": { "r1": { "value": { "key": "a", "pinned": true }, "counter": 2, "deviceTag": "01" } } },
      "expected": { "rows": { "r1": { "value": { "key": "a", "pinned": true }, "counter": 2, "deviceTag": "01" } }, "membership": {}, "groups": {} }, "rows": ["r1"], "next": 3 },
    { "name": "malformed registers drop without treating prototype keys specially",
      "a": { "rows": { "bad": { "counter": -1, "deviceTag": "01" }, "odd": { "counter": 1, "deviceTag": "zz" }, "unsafe": { "counter": 9007199254740992, "deviceTag": "01" }, "fraction": { "counter": 1.5, "deviceTag": "01" } } },
      "b": { "rows": { "__proto__": { "value": { "key": "x" }, "counter": 1, "deviceTag": "01" } } },
      "expected": { "rows": { "__proto__": { "value": { "key": "x" }, "counter": 1, "deviceTag": "01" } }, "membership": {}, "groups": {} }, "rows": ["__proto__"], "next": 2 },
    { "name": "empty and missing maps merge as empty orders",
      "a": null, "b": {},
      "expected": { "rows": {}, "membership": {}, "groups": {} }, "rows": [], "next": 1 }
  ],
  "register": [
    { "name": "a tombstone wins an equal counter and tag",
      "a": { "value": { "key": "k" }, "counter": 2, "deviceTag": "01" }, "b": { "tombstone": true, "counter": 2, "deviceTag": "01" },
      "expected": { "tombstone": true, "counter": 2, "deviceTag": "01" } },
    { "name": "tag order precedes the tombstone tiebreak",
      "a": { "value": "live", "counter": 2, "deviceTag": "ff" }, "b": { "tombstone": true, "counter": 2, "deviceTag": "01" },
      "expected": { "value": "live", "counter": 2, "deviceTag": "ff" } },
    { "name": "otherwise tied values use JSON rather than culture or escaped Unicode",
      "a": { "value": "\u00e9", "counter": 2, "deviceTag": "01" }, "b": { "value": "z", "counter": 2, "deviceTag": "01" },
      "expected": { "value": "\u00e9", "counter": 2, "deviceTag": "01" } },
    { "name": "invalid and absent registers stay absent",
      "a": { "counter": "1", "deviceTag": "01" }, "b": null, "expected": null },
    { "name": "JSON number ties expand at the small decimal boundary",
      "a": { "value": 1e-6, "counter": 2, "deviceTag": "01" }, "b": { "value": 9e-7, "counter": 2, "deviceTag": "01" },
      "expected": { "value": 9e-7, "counter": 2, "deviceTag": "01" } },
    { "name": "JSON number ties use exponent form at the large decimal boundary",
      "a": { "value": 1e21, "counter": 2, "deviceTag": "01" }, "b": { "value": 1e20, "counter": 2, "deviceTag": "01" },
      "expected": { "value": 1e21, "counter": 2, "deviceTag": "01" } },
    { "name": "JSON object ties enumerate integer property keys first",
      "a": { "value": { "10": "a", "2": "z" }, "counter": 2, "deviceTag": "01" }, "b": { "value": { "2": "a", "10": "z" }, "counter": 2, "deviceTag": "01" },
      "expected": { "value": { "2": "z", "10": "a" }, "counter": 2, "deviceTag": "01" } },
    { "name": "JSON string ties compare escaped control characters",
      "a": { "value": "\n", "counter": 2, "deviceTag": "01" }, "b": { "value": "\f", "counter": 2, "deviceTag": "01" },
      "expected": { "value": "\n", "counter": 2, "deviceTag": "01" } }
  ],
  "marker": [
    { "name": "two devices keep the highest turn per session",
      "a": { "s1": 7 }, "b": { "s1": 4, "s2": 2 }, "expected": { "s1": 7, "s2": 2 } },
    { "name": "read markers never move backward",
      "a": { "s1": 9 }, "b": { "s1": 3 }, "expected": { "s1": 9 } },
    { "name": "orphan markers stay and invalid turns drop",
      "a": { "ghost": 3, "neg": -1, "frac": 1.5, "str": "4", "unsafe": 9007199254740992, "nil": null, "bool": true }, "b": null, "expected": { "ghost": 3 } }
  ]
}
