<Project Sdk="Microsoft.NET.Sdk">

  <!-- A stand-in for an agent CLI in the injector's integration tests: a console program
       that reads raw key events from its own console and writes each one to a file, so a
       test can see exactly what the injector typed. Never a test of its own. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>agent-bridge-console-echo</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

</Project>
