{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "machine", "os", "startUtc", "endUtc", "elapsedSeconds", "sampleCount", "targets"],
  "properties": {
    "schemaVersion": {"const": 1}, "machine": {"type": "string", "minLength": 1}, "os": {"type": "string", "minLength": 1},
    "startUtc": {"type": "string", "format": "date-time"}, "endUtc": {"type": "string", "format": "date-time"},
    "elapsedSeconds": {"type": "number", "minimum": 0}, "sampleCount": {"type": "integer", "minimum": 1},
    "targets": {"type": "object", "additionalProperties": false, "required": ["host", "desktop", "pwa"],
      "properties": {"host": {"$ref": "#/$defs/target"}, "desktop": {"$ref": "#/$defs/target"}, "pwa": {"$ref": "#/$defs/target"}}}
  },
  "$defs": {
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "processId", "buildVersion", "sampleCount", "cpuSecondsPerMinute", "workingSetBytes", "privateBytes", "topThreads", "gcAllocationBytesPerSecond", "network", "unavailable"],
      "properties": {
        "status": {"enum": ["available", "partial", "unavailable"]}, "processId": {"type": ["integer", "null"], "minimum": 1},
        "buildVersion": {"type": ["string", "null"]}, "sampleCount": {"type": "integer", "minimum": 0},
        "cpuSecondsPerMinute": {"type": ["number", "null"], "minimum": 0},
        "workingSetBytes": {"type": ["integer", "null"], "minimum": 0}, "privateBytes": {"type": ["integer", "null"], "minimum": 0},
        "topThreads": {"type": ["array", "null"], "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["id", "cpuSeconds"],
          "properties": {"id": {"type": "integer"}, "cpuSeconds": {"type": "number", "minimum": 0}}}},
        "gcAllocationBytesPerSecond": {"type": "null"}, "network": {"type": "null"},
        "unavailable": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
      }
    }
  }
}
